      {0} \u3092\u6C17\u306B\u5165\u308B\u3060\u308D\u3046\u304B\u3002\r\n\u6C7A\u3081\u3089\u308C\u306A\u3044...
      {0} \u3092\u9078\u629E\u3059\u308B\u3079\u304D\u3067\u3059\u304B?\r\n\u3069\u308C\u3092\u9078\u3079\u3070\u3044\u3044\u306E\u304B\u5206\u304B\u308A\u307E\u305B\u3093...\r\n\u30CB\u30FC\u30B9\uFF01\u3053\u308C\u306B\u306F\u5272\u5F15\u304C\u3042\u308A\u307E\u3059\u3002\u5FC5\u305A\u53D7\u3051\u307E\u3059\u3002\r\n\u3061\u3087\u3063\u3068\u5F85\u3063\u3066\u304F\u3060\u3055\u3044\u3001\u305D\u308C\u306F\u79C1\u304C\u898B\u305F\u4FA1\u683C\u3067\u306F\u3042\u308A\u307E\u305B\u3093\u3002\u8A18\u8F09\u3055\u308C\u3066\u3044\u308B\u4FA1\u683C\u3092\u304A\u652F\u6255\u3044\u3057\u307E\u3059\u3002\r\n{0}
      \u306F\u9AD8\u3059\u304E\u307E\u3059\u3002\r\n{0} \u306F\u975E\u5E38\u306B\u9AD8\u4FA1\u3067\u3059\u3002\r\n{0}
      \u9AD8\u4FA1\u3067\u3059\u3002\r\n{0} \u826F\u3044\u5024\u6BB5\u3067\u3059\u3002\r\n\u3044\u3084\u3001\u3044\u3084\u3041..\r\n\u5F85\u3063\u3066\u3001\u79C1\u306F\u30D0\u30B0\u3063\u3066\u3044\u307E\u305B\u3093...\r\n\u3064\u3044\u306B\u4E2D\u306B\u5165\u3063\u3066\u3057\u307E\u3063\u305F\u2026\r\n\u3059\u3054\u3044\u884C\u5217\u3067\u3001\u5165\u308C\u307E\u305B\u3093\u3067\u3057\u305F\uFF01\r\n\u306A\u305C\u3053\u306E\u304A\u5E97\u304C\u9589\u5E97\u3057\u3066\u3057\u307E\u3046\u306E\u304B\u2026\r\n\u3053\u306E\u884C\u5217\u306F\u9577\u3059\u304E\u307E\u3059...\r\n\u3059\u3054\u3044\u884C\u5217\u306E\u3088\u3046\u3067\u3059\u304C\u3001\u4F55\u3082\u305B\u305A\u306B\u6765\u307E\u3057\u305F\u3002\r\n\u3082\u3046\u5F85\u3061\u304D\u308C\u307E\u305B\u3093\uFF01\r\n\u5F7C\u3089\u304C
      {0} \u3092\u6301\u3063\u3066\u3044\u308B\u3053\u3068\u3092\u9858\u3063\u3066\u3044\u307E\u3059\u3002\r\n\u304A\u3044\u3001\u4F55\u3084\u3063\u3066\u3093\u3060\u3088\uFF01\r\n\u3084\u3081\u3066\uFF01\r\n@#$\u200B\u200B%!\r\n\u308F\u304B\u3063\u305F\u308F\u304B\u3063\u305F\u3001\u51FA\u767A\u3059\u308B\u3088\uFF01\r\n\u518D\u8A66\u884C\u3082\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044!\r\n\u3053\u3093\u306B\u3061\u306F\uFF01\u3057\u3070\u3089\u304F\u3053\u306E\u3042\u305F\u308A\u3067\u898B\u304B\u3051\u307E\u3057\u305F\u3002\u73A9\u5177\u4E8B\u696D\u306F\u5132\u304B\u308A\u307E\u3059\u304B\uFF1F\r\n\u305D\u3046\u3067\u306F\u3042\u308A\u307E\u305B\u3093\u304C\u3001\u697D\u3057\u3044\u4ED5\u4E8B\u3067\u3059\u3002\r\n\u3082\u3061\u308D\u3093\u3001\u53CE\u76CA\u3092\u4E0A\u3052\u308B\u305F\u3081\u306B\u53D6\u308A\u7D44\u3093\u3067\u3044\u307E\u3059\u3002\r\n\u3088\u304F\u308F\u304B\u308A\u307E\u305B\u3093\u304C\u3001\u3053\u306E\u5206\u91CE\u3067\u306F\u3061\u3087\u3063\u3068\u96E3\u3057\u3044\u3067\u3059\u3002\r\n\u305D\u308C\u307B\u3069\u591A\u304F\u306F\u3042\u308A\u307E\u305B\u3093\u304C\u3001\u5B50\u4F9B\u305F\u3061\u304C\u559C\u3076\u306E\u3092\u898B\u308B\u3060\u3051\u3067\u5341\u5206\u3067\u3059\u3002\r\n\u697D\u3057\u3044\uFF1F\u304A\u3082\u3061\u3083\u5C4B\u3055\u3093\u306E\u5E97\u4E3B\u304C\u3044\u3064\u3082\u5143\u6C17\u305D\u3046\u306A\u306E\u306F\u3001\u305D\u3046\u3044\u3046\u3053\u3068\u306A\u306E\u3067\u3057\u3087\u3046\u306D\uFF01\r\n\u78BA\u304B\u306B\u3001\u4ECA\u65E5\u3067\u306F\u8AB0\u3082\u304C\u751F\u304D\u6B8B\u308B\u305F\u3081\u306B\u4E00\u751F\u61F8\u547D\u50CD\u304B\u306A\u3051\u308C\u3070\u306A\u308A\u307E\u305B\u3093\u3002\r\n\u305D\u308C\u306F\u3068\u3066\u3082\u826F\u3044\u898B\u65B9\u3067\u3059\u3002\u4E16\u754C\u306F\u3042\u306A\u305F\u306E\u3088\u3046\u306A\u4EBA\u3092\u3082\u3063\u3068\u5FC5\u8981\u3068\u3057\u3066\u3044\u307E\u3059!\r\n\u3053\u306E\u5730\u57DF\u3067\u306F\u53B3\u3057\u3044\u3067\u3059\u304B\uFF1F\u306A\u305C\u305D\u3046\u601D\u3044\u307E\u3059\u304B?\r\n\u3053\u306E\u8FBA\u306E\u4EBA\u305F\u3061\u306F\u304A\u3082\u3061\u3083\u3092\u3042\u307E\u308A\u8CB7\u3044\u307E\u305B\u3093\u3002\r\n\u7AF6\u4E89\u304C\u591A\u3059\u304E\u308B\u306E\u3067\u3001\u5927\u304D\u306A\u5E97\u8217\u306F\u79C1\u305F\u3061\u306B\u3068\u3063\u3066\u56F0\u96E3\u3067\u3059\u3002\r\n\u3053\u3053\u306B\u3044\u308B\u307B\u3068\u3093\u3069\u306E\u4EBA\u306F\u3001\u30E9\u30A4\u30D0\u30EB\u304B\u3089\u306E\u3088\u308A\u5B89\u4FA1\u306A\u30AA\u30D7\u30B7\u30E7\u30F3\u3092\u597D\u307F\u307E\u3059\u3002\r\n\u308F\u304B\u308A\u307E\u305B\u3093\u304C\u3001\u3082\u3057\u304B\u3057\u305F\u3089\u79C1\u304C\u5341\u5206\u3067\u306F\u306A\u3044\u306E\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3002\r\n\u78BA\u304B\u306B\u3001\u5F7C\u3089\u306E\u512A\u5148\u4E8B\u9805\u306F\u4ED6\u306E\u3053\u3068\u306B\u96C6\u4E2D\u3057\u3066\u3044\u308B\u306E\u304B\u3082\u3057\u308C\u307E\u305B\u3093\r\n\u5927\u578B\u5E97\u306F\u5A01\u5727\u7684\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u304C\u3001\u5730\u5143\u306E\u30D3\u30B8\u30CD\u30B9\u3092\u30B5\u30DD\u30FC\u30C8\u3059\u308B\u3053\u3068\u306F\u91CD\u8981\u3067\u3059\u3002\r\n\u3042\u3042\u3001\u305D\u308C\u306F\u6094\u3057\u3044\u3067\u3059\u306D\u3002\u3057\u304B\u3057\u3001\u54C1\u8CEA\u306B\u306F\u5FC5\u305A\u8F1D\u304D\u304C\u751F\u307E\u308C\u307E\u3059\u3002\r\n\u305D\u3093\u306A\u3053\u3068\u8003\u3048\u306A\u3044\u3067\u304F\u3060\u3055\u3044\uFF01\u3069\u306E\u4ED5\u4E8B\u306B\u3082\u8AB2\u984C\u306F\u3042\u308A\u307E\u3059\u304C\u3001\u305D\u308C\u306F\u3042\u308A\u307E\u3059\u3002\r\n\u3042\u306A\u305F\u306E\u304A\u5E97\u306F\u9762\u767D\u3044\u3067\u3059\u3088\uFF01\u304A\u3082\u3061\u3083\u5C4B\u3055\u3093\u306F\u3060\u3044\u305F\u3044\u540C\u3058\u3088\u3046\u306A\u5546\u54C1\u3092\u6271\u3063\u3066\u3044\u307E\u3059\u304C\u3001\u304A\u3082\u3061\u3083\u5C4B\u3055\u3093\u306E\u306F\u3061\u3087\u3063\u3068\u9055\u3046\u3088\u3046\u3067\u3059\u3002\u30D3\u30B8\u30CD\u30B9\u306F\u3069\u3046\u3067\u3059\u304B?\r\n\u304B\u306A\u308A\u826F\u3044\u3067\u3059\u304C\u3001\u5E38\u306B\u6539\u5584\u306B\u52AA\u3081\u3066\u3044\u307E\u3059\u3002\r\n\u60AA\u304F\u306F\u3042\u308A\u307E\u305B\u3093\u304C\u3001\u7AF6\u4E89\u306F\u6642\u306B\u306F\u53B3\u3057\u3044\u3082\u306E\u306B\u306A\u308B\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\u3002\r\n\u9806\u8ABF\u306B\u9032\u3093\u3067\u3044\u307E\u3059\u304C\u3001\u6642\u3005\u5C11\u3057\u9045\u304F\u306A\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\r\n\u30D3\u30B8\u30CD\u30B9\u306F\u5B89\u5B9A\u3057\u3066\u3044\u307E\u3059\u304C\u3001\u5E38\u306B\u65B0\u3057\u3044\u3053\u3068\u306B\u6311\u6226\u3057\u3066\u3044\u307E\u3059\u3002\r\n\u305D\u3046\u3067\u3059\u306D\u3001\u3069\u306E\u30D3\u30B8\u30CD\u30B9\u3082\u6539\u5584\u3057\u7D9A\u3051\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\u5909\u308F\u308B\u3079\u304D\u3053\u3068\u306F\u5FC5\u305A\u3042\u308A\u307E\u3059\uFF01\r\n\u60AA\u304F\u306F\u3042\u308A\u307E\u305B\u3093\u304C\u3001\u7AF6\u4E89\u306F\u6642\u306B\u306F\u53B3\u3057\u3044\u3082\u306E\u306B\u306A\u308B\u53EF\u80FD\u6027\u304C\u3042\u308A\u307E\u3059\u3002\r\n\u9806\u8ABF\u306B\u9032\u3093\u3067\u3044\u307E\u3059\u304C\u3001\u6642\u3005\u5C11\u3057\u9045\u304F\u306A\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\r\n\u3053\u306E\u3042\u305F\u308A\u3067\u4ED6\u306B\u4F55\u304C\u8D77\u3053\u3063\u3066\u3044\u308B\u306E\u3067\u3057\u3087\u3046\u304B\uFF1F\u6700\u8FD1\u306E\u4EBA\u306F\u4F55\u306B\u5922\u4E2D\u3067\u3059\u304B\uFF1F\r\n\u6700\u8FD1\u3001\u4EBA\u3005\u306F\u5C4B\u5916\u3067\u904E\u3054\u3059\u6642\u9593\u304C\u5897\u3048\u3066\u3044\u308B\u3088\u3046\u3067\u3059\u3002\u516C\u5712\u306F\u307E\u3059\u307E\u3059\u8CD1\u3084\u304B\u306B\u306A\u3063\u3066\u304D\u307E\u3057\u305F\u3002\r\n\u3053\u306E\u5834\u6240\u306F\u3068\u3066\u3082\u6D3B\u6C17\u304C\u3042\u308A\u3001\u3044\u3064\u3082\u4F55\u304B\u304C\u8D77\u3053\u3063\u3066\u3044\u307E\u3059\u3002\r\n\u4EBA\u3005\u306E\u8CB7\u3044\u7269\u7FD2\u6163\u3082\u5909\u308F\u3063\u3066\u304D\u3066\u3044\u308B\u3088\u3046\u3067\u3059\u3002\u30AA\u30F3\u30E9\u30A4\u30F3\u3067\u8CB7\u3044\u7269\u3092\u3059\u308B\u4EBA\u304C\u5897\u3048\u3066\u3044\u307E\u3059\u3002\r\n\u3053\u306E\u3042\u305F\u308A\u3067\u3055\u3089\u306B\u591A\u304F\u306E\u793E\u4F1A\u7684\u306A\u51FA\u6765\u4E8B\u304C\u8D77\u3053\u3063\u3066\u3044\u308B\u3053\u3068\u306B\u6C17\u3065\u304D\u307E\u3057\u305F\u3002\u3053\u3053\u3082\u5C11\u3057\u8CD1\u3084\u304B\u306B\u306A\u3063\u305F\u3088\u3046\u306A\u6C17\u304C\u3057\u307E\u3059\r\n\u305D\u3046\u3067\u3059\u306D\u3001\u81EA\u7136\u3068\u65B0\u9BAE\u306A\u7A7A\u6C17\u306F\u3044\u3064\u3067\u3082\u9B45\u529B\u7684\u3067\u3059\u3002\u4EBA\u306F\u6642\u3005\u3001\u5916\u3067\u30EA\u30E9\u30C3\u30AF\u30B9\u3057\u305F\u3044\u3068\u601D\u3046\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\r\n\u305D\u308C\u3092\u805E\u3044\u3066\u3046\u308C\u3057\u3044\u3067\u3059!\u5E38\u306B\u3042\u3089\u3086\u308B\u3053\u3068\u304C\u8D77\u3053\u3063\u3066\u3044\u308B\u30C0\u30A4\u30CA\u30DF\u30C3\u30AF\u306A\u5834\u6240\u3067\u306A\u3051\u308C\u3070\u306A\u308A\u307E\u305B\u3093\u3002\r\n\u305D\u3046\u3067\u3059\u306D\u3001\u30CD\u30C3\u30C8\u30B7\u30E7\u30C3\u30D4\u30F3\u30B0\u306F\u672C\u5F53\u306B\u5897\u3048\u307E\u3057\u305F\u306D\u3002\u3057\u304B\u3057\u3001\u5B9F\u5E97\u8217\u306B\u306F\u7279\u5225\u306A\u96F0\u56F2\u6C17\u304C\u3042\u308A\u3001\u4EBA\u3005\u3092\u60F9\u304D\u3064\u3051\u307E\u3059\u3002\r\n\u30A2\u30AF\u30C6\u30A3\u30D6\u306B\u306A\u308B\u306E\u306F\u7D20\u6674\u3089\u3057\u3044\u3053\u3068\u3067\u3059\uFF01\u30A4\u30D9\u30F3\u30C8\u306F\u4EBA\u3005\u304C\u96C6\u307E\u308B\u7D76\u597D\u306E\u6A5F\u4F1A\u3067\u3059\u3002\r\n\u3053\u3053\u3067\u6642\u9593\u3092\u904E\u3054\u3057\u3066\u3044\u308B\u3068\u3001\u4EBA\u306E\u52D5\u304D\u304C\u3068\u3066\u3082\u65E9\u304F\u306A\u308B\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u3088\u306D\uFF1F\u5E38\u306B\u4F55\u304B\u304C\u8D77\u3053\u3063\u3066\u3044\u308B\u3088\u3046\u306A\u3082\u306E\u3067\u3059\u3002\r\n\u6642\u3005\u3001\u3053\u306E\u30B9\u30D4\u30FC\u30C9\u611F\u306B\u6211\u3092\u5FD8\u308C\u3066\u3057\u307E\u3046\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\r\n\u305D\u3046\u3001\u3059\u3079\u3066\u304C\u3068\u3066\u3082\u65E9\u304F\u9032\u3080\u306E\u3067\u3001\u6642\u3005\u3064\u3044\u3066\u3044\u3051\u306A\u3044\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u3002\r\n\u3059\u3079\u3066\u304C\u4E00\u5EA6\u306B\u3068\u3066\u3082\u6FC0\u3057\u304F\u611F\u3058\u3089\u308C\u308B\u306E\u3067\u3001\u3061\u3087\u3063\u3068\u4F11\u61A9\u3059\u308B\u306E\u3082\u3044\u3044\u3067\u3057\u3087\u3046\u3002\r\n\u5E38\u306B\u4F55\u304B\u304C\u8D77\u3053\u3063\u3066\u3044\u308B\u3088\u3046\u306B\u611F\u3058\u307E\u3059\u304C\u3001\u5B9F\u969B\u306B\u306F\u4F55\u3082\u8D77\u3053\u3063\u3066\u3044\u306A\u3044\u3088\u3046\u306B\u611F\u3058\u307E\u3059\u3002\r\n\u901F\u304F\u52D5\u304F\u3068\u75B2\u308C\u3066\u3057\u307E\u3044\u307E\u3059\u3002\u3067\u3082\u540C\u6642\u306B\u3001\u306A\u3093\u3060\u304B\u30EF\u30AF\u30EF\u30AF\u3059\u308B\u3053\u3068\u3082\u3042\u308B\u3068\u601D\u3044\u307E\u305B\u3093\u304B\uFF1F\r\n\u5206\u304B\u308A\u307E\u3057\u305F\u3002\u6642\u306B\u306F\u7ACB\u3061\u6B62\u307E\u3063\u3066\u6DF1\u547C\u5438\u3059\u308B\u3053\u3068\u3082\u5FC5\u8981\u3067\u3059\u3002\u7269\u4E8B\u304C\u9045\u304F\u306A\u308B\u3068\u3001\u3059\u3079\u3066\u306B\u6C17\u3065\u304D\u307E\u3059\u3002\r\n\u305D\u3046\u3067\u3059\u3001\u79C1\u305F\u3061\u306F\u6642\u3005\u5FD9\u3057\u3059\u304E\u3066\u3001\u81EA\u5206\u306E\u5468\u308A\u3067\u4F55\u304C\u8D77\u3053\u3063\u3066\u3044\u308B\u306E\u304B\u6C17\u3065\u304B\u306A\u304F\u306A\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\r\n\u6642\u9593\u3092\u628A\u63E1\u3059\u308B\u306E\u304C\u96E3\u3057\u3044\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u3002\u3042\u306A\u305F\u306B\u3068\u3063\u3066\u6642\u9593\u306F\u3069\u306E\u3088\u3046\u306B\u904E\u304E\u3066\u3044\u304D\u307E\u3059\u304B\uFF1F\r\n\u3068\u3066\u3082\u65E9\u304F\u904E\u304E\u3066\u3044\u304F\u3053\u3068\u3082\u3042\u308C\u3070\u3001\u3068\u3066\u3082\u9045\u304F\u611F\u3058\u308B\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u3002\r\n\u671D\u306F\u3044\u3064\u3082\u3060\u308B\u3044\u3067\u3059\u304C\u3001\u5915\u65B9\u306B\u306F\u6C17\u5206\u304C\u826F\u304F\u306A\u308A\u307E\u3059\u3002\r\n\u3042\u3063\u3068\u3044\u3046\u9593\u306B\u904E\u304E\u3066\u3057\u307E\u3044\u307E\u3059\u304C\u3001\u6642\u306B\u306F\u5C0F\u3055\u306A\u77AC\u9593\u3082\u898B\u9003\u3057\u305F\u304F\u306A\u3044\u3082\u306E\u3067\u3059\u3002\r\n\u3069\u3046\u3084\u3063\u3066\u6642\u9593\u3092\u904E\u3054\u3057\u3066\u3044\u308B\u306E\u304B\u3055\u3048\u5206\u304B\u3089\u306A\u3044\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u3002\r\n\u305D\u3046\u3067\u3059\u306D\u3001\u6C17\u3065\u304B\u306A\u3044\u3046\u3061\u306B\u4E00\u65E5\u304C\u3042\u3063\u3068\u3044\u3046\u9593\u306B\u904E\u304E\u3066\u3057\u307E\u3046\u3088\u3046\u306A\u65E5\u3082\u3042\u308A\u307E\u3059\u3002\r\n\u4E00\u65E5\u306E\u6700\u521D\u306E\u6570\u6642\u9593\u306F\u5E38\u306B\u6700\u3082\u56F0\u96E3\u3067\u3059\u3002\u3067\u3082\u591C\u306F\u304F\u3064\u308D\u3050\u306E\u306B\u3044\u3044\u3088\r\n\u305D\u3046\u3001\u305D\u3046\u3044\u3046\u5C0F\u3055\u306A\u77AC\u9593\u304C\u672C\u5F53\u306B\u5927\u5207\u306A\u306E\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u3059\u3079\u3066\u306F\u305D\u308C\u3089\u306B\u6C17\u3065\u304F\u3053\u3068\u3067\u3059\r\n\u305D\u3046\u3001\u7269\u4E8B\u306B\u5922\u4E2D\u306B\u306A\u308A\u3059\u304E\u3066\u6642\u9593\u304C\u904E\u304E\u3066\u3057\u307E\u3046\u3053\u3068\u3082\u3042\u308A\u307E\u3059\r\n\u3061\u3087\u3063\u3068\u3001\u305D\u3053\uFF01\u304A\u3082\u3061\u3083\u306B\u8A73\u3057\u3044\u3088\u3046\u3067\u3059\u306D\u3002\u3069\u306E\u3088\u3046\u306A\u304A\u3082\u3061\u3083\u304C\u4E00\u756A\u597D\u304D\u3067\u3059\u304B?\r\n\u304A\u3082\u3061\u3083\u306E\u8ECA\u304C\u4E00\u756A\u5927\u597D\u304D\u3067\u3059\uFF01\r\n\u79C1\u306F\u306C\u3044\u3050\u308B\u307F\u304C\u3068\u3066\u3082\u597D\u304D\u3067\u3001\u3068\u3066\u3082\u304B\u308F\u3044\u3044\u3067\u3059\u3002\r\n\u3088\u304F\u308F\u304B\u308A\u307E\u305B\u3093\u304C\u3001\u79C1\u306B\u3068\u3063\u3066\u304A\u3082\u3061\u3083\u306F\u3069\u308C\u3082\u697D\u3057\u3044\u3067\u3059\u3002\r\n\u5275\u9020\u7684\u306B\u904A\u3079\u308B\u304A\u3082\u3061\u3083\u304C\u6700\u9AD8\u3060\u3068\u601D\u3044\u307E\u3059\u3002\r\n\u304A\u3082\u3061\u3083\u306E\u8ECA\u306F\u3068\u3066\u3082\u697D\u3057\u3044\u3067\u3059\uFF01\u901F\u304F\u8D70\u308B\u306E\u306F\u697D\u3057\u3044\u3067\u3059\u306D\u3002\r\n\u306C\u3044\u3050\u308B\u307F\u3063\u3066\u672C\u5F53\u306B\u53EF\u611B\u3044\u3067\u3059\u306D\u3002\u62B1\u304D\u3057\u3081\u3066\u4E00\u7DD2\u306B\u7720\u308C\u308B\u306E\u306F\u5B09\u3057\u3044\u3067\u3059\u306D\uFF01\r\n\u30AF\u30EA\u30A8\u30A4\u30C6\u30A3\u30D6\u306A\u304A\u3082\u3061\u3083\u3063\u3066\u672C\u5F53\u306B\u697D\u3057\u3044\u3067\u3059\u306D\uFF01\u60F3\u50CF\u529B\u3092\u4F7F\u3063\u3066\u904A\u3079\u308B\u3082\u306E\u306F\u3069\u308C\u3082\u7279\u5225\u3067\u3059\r\n\u304A\u3082\u3061\u3083\u306F\u3068\u3066\u3082\u697D\u3057\u3044\u3067\u3059\u304C\u3001\u7279\u5B9A\u306E\u304A\u3082\u3061\u3083\u304C\u3088\u308A\u7279\u5225\u306B\u611F\u3058\u3089\u308C\u308B\u3053\u3068\u3082\u3042\u308A\u307E\u3059\u3002\u53E4\u3044\u304A\u3082\u3061\u3083\u306F\u3042\u308A\u307E\u3059\u304B\uFF1F\r\n\u305D\u3046\u3001\u5C0F\u3055\u3044\u9803\u30ED\u30DC\u30C3\u30C8\u3092\u98FC\u3063\u3066\u3044\u305F\u3093\u3067\u3059\u3002\u5927\u597D\u304D\u3067\u3057\u305F\u3002\r\n\u305D\u3046\u3060\u3001\u53E4\u3044\u30AF\u30DE\u306E\u306C\u3044\u3050\u308B\u307F\u3092\u6301\u3063\u3066\u3044\u305F\u3093\u3060\u3002\u3044\u3064\u3082\u6301\u3061\u6B69\u3044\u3066\u3044\u307E\u3057\u305F\u3002\r\n\u3044\u3044\u3048\u3001\u3067\u3082\u53E4\u3044\u304A\u3082\u3061\u3083\u3092\u898B\u308B\u306E\u306F\u697D\u3057\u3044\u3067\u3059\u3002\r\n\u79C1\u306F\u3044\u3064\u3082\u65B0\u3057\u3044\u304A\u3082\u3061\u3083\u304C\u597D\u304D\u3067\u3059\uFF01\r\n\u53E4\u3044\u304A\u3082\u3061\u3083\u306F\u672C\u5F53\u306B\u7279\u5225\u306A\u3082\u306E\u3067\u3059\u3002\u5F7C\u3089\u3068\u904E\u3054\u3057\u305F\u6642\u9593\u306F\u5FD8\u308C\u3089\u308C\u306A\u3044\u3082\u306E\u3067\u3059\u3002\r\n\u306C\u3044\u3050\u308B\u307F\u306F\u672C\u5F53\u306B\u7279\u5225\u3067\u3059\u3002\u5F7C\u3089\u3068\u4E00\u7DD2\u306B\u5BDD\u308B\u306E\u306F\u3068\u3066\u3082\u5FEB\u9069\u3067\u3059\uFF01\r\n\u53E4\u3044\u304A\u3082\u3061\u3083\u306F\u672C\u5F53\u306B\u96F0\u56F2\u6C17\u304C\u9055\u3044\u307E\u3059\u3002\u5F7C\u3089\u3092\u898B\u3066\u3044\u308B\u3068\u3001\u6614\u306B\u623B\u3063\u305F\u3088\u3046\u306A\u6C17\u5206\u306B\u306A\u308A\u307E\u3059\u3002\r\n\u65B0\u3057\u3044\u304A\u3082\u3061\u3083\u3082\u30EF\u30AF\u30EF\u30AF\u3057\u307E\u3059\u306D\u3002\u65B0\u3057\u3044\u3082\u306E\u3092\u767A\u898B\u3059\u308B\u306E\u306F\u3044\u3064\u3082\u697D\u3057\u3044\u3067\u3059\uFF01\r\n\u3053\u306E\u590F\u306F\u4F55\u3092\u3059\u308B\u4E88\u5B9A\u3067\u3059\u304B\uFF1F\r\n\u4F11\u6687\u306B\u884C\u304F\u3053\u3068\u306F\u3042\u307E\u308A\u8003\u3048\u3066\u3044\u307E\u305B\u3093\u3002\u79C1\u306E\u5E97\u3067\u50CD\u304B\u306A\u3051\u308C\u3070\u306A\u308A\u307E\u305B\u3093\u3002\r\n\u3044\u304F\u3064\u304B\u306E\u5834\u6240\u3092\u8003\u3048\u3066\u3044\u307E\u3059\u304C\u3001\u307E\u3060\u660E\u78BA\u306A\u8A08\u753B\u306F\u3042\u308A\u307E\u305B\u3093\u3002\r\n\u3069\u3053\u304B\u65B0\u3057\u3044\u5834\u6240\u3092\u63A2\u7D22\u3057\u305F\u3044\u306E\u3067\u3059\u304C\u3001\u307E\u3060\u6C7A\u3081\u3066\u3044\u307E\u305B\u3093\u3002\r\n\u305D\u3046\u3060\u306D\u3001\u672C\u5F53\u306B\u4F11\u307F\u304C\u6B32\u3057\u3044\u3093\u3060\u3002\u30D3\u30FC\u30C1\u306B\u884C\u304F\u306E\u3082\u3044\u3044\u3068\u601D\u3044\u307E\u3059\u3002\r\n\u3046\u308F\u30FC\u3001\u5C11\u3057\u4F11\u3093\u3060\u307B\u3046\u304C\u3044\u3044\u3088\uFF01\u3067\u3082\u3001\u4F11\u6687\u4E2D\u306F\u5C11\u3057\u697D\u3057\u3080\u3053\u3068\u3082\u3067\u304D\u308B\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u306D?\r\n\u3046\u30FC\u3093\u3001\u4F11\u6687\u306F\u3068\u3066\u3082\u697D\u3057\u3044\u306F\u305A\u3067\u3059\uFF01\u3069\u3053\u306B\u884C\u304D\u305F\u3044\u3067\u3059\u304B\uFF1F\r\n\u3046\u30FC\u3093\u3001\u30D3\u30FC\u30C1\u306F\u6700\u9AD8\u3067\u3059\u306D\uFF01\u7802\u904A\u3073\u306F\u3068\u3066\u3082\u697D\u3057\u3044\u3067\u3059\u3088\uFF01\r\n\u3069\u3053\u304B\u65B0\u3057\u3044\u5834\u6240\u3092\u63A2\u7D22\u3057\u3066\u307F\u307E\u305B\u3093\u304B\uFF1F\u305D\u308C\u306F\u3069\u3053\u306B\u3042\u308B\u3067\u3057\u3087\u3046\u304B\uFF1F\r\n\u5C71\u9593\u90E8\u3082\u898B\u3066\u307F\u305F\u3044\u3067\u3059\u3002\u81EA\u7136\u306E\u4E2D\u3067\u904E\u3054\u3059\u306E\u3082\u3044\u3044\u3067\u3059\u306D\u3002\r\n\u5B9F\u306F\u90CA\u5916\u3078\u884C\u3053\u3046\u3068\u8003\u3048\u3066\u3044\u308B\u3093\u3067\u3059\u3002\u9759\u304B\u306A\u5C0F\u3055\u306A\u8857\u306A\u306E\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3002\r\n\u305D\u3046\u3067\u3059\u306D\u3001\u53CB\u9054\u306E\u4F55\u4EBA\u304B\u304C\u30D3\u30FC\u30C1\u306B\u884C\u304F\u3053\u3068\u3092\u63D0\u6848\u3057\u307E\u3057\u305F\u304C\u3001\u79C1\u306F\u4F55\u304B\u9055\u3046\u3082\u306E\u3092\u898B\u305F\u3044\u3067\u3059\u3002\r\n\u79C1\u306B\u3068\u3063\u3066\u6700\u3082\u91CD\u8981\u306A\u3053\u3068\u306F\u3001\u884C\u3063\u305F\u3053\u3068\u306E\u306A\u3044\u5834\u6240\u306B\u884C\u304F\u3053\u3068\u3067\u3059\u3002\u3060\u304B\u3089\u307E\u3060\u6C7A\u3081\u3066\u306A\u3044\u3093\u3067\u3059\u3002\r\n\u5C71\uFF1F\u3042\u3042\u3001\u6728\u3082\u305F\u304F\u3055\u3093\u3042\u308B\u3060\u308D\u3046\u3057\u3001\u91CE\u751F\u52D5\u7269\u3082\u3044\u308B\u304B\u3082\u3057\u308C\u306A\u3044\uFF01\u3059\u3054\u304F\u697D\u3057\u305D\u3046\u3067\u3059\u306D\uFF01\r\n\u753A\uFF1F\u305D\u308C\u306F\u3061\u3087\u3063\u3068\u9000\u5C48\u306B\u601D\u3048\u307E\u3059\u3002\u4F55\u3092\u3059\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u304B?\u98FD\u304D\u307E\u305B\u3093\u3088\u306D\uFF1F\r\n\u30D3\u30FC\u30C1\u3082\u7D20\u6575\u3067\u3059\u304C\u3001\u65B0\u3057\u3044\u5834\u6240\u3092\u898B\u308B\u306E\u306F\u3082\u3063\u3068\u697D\u3057\u3044\u3068\u601D\u3044\u307E\u3059\uFF01\u65B0\u3057\u3044\u767A\u898B\u304C\u305F\u304F\u3055\u3093\u3042\u308B\u304B\u3082\u3057\u308C\u307E\u305B\u3093\u3088\uFF01\r\n\u3042\u3042\u3001\u305D\u308C\u306F\u30AB\u30C3\u30B3\u3044\u3044\u3067\u3059\u306D\uFF01\u884C\u3063\u305F\u3053\u3068\u306E\u306A\u3044\u5834\u6240\u306B\u884C\u304F\u306E\u306F\u3068\u3066\u3082\u697D\u3057\u3044\u3067\u3059\u3088\u306D\uFF01\u3055\u3089\u306B\u3001\u305F\u304F\u3055\u3093\u306E\u65B0\u3057\u3044\u3053\u3068\u3092\u5B66\u3076\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\r\n\u3053\u308C\u306B\u3064\u3044\u3066\u306F\u3059\u3067\u306B\u8A71\u3057\u307E\u3057\u305F\u3002\u4ED6\u306B\u8A00\u3046\u3053\u3068\u306F\u3042\u307E\u308A\u3042\u308A\u307E\u305B\u3093\u304C\u3001\u30C1\u30E3\u30C3\u30C8\u3057\u3066\u304F\u308C\u3066\u3042\u308A\u304C\u3068\u3046\uFF01\r\n\u4ECA\u65E5\u306F\u3053\u308C\u3067\u7D42\u308F\u308A\u3060\u3068\u601D\u3044\u307E\u3059\u3002\u4ECA\u306E\u3068\u3053\u308D\u4ED6\u306B\u5171\u6709\u3067\u304D\u308B\u3053\u3068\u306F\u4F55\u3082\u3042\u308A\u307E\u305B\u3093\u3002\r\n\u4ECA\u306E\u3068\u3053\u308D\u3067\u304D\u308B\u9650\u308A\u306E\u3053\u3068\u3092\u8A00\u3044\u307E\u3057\u305F\u3002\u305D\u308C\u306F\u305D\u306E\u307E\u307E\u306B\u3057\u3066\u304A\u304D\u307E\u3057\u3087\u3046\u304B\uFF1F\r\n\u4ECA\u304B\u3089\u5BBF\u984C\u3092\u3057\u306A\u3051\u308C\u3070\u306A\u308A\u307E\u305B\u3093\u3002\u305F\u3076\u3093\u5F8C\u3067\uFF01\r\n\u4ECA\u65E5\u306F\u3053\u308C\u3067\u5341\u5206\u3060\u3068\u601D\u3044\u307E\u3059\u3002\u904A\u3073\u306B\u884C\u304B\u306A\u304D\u3083\uFF01\r\n\u3082\u3046\u3059\u3079\u3066\u8A71\u3057\u307E\u3057\u305F\u3002\u4ECA\u3001\u79C1\u306F\u8D70\u3063\u3066\u4F55\u304B\u4ED6\u306E\u3053\u3068\u3092\u3057\u306A\u3051\u308C\u3070\u306A\u308A\u307E\u305B\u3093\uFF01\r\n\u4E00\u4F53\u3069\u3053\u306B\u3044\u308B\u306E\uFF1F\u3044\u3064\u3082\u9045\u523B\u3059\u308B\u541B\u306B\u306F\u3046\u3093\u3056\u308A\u3060\uFF01\r\n\u307E\u3060\u5348\u524D8\u6642\u3067\u3059\u3002\r\n\u6B8B\u308A\u306E\u5F93\u696D\u54E1\u306F\u307E\u3060\u6765\u3066\u3044\u307E\u305B\u3093\u3001\u79C1\u304C\u6700\u521D\u3067\u3059\u3001\u4E0A\u53F8\u3002\r\n\u3042\u306A\u305F\u306F\u307E\u3063\u305F\u304F\u6B63\u3057\u3044\u3067\u3059\u3001\u30DC\u30B9\u3002\u6DF1\u304F\u304A\u8A6B\u3073\u7533\u3057\u4E0A\u3052\u307E\u3059\u3002\r\n\u305D\u308C\u3067\u5341\u5206\u3067\u3059\uFF01\u3069\u308C\u3060\u3051\u306E\u4ED5\u4E8B\u304C\u3042\u308B\u304B\u77E5\u3063\u3066\u3044\u307E\u3059\u304B\uFF1F\r\n\u308F\u304B\u308A\u307E\u305B\u3093\u3002\r\n\u3053\u308C\u3089\u3059\u3079\u3066\u3092\u4F55\u3068\u304B\u51E6\u7406\u3067\u304D\u308B\u3068\u78BA\u4FE1\u3057\u3066\u3044\u307E\u3059\u3002\r\n\u5168\u90E8\u3084\u3063\u3066\u307F\u307E\u3059\u3001\u30DC\u30B9\uFF01\u5168\u3066\u79C1\u304C\u89E3\u6C7A\u3057\u307E\u3059\u306E\u3067\u3001\u5FC3\u914D\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044\uFF01\r\n\u3055\u3042\u3001\u4ED5\u4E8B\u306B\u53D6\u308A\u639B\u304B\u308A\u3001\u6025\u3044\u3067\u304F\u3060\u3055\u3044\uFF01\u305D\u3046\u3057\u306A\u3044\u3068\u3001\u7D50\u5C40\u81EA\u5206\u304C\u89E3\u96C7\u3055\u308C\u308B\u3053\u3068\u306B\u306A\u308A\u307E\u3059\uFF01\u305D\u3057\u3066\u4E00\u65E5\u306E\u7D42\u308F\u308A\u306B\u306F\u79C1\u306E\u30AA\u30D5\u30A3\u30B9\u306B\u6765\u308B\u306E\u3092\u5FD8\u308C\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002\r\n(\u305F\u3081\u606F)
      \u3053\u306E\u8FBA\u3067\u307E\u3068\u3082\u306B\u3084\u3063\u3066\u3044\u308B\u306E\u306F\u79C1\u3060\u3051\u3060\u3002\r\n\u9811\u5F35\u308A\u307E\u3059\u3002\r\n\u3059\u3050\u306B\u4ED5\u4E8B\u306B\u884C\u304D\u307E\u3059\u3001\u30DC\u30B9\uFF01\u89E3\u96C7\u306F\u3055\u305B\u307E\u305B\u3093\u3001\u5FC3\u914D\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044\uFF01\r\n\u305D\u308C\u3067\u3001\u3064\u3044\u306B\u73FE\u308C\u307E\u3057\u305F...\u79C1\u306E\u30AA\u30D5\u30A3\u30B9\u306B\u6765\u308B\u306E\u306B\u3053\u3093\u306A\u306B\u6642\u9593\u304C\u304B\u304B\u308A\u307E\u3057\u305F\u306D?\r\n\u306F\u3044\u3001\u9577\u3044\u9053\u306E\u308A\u3067\u3057\u305F\u3002\r\n\u4EFB\u52D9\u3092\u7D42\u3048\u3066\u3001\u307E\u3063\u3059\u3050\u3053\u3053\u306B\u6765\u307E\u3057\u305F\u3001\u30DC\u30B9\u3002\r\n\u7528\u4E8B\u304C\u7D42\u308F\u308B\u3068\u3059\u3050\u306B\u99C6\u3051\u3064\u3051\u307E\u3057\u305F\u3001\u30DC\u30B9\uFF01\u3059\u3079\u3066\u5927\u4E08\u592B\u3060\u3068\u3044\u3044\u3067\u3059\u306D\uFF01\r\n\u3061\u3087\u3046\u3069\u3042\u306A\u305F\u306E\u540C\u50DA\u306E\u4E00\u4EBA\u3068\u8A71\u3057\u3066\u3044\u3066\u3001\u5F7C\u3089\u304C\u79C1\u306B\u4F55\u304B\u8A00\u3044\u307E\u3057\u305F...\r\n\u3046\u308F\u30FC...\u540C\u50DA\u304C\u8A71\u3057\u65B9\u3092\u77E5\u3063\u3066\u3044\u308B\u3068\u306F\u77E5\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u3002\r\n...\r\n\u3069\u3046\u3044\u3046\u3053\u3068\u3067\u3059\u304B\u3001\u30DC\u30B9\uFF1F\u554F\u984C\u304C\u306A\u3044\u3068\u3044\u3044\u306E\u3067\u3059\u304C\u2026\r\n\u6708\u6B21\u8CA1\u52D9\u30EC\u30D3\u30E5\u30FC\u4E2D\u306B\u3001\u3042\u306A\u305F\u304C\u62C5\u5F53\u3059\u308B\u30EC\u30B8\u306E\u73FE\u91D1\u304C\u4E0D\u8DB3\u3057\u3066\u3044\u308B\u3053\u3068\u306B\u6C17\u3065\u304D\u307E\u3057\u305F...\u3042\u306A\u305F\u306F\u6CE5\u68D2\u3067\u3059!\u3042\u306A\u305F\u306F\u79C1\u306E\u304A\u91D1\u3092\u76D7\u3093\u3060\u306E\u3067\u3059\uFF01\r\n\u3053\u3044\u3064\u3089\u306F\u79C1\u3092\u4E2D\u50B7\u3057\u3066\u3044\u308B\u3093\u3060\uFF01\u305D\u3093\u306A\u3053\u3068\u4F55\u3082\u3057\u3066\u306A\u3044\u3088\uFF01\r\n\u3053\u308C\u306F\u30CA\u30F3\u30BB\u30F3\u30B9\u3067\u3059\u3002\u304A\u91D1\u306F\u76D7\u3093\u3067\u306A\u3044\u3088\uFF01\r\n\u4E0A\u53F8\u3001\u79C1\u306F\u305D\u3093\u306A\u3053\u3068\u306F\u4F55\u3082\u3057\u3066\u3044\u307E\u305B\u3093\u3002\u8A31\u3057\u3066\u304F\u3060\u3055\u3044\u3001\u304A\u9858\u3044\u3057\u307E\u3059\uFF01\r\n\u3053\u3053\u304B\u3089\u51FA\u3066\u884C\u3051\u3001\u4E8C\u5EA6\u3068\u9854\u3092\u898B\u305B\u308B\u306A\u3001\u6CE5\u68D2\u3081\uFF01\u5BB6\u65CF\u5168\u54E1\u306B\u305D\u306E\u8CBB\u7528\u3092\u652F\u6255\u3063\u3066\u3082\u3089\u3044\u307E\u3059\uFF01\r\n\u304D\u3063\u3068\u5F8C\u6094\u3059\u308B\u3067\u3057\u3087\u3046\u3001\u3061\u3087\u3063\u3068\u5F85\u3063\u3066\u304F\u3060\u3055\u3044\uFF01\u3053\u306E\u30B4\u30DF\u3081\uFF01\r\n\u3053\u308C\u306F\u4E0D\u516C\u5E73\u3067\u3059\uFF01\u3053\u306E\u3088\u3046\u306A\u544A\u767A\u306B\u57FA\u3065\u3044\u3066\u79C1\u3092\u89E3\u96C7\u3059\u308B\u3053\u3068\u306F\u3067\u304D\u307E\u305B\u3093\u3002\r\n\u79C1\u306B\u306F\u3053\u306E\u4ED5\u4E8B\u304C\u672C\u5F53\u306B\u5FC5\u8981\u306A\u306E\u3067\u3059\u3002\u304A\u9858\u3044\u3060\u304B\u3089\u89E3\u96C7\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002\u305D\u3093\u306A\u3053\u3068\u3057\u305F\u3089\u30DB\u30FC\u30E0\u30EC\u30B9\u306B\u306A\u3063\u3066\u3057\u307E\u3046\u3088\u3002\r\n*yaaawnn*
      \u304A\u306F\u3088\u3046\u3054\u3056\u3044\u307E\u3059\u3002\u6628\u591C\u306F\u4E00\u7761\u3082\u3067\u304D\u307E\u305B\u3093\u3067\u3057\u305F\u3002\r\n\u304A\u3044\u3001\u4ECA\u4F55\u6642\u304B\u77E5\u3063\u3066\u308B\u304B\uFF1F\u3061\u3087\u3046\u3069\u3053\u3053\u306B\u5230\u7740\u3057\u305F\u3068\u3053\u308D\u3067\u3059\uFF01\u30DC\u30B9\u306F\u3059\u3067\u306B\u79C1\u3092\u565B\u307F\u7815\u3044\u3066\u3044\u307E\u3059\uFF01\u3055\u3042\u3001\u4ED5\u4E8B\u306F\u305F\u304F\u3055\u3093\u3042\u308B\u3088\uFF01\r\n\u671D\u3002\u3053\u308C\u3089\u306E\u4ED5\u4E8B\u3092\u624B\u4F1D\u3063\u3066\u304F\u308C\u307E\u305B\u3093\u304B\uFF1F\r\n\u3044\u3089\u3063\u3057\u3083\u3044\u307E\u305B\uFF01\u5341\u5206\u306A\u7761\u7720\u304C\u53D6\u308C\u3066\u3044\u306A\u3044\u5834\u5408\u306F\u3001\u4F11\u3093\u3067\u304F\u3060\u3055\u3044\u3002\u5168\u3066\u79C1\u304C\u5BFE\u5FDC\u3055\u305B\u3066\u3044\u305F\u3060\u304D\u307E\u3059\uFF01\r\n\u3042\u306A\u305F\u306F\u30BF\u30B9\u30AF\u3092\u51E6\u7406\u3067\u304D\u307E\u3059\u3002\u8EFD\u98DF\u3092\u53D6\u308A\u306B\u884C\u304D\u307E\u3059\u3001\u30B3\u30FC\u30D2\u30FC\u306F\u3042\u308A\u307E\u3059\u304B\uFF1F\r\n\u30C1\u30E7\u30FC\u30AF\u3057\u3066\u304F\u3060\u3055\u3044\u3002\r\n\u3044\u3044\u3048\u3002\r\n\u3044\u3044\u3048\u3001\u3067\u3082\u3001\u4ED5\u4E8B\u304C\u7D42\u308F\u3063\u305F\u3089\u559C\u3093\u3067\u6301\u3063\u3066\u884C\u304D\u307E\u3059\u3002\r\n\u308F\u304B\u308A\u307E\u3057\u305F\u3001\u5F8C\u3067\u4F1A\u3044\u307E\u3057\u3087\u3046\u3002\r\n...\r\n\u3055\u3088\u306A\u3089\u3002\r\n\u4F11\u606F\u3092\u697D\u3057\u3093\u3067\u304F\u3060\u3055\u3044\uFF01\r\n\u3082\u3046\u3054\u5B58\u77E5\u304B\u3068\u601D\u3044\u307E\u3059\u304C\u3001\u6628\u65E5\u304C\u5BB6\u8CC3\u306E\u6700\u7D42\u65E5\u3060\u3063\u305F\u306E\u3067\u3082\u3046\u4E00\u5EA6\u8A00\u3063\u3066\u304A\u304D\u307E\u3059\u3002\r\n\u306F\u3044\u3001\u77E5\u3063\u3066\u3044\u307E\u3059\u3002\r\n...\r\n\u306F\u3044\u3001\u77E5\u3063\u3066\u3044\u307E\u3059\u3002\r\n\u305D\u308C\u3067\uFF1F\r\n\u304A\u91D1\u304C\u3042\u308A\u307E\u305B\u3093\u3002\r\n\u89E3\u96C7\u3055\u308C\u305F\u3070\u304B\u308A\u3067\u304A\u91D1\u304C\u3042\u308A\u307E\u305B\u3093\u3002\r\n\u89E3\u96C7\u3055\u308C\u305F\u3070\u304B\u308A\u3067\u3059\u304C\u3001\u5C11\u3057\u6642\u9593\u3092\u3044\u305F\u3060\u3051\u308C\u3070\u3001\u65B0\u3057\u3044\u4ED5\u4E8B\u3092\u898B\u3064\u3051\u307E\u3059\u306E\u3067\u3001\u305D\u306E\u304A\u91D1\u3067\u304A\u652F\u6255\u3044\u3057\u307E\u3059\u3002\r\n(\u305F\u3081\u606F*)
      \u652F\u6255\u3044\u306B\u306F\u5341\u5206\u306A\u6642\u9593\u3092\u4E0E\u3048\u305F\u306E\u306B...
      \u7533\u3057\u8A33\u3042\u308A\u307E\u305B\u3093\u304C\u3001\u3053\u308C\u4EE5\u4E0A\u3042\u306A\u305F\u3092\u79C1\u306E\u5BB6\u306B\u6CCA\u3081\u308B\u3053\u3068\u306F\u3067\u304D\u307E\u305B\u3093\u3002\r\n\u5927\u4E08\u592B\uFF01\r\n...\r\n\u308F\u304B\u308A\u307E\u3057\u305F\u3001\u3042\u308A\u304C\u3068\u3046...\r\n\u5F7C\u3089\u306E\u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8\u3092\u906E\u65AD\u3057\u3066\u3001\u7269\u4E8B\u306E\u901F\u5EA6\u3092\u4E0B\u3052\u307E\u3057\u3087\u3046\u3002
      (50\u30C9\u30EB)\r\n\u3057\u3070\u3089\u304F\u306E\u9593\u3001\u529B\u3092\u6BBA\u3057\u3066\u7269\u4E8B\u3092\u6DF7\u4E71\u3055\u305B\u308B\u6642\u9593\u3067\u3059\u3002
      (25\u30C9\u30EB)\r\n\u30B4\u30DF\u53CE\u96C6\u8ECA\u3092\u9001\u3063\u3066\u3001\u305D\u306E\u5834\u3092\u60AA\u81ED\u3067\u6E80\u305F\u3057\u3066\u304F\u3060\u3055\u3044\u3002
      (100\u30C9\u30EB)\r\n\u3042\u3042\u3001\u3084\u308B\u3079\u304D\u3053\u3068\u304C\u3042\u308B\u304B\u3089\u3001\u5F8C\u3067\u4F1A\u3044\u307E\u3057\u3087\u3046!\r\n\u4ECA\u306F\u304A\u3057\u3083\u3079\u308A\u3059\u308B\u6642\u9593\u306F\u306A\u3044\u3088\u3001\u307E\u305F\u306D\uFF01\r\n\u3069\u3053\u304B\u306B\u3044\u308B\u306F\u305A\u3060\u3001\u6C17\u3092\u3064\u3051\u3066\uFF01\r\n\u4F11\u61A9\u304C\u5FC5\u8981\u306A\u306E\u3067\u3001\u5F8C\u3067\u8A71\u3057\u307E\u3057\u3087\u3046\u3002\r\n\u79C1\u305F\u3061\u306F\u5341\u5206\u8A71\u3057\u307E\u3057\u305F\u3001\u79C1\u306F\u884C\u304D\u307E\u3057\u3087\u3046\u3002\r\n\u51FA\u304B\u3051\u306A\u304D\u3083\u3001\u307E\u305F\u4F1A\u3044\u307E\u3057\u3087\u3046\uFF01\r\n\u6BCE\u65E5\u3084\u3063\u3066\u3044\u308C\u3070\u3001\u5F7C\u3089\u3082\u6C17\u3065\u304F\u3067\u3057\u3087\u3046\u3002
      2\u65E5\u3054\u3068\u306E\u65B9\u304C\u5B89\u5168\u3067\u3059\u3002\r\n\u3053\u308C\u3089\u306E\u59A8\u5BB3\u88C5\u7F6E\u306F\u5165\u624B\u304C\u56F0\u96E3\u3067\u3059\u3002\u518D\u5EA6\u4F7F\u7528\u3059\u308B\u306B\u306F
      1 \u65E5\u5F85\u3064\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\r\n1 \u65E5
      1 \u56DE\u3001\u305D\u308C\u4EE5\u4E0A\u306E\u5834\u5408\u306F\u75D5\u8DE1\u304C\u6B8B\u308A\u307E\u3059\u3002\r\n\u3053\u308C\u306F\u65E5\u4E2D\u306B\u3084\u3063\u305F\u307B\u3046\u304C\u3044\u3044\u3067\u3057\u3087\u3046\u3002\u591C\u306B\u306A\u308B\u3068\u9759\u304B\u306B\u306A\u308A\u3059\u304E\u3066\u3001\u307F\u3093\u306A\u306B\u6C17\u3065\u304B\u308C\u3066\u3057\u307E\u3044\u307E\u3059\u3002\r\n\u306F\u3044\r\n\u30AD\u30E3\u30F3\u30BB\u30EB\r\n\u4FDD\u5B58\u306B\u5931\u6557\u3057\u307E\u3057\u305F\r\n\u30D5\u30A1\u30A4\u30EB\u306F\u4ED6\u306E\u5834\u6240\u3067\u958B\u3044\u3066\u3044\u308B\u304B\u3001\u30B9\u30C8\u30EC\u30FC\u30B8\u30B9\u30DA\u30FC\u30B9\u304C\u4E0D\u8DB3\u3057\u3066\u3044\u307E\u3059\u3002\r\n\u30D5\u30A1\u30A4\u30EB\u3092\u4FDD\u5B58\u3059\u308B\u305F\u3081\u306E\u6A29\u9650\u304C\u3042\u308A\u307E\u305B\u3093\u3002\r\n\u3053\u306E\u30BB\u30FC\u30D6\u30B9\u30ED\u30C3\u30C8\u3092\u30AF\u30EA\u30A2\r\n\u305D\u306E\u30BB\u30FC\u30D6\u30B9\u30ED\u30C3\u30C8\u5185\u306E\u3059\u3079\u3066\u306E\u9032\u884C\u72B6\u6CC1\u306F\u6C38\u4E45\u306B\u524A\u9664\u3055\u308C\u307E\u3059\u3002\r\n\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\r\n\u30C8\u30A4\u30B7\u30E7\u30C3\u30D7\u30B7\u30DF\u30E5\u30EC\u30FC\u30BF\u30FC\u306E\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3078\u3088\u3046\u3053\u305D\r\n\u3088\u3046\u3053\u305D\r\n\u30C8\u30A4\u30B7\u30E7\u30C3\u30D7\u30B7\u30DF\u30E5\u30EC\u30FC\u30BF\u30FC\u3078\u3088\u3046\u3053\u305D\r\n\u4FA1\u683C\u5909\u66F4\r\n\u627F\u8A8D\r\n\u914D\u7F6E\r\n\u9867\u5BA2\u304B\u3089\u652F\u6255\u3044\u3092\u53D7\u3051\u53D6\u308B\r\n\u304A\u3082\u3061\u3083\u306E\u4FA1\u683C\u3092\u8A2D\u5B9A\u3059\u308B\r\n\u88FD\u54C1\u3092\u30B9\u30AD\u30E3\u30F3\u3059\u308B\u306B\u306F\u30AF\u30EA\u30C3\u30AF\u3057\u3066\u304F\u3060\u3055\u3044\r\n\u304A\u3082\u3061\u3083\u3092\u68DA\u306B\u914D\u7F6E\u3059\u308B\r\n\u5916\u304B\u3089\u6CE8\u6587\u3092\u53D7\u3051\u53D6\u308B\r\n\u30B3\u30F3\u30D4\u30E5\u30FC\u30BF\u3092\u4F7F\u3063\u3066\u304A\u3082\u3061\u3083\u3092\u6CE8\u6587\u3059\u308B\r\n\u5E97\u8217\u3092\u958B\u304F\r\n\u306A\u3093\u3060\u3053\u308C\uFF1F\r\n\u30EC\u30D9\u30EB\u30A2\u30C3\u30D7\uFF01\r\n\u3092\u8CA9\u58F2?\r\n{0}\u3092\u53D6\u5F97\u3057\u307E\u3059\r\n\u8CA9\u58F2\u3057\u306A\u3044\r\n\u8CA9\u58F2\u3059\u308B\r\n\u8B66\u544A\uFF1A\u614E\u91CD\u306B\u6271\u3063\u3066\u304F\u3060\u3055\u3044\uFF01\r\n\u3053\u306E\u5F37\u529B\u306A\u30DF\u30E7\u30EB\u30CB\u30EB\u306F\u3001\u30A2\u30FC\u30EA\u30FC\u30A2\u30AF\u30BB\u30B9\u3067\u30D0\u30B0\u3092\u7C89\u7815\u3059\u308B\u306E\u306B\u5F79\u7ACB\u3061\u307E\u3059\u3002\u305F\u3060\u3057\u3001\u529B\u304C\u5F37\u3059\u304E\u308B\u3068\u3001\u30D0\u30B0\u306E\u5D50\u3092\u547C\u3073\u8D77\u3053\u3059\u304B\u3082\u3057\u308C\u307E\u305B\u3093\uFF01\r\n\u30B3\u30B9\u30C8\r\n\u4FA1\u683C\r\n\u5E02\u5834\u4FA1\u683C\r\n\u5229\u76CA\r\n\u56DB\u6368\u4E94\u5165\r\n\u5272\u9AD8\u3059\u304E\u308B\r\n\u59A5\u5F53\r\n\u624B\u9803\u306A\r\n\u5B89\u3044\r\n\"\u89AA\u611B\u306A\u308B\u5B6B\u3078\u3001\r\n\r\n\u6628\u6669\u3001\u307E\u3060\u8857\u306B\u4F4F\u3093\u3067\u3044\u308B\u53E4\u3044\u53CB\u4EBA\u304B\u3089\u3001\u3042\u306A\u305F\u304CToyVerse\u3092\u89E3\u96C7\u3055\u308C\u3001\u30D9\u30F3\u30C1\u3067\u4E00\u591C\u3092\u904E\u3054\u3057\u305F\u3068\u3044\u3046\u8A71\u3092\u805E\u304D\u307E\u3057\u305F\u3002\u3053\u306E\u30CB\u30E5\u30FC\u30B9\u306F\u3068\u3066\u3082\u60B2\u3057\u304B\u3063\u305F\u3067\u3059\u304C\u3001\u540C\u6642\u306B\u65B0\u3057\u3044\u30B9\u30BF\u30FC\u30C8\u306E\u30C1\u30E3\u30F3\u30B9\u3060\u3068\u3082\u601D\u3063\u3066\u3044\u307E\u3059\u3002\u3042\u306A\u305F\u306F\u82E5\u304F\u3001\u5F37\u304F\u3001\u6709\u80FD\u3067\u3059\u3002\u79C1\u306E\u5E74\u9F62\u3067\u306F\u6301\u3066\u306A\u3044\u3088\u3046\u306A\u7D20\u6674\u3089\u3057\u3044\u529B\u3092\u6301\u3063\u3066\u3044\u308B\u306E\u3067\u3059\u3002\r\n\r\n\u79C1\u306E\u4EBA\u751F\u306F\u591A\u304F\u306E\u6311\u6226\u306B\u6E80\u3061\u3066\u3044\u307E\u3057\u305F\u3002\u305D\u3053\u3067\u3001\u79C1\u306E\u7269\u8A9E\u306E\u4E00\u90E8\u3092\u3042\u306A\u305F\u306B\u4F1D\u3048\u305F\u3044\u3068\u601D\u3044\u307E\u3059\u3002\r\n\r\n\u4F55\u5E74\u3082\u524D\u3001\u79C1\u306F\u4ECA\u306E\u5E02\u5185\u4E2D\u5FC3\u90E8\u3067\u5C0F\u3055\u306A\u73A9\u5177\u5E97\u3092\u55B6\u3093\u3067\u3044\u307E\u3057\u305F\u3002\u6728\u88FD\u306E\u304A\u3082\u3061\u3083\u3092\u4F5C\u308A\u3001\u5B50\u4F9B\u305F\u3061\u306B\u559C\u3073\u3092\u4E0E\u3048\u306A\u304C\u3089\u751F\u8A08\u3092\u7ACB\u3066\u3066\u3044\u307E\u3057\u305F\u3002\u305D\u308C\u306F\u8CEA\u7D20\u306A\u751F\u6D3B\u3067\u3057\u305F\u304C\u3001\u610F\u5473\u306E\u3042\u308B\u3082\u306E\u3067\u3082\u3042\u308A\u307E\u3057\u305F\u3002\u3057\u304B\u3057\u3001\u3059\u3079\u3066\u304C\u5909\u308F\u3063\u305F\u306E\u306FToyVerse\u304C\u79C1\u306E\u5E97\u306E\u3059\u3050\u5411\u304B\u3044\u306B\u958B\u5E97\u3057\u305F\u3068\u304D\u3067\u3057\u305F\u3002\u6700\u521D\u3001\u79C1\u306F\u304A\u4E92\u3044\u306B\u5171\u5B58\u3067\u304D\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3001\u5065\u5EB7\u7684\u306A\u7AF6\u4E89\u3092\u901A\u3058\u3066\u6210\u9577\u3067\u304D\u308B\u3068\u601D\u3063\u3066\u3044\u307E\u3057\u305F\u3002\u3057\u304B\u3057\u3001\u305D\u306E\u5F53\u6642\u306E\u30AA\u30FC\u30CA\u30FC\u306F\u3001\u5947\u5999\u306A\u79BF\u3052\u982D\u306E\u7537\u3067\u3001\u51B7\u9177\u3067\u8CAA\u6B32\u305D\u306E\u3082\u306E\u3067\u3057\u305F\u3002\u5F7C\u306F\u3042\u3089\u3086\u308B\u624B\u6BB5\u3092\u4F7F\u3063\u3066\u79C1\u306E\u9867\u5BA2\u3092\u596A\u3044\u3001\u79C1\u306E\u30D3\u30B8\u30CD\u30B9\u3092\u59A8\u5BB3\u3057\u307E\u3057\u305F\u3002\u3069\u3093\u306A\u306B\u4E00\u751F\u61F8\u547D\u50CD\u3044\u3066\u3082\u3001\u79C1\u306F\u8FFD\u3044\u3064\u3051\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u7D50\u5C40\u3001\u79C1\u306F\u5E97\u3092\u9589\u3081\u3001\u4F5C\u308A\u4E0A\u3052\u305F\u5922\u3092\u8AE6\u3081\u306A\u3051\u308C\u3070\u306A\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u3002\r\n\r\n\u3042\u306A\u305F\u304CToyVerse\u3067\u50CD\u304D\u59CB\u3081\u305F\u3068\u805E\u3044\u305F\u3068\u304D\u3001\u79C1\u306F\u305D\u306E\u3064\u3089\u3044\u601D\u3044\u51FA\u3092\u8107\u306B\u7F6E\u3044\u3066\u3001\u3042\u306A\u305F\u3092\u559C\u3070\u305B\u3088\u3046\u3068\u3057\u307E\u3057\u305F\u3002\u65B0\u3057\u3044\u7D4C\u55B6\u9663\u304C\u826F\u304F\u306A\u3063\u3066\u3044\u308B\u3053\u3068\u3092\u671F\u5F85\u3057\u3066\u3044\u307E\u3057\u305F\u3002\u3057\u304B\u3057\u3001\u3042\u306A\u305F\u306B\u8D77\u3053\u3063\u305F\u3053\u3068\u3092\u805E\u3044\u3066\u3001\u79C1\u306F\u9593\u9055\u3063\u3066\u3044\u305F\u3053\u3068\u306B\u6C17\u3065\u304D\u307E\u3057\u305F\u3002\r\n\r\n\u4ECA\u3001\u79C1\u306F\u3042\u306A\u305F\u306B\u7B2C\u4E8C\u306E\u30C1\u30E3\u30F3\u30B9\u3092\u4E0E\u3048\u305F\u3044\u3068\u601D\u3044\u307E\u3059\u3002\u3053\u306E\u624B\u7D19\u306B\u306F\u3001\u79C1\u306E\u53E4\u3044\u5E97\u306E\u9375\u304C\u540C\u5C01\u3055\u308C\u3066\u3044\u307E\u3059\u3002\u4F55\u5E74\u3082\u4F7F\u308F\u308C\u3066\u3044\u306A\u304B\u3063\u305F\u306E\u3067\u3001\u5E97\u304C\u3069\u3093\u306A\u72B6\u614B\u304B\u306F\u308F\u304B\u308A\u307E\u305B\u3093\u3002\u3057\u304B\u3057\u3001\u79C1\u306F\u3042\u306A\u305F\u3092\u4FE1\u3058\u3066\u3044\u307E\u3059\u3002\u3042\u306A\u305F\u306B\u306F\u60C5\u71B1\u3001\u82E5\u3055\u3001\u624D\u80FD\u304C\u3042\u308A\u3001\u5E97\u3092\u518D\u751F\u3055\u305B\u308B\u529B\u304C\u3042\u308B\u3068\u4FE1\u3058\u3066\u3044\u307E\u3059\u3002\u524D\u306B\u9032\u3080\u3053\u3068\u3092\u6050\u308C\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u3002\u304A\u3082\u3061\u3083\u5C4B\u3092\u6301\u3064\u3053\u3068\u306F\u79C1\u305F\u3061\u306E\u5BB6\u65CF\u306E\u8840\u7B4B\u3067\u3042\u308A\u3001\u79C1\u306F\u3042\u306A\u305F\u304C\u305D\u308C\u3092\u7D20\u6674\u3089\u3057\u3044\u3082\u306E\u306B\u3067\u304D\u308B\u3068\u78BA\u4FE1\u3057\u3066\u3044\u307E\u3059\u3002\u304D\u3063\u3068\u3001\u79C1\u306E\u6642\u4EE3\u3088\u308A\u3082\u512A\u308C\u305F\u3082\u306E\u306B\u3067\u304D\u308B\u3067\u3057\u3087\u3046\u3002\u3053\u306E\u30C1\u30E3\u30F3\u30B9\u3092\u751F\u304B\u3057\u3066\u3001\u81EA\u5206\u306E\u7269\u8A9E\u3092\u66F8\u304D\u3001\u79C1\u305F\u3061\u306E\u907A\u7523\u3092\u7D99\u304E\u3001ToyVerse\u306B\u672C\u5F53\u306E\u8077\u4EBA\u6280\u3068\u732E\u8EAB\u304C\u3069\u3046\u3042\u308B\u3079\u304D\u304B\u3092\u898B\u305B\u3066\u304F\u3060\u3055\u3044\u3002\u3042\u306A\u305F\u304C\u6210\u529F\u3059\u308B\u3053\u3068\u306B\u7591\u3044\u306F\u3042\u308A\u307E\u305B\u3093\u3002\r\n\"\r\n\u3042\u308A\u304C\u3068\u3046\u3001\u304A\u3058\u3044\u3061\u3083\u3093\u3002\u3053\u308C\u3067\u5927\u4E08\u592B\uFF01\r\n\u30AB\u30B9\u30BF\u30DE\u30A4\u30BA\r\n\u8272
      1\r\n\u8272 2\r\n\u9069\u7528\r\n\u3059\u3079\u3066\u306B\u9069\u7528\r\n\u65E5\u5831\r\n\u65E5\r\n\u9867\u5BA2\r\n\u6E80\u8DB3\u3057\u305F\u9867\u5BA2\r\n\u898B\u3064\u304B\u3089\u306A\u304B\u3063\u305F\u88FD\u54C1\r\n\u9AD8\u3059\u304E\u308B\u3068\u611F\u3058\u305F\u88FD\u54C1\r\n\u5408\u8A08\u9867\u5BA2\u6570\r\n\u5E97\u306E\u30DD\u30A4\u30F3\u30C8\r\n\u53CE\u5165\r\n\u4F9B\u7D66\u30B3\u30B9\u30C8\r\n\u30A2\u30C3\u30D7\u30B0\u30EC\u30FC\u30C9\u30B3\u30B9\u30C8\r\n\u5408\u8A08\u5229\u76CA\r\n\u6B8B\u9AD8\r\n\u5E97\r\n\u7D4C\u6E08\r\n\u5229\u76CA\r\n\u65B0\u3057\u3044\u65E5\u3092\u59CB\u3081\u308B\r\n\u30EC\u30B8\u4FC2\u306E\u7D66\u6599\r\n\u30B9\u30C8\u30C3\u30AB\u30FC\u306E\u7D66\u6599\r\n\u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB\u3092\u30B9\u30AD\u30C3\u30D7\u3059\u308B\r\n\u307E\u3060\u4E00\u65E5\u304C\u7D42\u308F\u3063\u3066\u3044\u307E\u305B\u3093\r\n\u8CFC\u5165\u5B8C\u4E86\r\n\u304A\u3064\u308A\u304C\u8DB3\u308A\u307E\u305B\u3093\r\n\u53D6\u5F15\u5931\u6557\r\n\u30DC\u30C3\u30AF\u30B9\u306B\u5546\u54C1\u304C\u3042\u308A\u307E\u305B\u3093\r\n\u68DA\u304C\u3044\u3063\u3071\u3044\u3067\u3059\r\n\u30DC\u30C3\u30AF\u30B9\u304C\u3044\u3063\u3071\u3044\u3067\u3059\r\n\u68DA\u304C\u7A7A\u3067\u3059\r\n\u68DA\u306E\u5546\u54C1\u306F\u30DC\u30C3\u30AF\u30B9\u306B\u9069\u3057\u3066\u3044\u307E\u305B\u3093\r\n\u68DA\u306E\u5546\u54C1\u30BF\u30A4\u30D7\u304C\u30DC\u30C3\u30AF\u30B9\u5185\u306E\u5546\u54C1\u30BF\u30A4\u30D7\u3068\u4E00\u81F4\u3057\u307E\u305B\u3093\r\n\u3053\u306E\u5546\u54C1\u30BF\u30A4\u30D7\u306F\u30DC\u30C3\u30AF\u30B9\u306B\u9069\u3057\u3066\u3044\u307E\u305B\u3093\r\n\u5546\u54C1\u30BF\u30A4\u30D7\u304C\u30DC\u30C3\u30AF\u30B9\u5185\u306E\u5546\u54C1\u30BF\u30A4\u30D7\u3068\u4E00\u81F4\u3057\u307E\u305B\u3093\r\n\u3053\u3053\u306B\u3053\u306E\u5546\u54C1\u3092\u7F6E\u304F\u3053\u3068\u306F\u3067\u304D\u307E\u305B\u3093\r\n\u68DA\u306E\u5546\u54C1\u30BF\u30A4\u30D7\u304C\u5546\u54C1\u30BF\u30A4\u30D7\u3068\u4E00\u81F4\u3057\u307E\u305B\u3093\r\n\u3053\u306E\u68DA\u306B\u306F\u3053\u306E\u30BF\u30A4\u30D7\u306E\u5546\u54C1\u3092\u7F6E\u3051\u307E\u305B\u3093\r\n\u5009\u5EAB\u30BB\u30AF\u30B7\u30E7\u30F3\u3092\u958B\u304F\u306B\u306F\u3001\u5E97\u8217\u30EC\u30D9\u30EB\u30922\u306B\u4E0A\u3052\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\r\n\u5E83\u544A\u304C\u516C\u958B\u3055\u308C\u307E\u3057\u305F\r\n\u5E83\u544A\u5931\u6557\r\n\u6B8B\u9AD8\u4E0D\u8DB3\r\n\u652F\u6255\u3044\u5B8C\u4E86\r\n\u3042\u306A\u305F\u306E\u30AF\u30EC\u30B8\u30C3\u30C8\u306F\u9589\u9396\u3055\u308C\u307E\u3057\u305F\r\n\u65E5\u3005\u306E\u30ED\u30FC\u30F3\u8FD4\u6E08\u304C\u884C\u308F\u308C\u306A\u304B\u3063\u305F\u305F\u3081\u3001\u5229\u606F\u304C\u9069\u7528\u3055\u308C\u307E\u3057\u305F\r\n\u30ED\u30FC\u30F3\u306E\u652F\u6255\u3044\u304C\u6B8B\u9AD8\u3092\u8D85\u3048\u3066\u3044\u307E\u3059\u3002\u4ECA\u65E5\u652F\u6255\u308F\u306A\u3044\u3068\u7834\u7523\u3057\u307E\u3059\r\n\u5E97\u5185\u306B\u306F\u307E\u3060\u304A\u5BA2\u69D8\u304C\u3044\u307E\u3059\r\n\u4E00\u65E5\u304C\u7D42\u308F\u308A\u307E\u3057\u305F\u3002\u5BDD\u306B\u884C\u304D\u307E\u3057\u3087\u3046\r\n\u30AB\u30FC\u30C9\u304C\u9593\u9055\u3063\u3066\u3044\u307E\u3059\uFF01\r\n\u91D1\u984D\u304C\u9593\u9055\u3063\u3066\u3044\u307E\u3059\uFF01\r\n{0}
      \u4FEE\u6B63\u3055\u308C\u307E\u3057\u305F\uFF01\r\n\u4E00\u65E5\u304C\u7D42\u308F\u308A\u307E\u3057\u305F\u3002\u5BDD\u306B\u884C\u304D\u307E\u3057\u3087\u3046\r\n\u30EC\u30B8\u3067\u304A\u5BA2\u69D8\u304C\u5F85\u3063\u3066\u3044\u307E\u3059\r\n\u3053\u306E\u5546\u54C1\u306F\u68DA\u306B\u53CE\u307E\u308A\u307E\u305B\u3093\uFF01\r\n\u6CE8\u6587\u5B8C\u4E86\r\n\u30E6\u30FC\u30B6\u30FC\u304C\u3042\u306A\u305F\u3092\u8A55\u4FA1\u3057\u307E\u3057\u305F\r\n\u6CE8\u6587\u30DC\u30C3\u30AF\u30B9\u304C\u4F5C\u6210\u3055\u308C\u307E\u3057\u305F\r\n{0}
      \u306E\u5E02\u5834\u4FA1\u683C\u304C\u4E0A\u6607\u3057\u307E\u3057\u305F\uFF01\r\n\u30AB\u30FC\u30C8\u306B\u8FFD\u52A0\u3055\u308C\u307E\u3057\u305F\r\n\u30DA\u30A4\u30F3\u30C8\u30D0\u30B1\u30C4\u304C\u7A7A\u3067\u3059\r\n\u4E00\u81F4\u3057\u307E\u305B\u3093\r\n\u7B46\u3092\u30D0\u30B1\u30C4\u306B\u6D78\u3057\u307E\u3059\r\n\u7834\u58CA\u3055\u308C\u307E\u3057\u305F\r\n\u30EC\u30B8\u304C\u5FD9\u3057\u3044\r\n\u9593\u9055\u3063\u305F\u5546\u54C1\u304C\u5C4A\u304D\u3001\u5C4A\u3044\u305F\u3082\u306E\u306F\u640D\u50B7\u3057\u3066\u3044\u307E\u3057\u305F\u3002\u3082\u3046\u4E8C\u5EA6\u3068\u3053\u3053\u3067\u6CE8\u6587\u3057\u307E\u305B\u3093\u3002\r\n\u6CE8\u6587\u304C\u4E0D\u5B8C\u5168\u3067\u3001\u5C4A\u3044\u305F\u5546\u54C1\u306F\u54C1\u8CEA\u304C\u60AA\u304B\u3063\u305F\u3067\u3059\u3002\u3068\u3066\u3082\u5931\u671B\u3057\u307E\u3057\u305F\u3002\r\n\u6CE8\u6587\u306E\u534A\u5206\u304C\u8DB3\u308A\u305A\u3001\u5C4A\u3044\u305F\u3082\u306E\u3082\u983C\u3093\u3060\u3082\u306E\u3068\u306F\u9055\u3044\u307E\u3057\u305F\u3002\u53D7\u3051\u5165\u308C\u3089\u308C\u307E\u305B\u3093\uFF01\r\n\u652F\u6255\u3063\u305F\u3082\u306E\u3092\u53D7\u3051\u53D6\u308C\u305A\u3001\u30AB\u30B9\u30BF\u30DE\u30FC\u30B5\u30FC\u30D3\u30B9\u3082\u9177\u304B\u3063\u305F\u3067\u3059\u3002\u8FD4\u91D1\u3092\u6C42\u3081\u307E\u3059\uFF01\r\n\u8AAC\u660E\u901A\u308A\u306E\u3082\u306E\u304C\u5C4A\u304B\u305A\u3001\u5168\u4F53\u7684\u306B\u30A4\u30E9\u30A4\u30E9\u3059\u308B\u4F53\u9A13\u3067\u3057\u305F\u3002\u3082\u3063\u3068\u6539\u5584\u3057\u3066\u304F\u3060\u3055\u3044\uFF01\r\n\u914D\u9054\u304C\u9045\u308C\u3001\u5546\u54C1\u3082\u5168\u3066\u9593\u9055\u3063\u3066\u3044\u307E\u3057\u305F\u3002\u3053\u306E\u30B5\u30FC\u30D3\u30B9\u306B\u306F\u975E\u5E38\u306B\u4E0D\u6E80\u3067\u3059\u3002\r\n\u6CE8\u6587\u304C\u3072\u3069\u304F\u6271\u308F\u308C\u305F\u3053\u3068\u306B\u9A5A\u3044\u3066\u3044\u307E\u3059\u3002\u5168\u3066\u304C\u9593\u9055\u3063\u3066\u3044\u307E\u3057\u305F\u3002\r\n\u6CE8\u6587\u306E\u307B\u3068\u3093\u3069\u304C\u5C4A\u304B\u305A\u3001\u5C4A\u3044\u305F\u3082\u306E\u3082\u5F79\u306B\u7ACB\u3061\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u3072\u3069\u3044\u7D4C\u9A13\u3067\u3059\u3002\r\n\u9593\u9055\u3063\u305F\u5546\u54C1\u304C\u9001\u3089\u308C\u3001\u554F\u984C\u3092\u89E3\u6C7A\u3059\u308B\u306E\u304C\u9762\u5012\u3067\u3057\u305F\u3002\u624B\u9593\u306B\u898B\u5408\u3044\u307E\u305B\u3093\u3002\r\n\u304A\u91D1\u306E\u7121\u99C4\u3067\u3057\u305F\u3002\u6CE8\u6587\u304C\u5168\u304F\u9593\u9055\u3063\u3066\u304A\u308A\u3001\u4F55\u3082\u89E3\u6C7A\u3055\u308C\u307E\u305B\u3093\u3067\u3057\u305F\u3002\r\n\u6CE8\u6587\u306E\u5927\u90E8\u5206\u306F\u6B63\u3057\u304B\u3063\u305F\u3067\u3059\u304C\u3001\u3044\u304F\u3064\u304B\u5546\u54C1\u304C\u8DB3\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u3082\u3063\u3068\u826F\u304F\u306A\u308B\u3079\u304D\u3067\u3059\u3002\r\n\u5FC5\u8981\u306A\u3082\u306E\u306F\u5C4A\u304D\u307E\u3057\u305F\u304C\u3001\u30D1\u30C3\u30B1\u30FC\u30B8\u304C\u640D\u50B7\u3057\u3066\u3044\u307E\u3057\u305F\u3002\u307E\u305F\u6CE8\u6587\u3059\u308B\u304B\u60A9\u3093\u3067\u3044\u307E\u3059\u3002\r\n\u6CE8\u6587\u306F\u5927\u4F53\u6B63\u3057\u304B\u3063\u305F\u3067\u3059\u304C\u3001\u914D\u9054\u304C\u4E88\u5B9A\u3088\u308A\u9045\u308C\u307E\u3057\u305F\u3002\r\n\u5546\u54C1\u306F\u554F\u984C\u306A\u304B\u3063\u305F\u3067\u3059\u304C\u3001\u3044\u304F\u3064\u304B\u304C\u8DB3\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u3002\u5168\u4F53\u7684\u306B\u306F\u8A31\u5BB9\u7BC4\u56F2\u3067\u3059\u3002\r\n\u307B\u3068\u3093\u3069\u306F\u6B63\u3057\u304B\u3063\u305F\u3067\u3059\u304C\u3001\u3044\u304F\u3064\u304B\u9593\u9055\u3044\u304C\u3042\u308A\u307E\u3057\u305F\u3002\u60AA\u304F\u306F\u306A\u3044\u3067\u3059\u304C\u3001\u7D20\u6674\u3089\u3057\u3044\u308F\u3051\u3067\u3082\u306A\u3044\u3067\u3059\u3002\r\n\u6982\u306D\u6E80\u8DB3\u3067\u3059\u304C\u3001\u6570\u70B9\u8AA4\u3063\u3066\u3044\u308B\u5546\u54C1\u304C\u3042\u308A\u307E\u3057\u305F\u3002\u6B21\u56DE\u306F\u826F\u304F\u306A\u308B\u3068\u3044\u3044\u306A\u3068\u601D\u3044\u307E\u3059\u3002\r\n\u307B\u3068\u3093\u3069\u306E\u5546\u54C1\u306F\u6B63\u3057\u304B\u3063\u305F\u3067\u3059\u304C\u3001\u6CE8\u6587\u306B\u5C11\u3057\u554F\u984C\u304C\u3042\u308A\u307E\u3057\u305F\u3002\r\n\u5546\u54C1\u306F\u307B\u3068\u3093\u3069\u5C4A\u304D\u307E\u3057\u305F\u304C\u3001\u3044\u304F\u3064\u304B\u8AAC\u660E\u3068\u7570\u306A\u308B\u3082\u306E\u3067\u3057\u305F\u3002\u666E\u901A\u306E\u4F53\u9A13\u3067\u3059\u3002\r\n\u6CE8\u6587\u306F\u554F\u984C\u3042\u308A\u307E\u305B\u3093\u3067\u3057\u305F\u304C\u3001\u8DB3\u308A\u306A\u3044\u5546\u54C1\u304C\u5C4A\u304F\u307E\u3067\u306B\u6642\u9593\u304C\u304B\u304B\u308A\u307E\u3057\u305F\u3002\r\n\u5168\u4F53\u7684\u306B\u306F\u826F\u304B\u3063\u305F\u3067\u3059\u304C\u3001\u6CE8\u6587\u306E\u6B63\u78BA\u3055\u306B\u306F\u3082\u3046\u5C11\u3057\u671F\u5F85\u3057\u3066\u3044\u307E\u3057\u305F\u3002\r\n\u5168\u3066\u304C\u5B8C\u74A7\u3067\u3057\u305F\uFF01\u5168\u3066\u306E\u30A2\u30A4\u30C6\u30E0\u304C\u6CE8\u6587\u901A\u308A\u306B\u5C4A\u304D\u307E\u3057\u305F\u3002\u7D76\u5BFE\u306B\u307E\u305F\u6CE8\u6587\u3057\u307E\u3059\uFF01\r\n\u7D20\u6674\u3089\u3057\u3044\u4F53\u9A13\u3067\u3057\u305F\uFF01\u6CE8\u6587\u304C\u6B63\u78BA\u3067\u3001\u914D\u9054\u3082\u6642\u9593\u901A\u308A\u3067\u3057\u305F\u3002\u975E\u5E38\u306B\u6E80\u8DB3\u3057\u3066\u3044\u307E\u3059\uFF01\r\n\u671F\u5F85\u901A\u308A\u306B\u5168\u3066\u304C\u5C4A\u304D\u307E\u3057\u305F\u3002\u8FC5\u901F\u3067\u4FE1\u983C\u3067\u304D\u308B\u30B5\u30FC\u30D3\u30B9\u3067\u3059\uFF01\r\n\u6CE8\u6587\u306F\u5B8C\u74A7\u3067\u3001\u5927\u6E80\u8DB3\u3067\u3059\u3002\u5F37\u304F\u304A\u52E7\u3081\u3057\u307E\u3059\uFF01\r\n\u5168\u3066\u304C\u6CE8\u6587\u901A\u308A\u306B\u5C4A\u304D\u3001\u54C1\u8CEA\u3082\u7D20\u6674\u3089\u3057\u304B\u3063\u305F\u3067\u3059\u3002\u3068\u3066\u3082\u6E80\u8DB3\u3057\u3066\u3044\u307E\u3059\uFF01\r\n\u5B8C\u74A7\u306A\u6CE8\u6587\u3001\u7D20\u6674\u3089\u3057\u3044\u30B5\u30FC\u30D3\u30B9\u3001\u305D\u3057\u3066\u8FC5\u901F\u306A\u914D\u9054\u3067\u3057\u305F\u3002\u3053\u308C\u4EE5\u4E0A\u671B\u3081\u307E\u305B\u3093\uFF01\r\n\u672C\u5F53\u306B\u611F\u52D5\u3057\u307E\u3057\u305F\uFF01\u5168\u3066\u306E\u30A2\u30A4\u30C6\u30E0\u304C\u6B63\u78BA\u3067\u3001\u914D\u9054\u3082\u65E9\u304B\u3063\u305F\u3067\u3059\u3002\r\n\u554F\u984C\u306A\u304F\u3001\u6CE8\u6587\u3057\u305F\u3082\u306E\u304C\u5168\u3066\u5C4A\u304D\u307E\u3057\u305F\u3002\u3053\u306E\u30B5\u30FC\u30D3\u30B9\u306B\u975E\u5E38\u306B\u6E80\u8DB3\u3057\u3066\u3044\u307E\u3059\uFF01\r\n\u6CE8\u6587\u304C\u5B8C\u74A7\u3067\u3001\u9593\u9055\u3044\u306A\u304F\u30EA\u30D4\u30FC\u30BF\u30FC\u306B\u306A\u308A\u307E\u3059\u3002\r\n\u7D20\u6674\u3089\u3057\u3044\u30B5\u30FC\u30D3\u30B9\u3067\u3059\uFF01\u6CE8\u6587\u304C100\uFF05\u6B63\u78BA\u3067\u3001\u5168\u3066\u304C\u6642\u9593\u901A\u308A\u306B\u914D\u9054\u3055\u308C\u307E\u3057\u305F\u3002\r\n\u9280\u884C\r\n\u30ED\u30FC\u30F3\r\n\u652F\u6255\u3044\r\n\u30EA\u30B9\u30AF\u3092\u53D6\u3063\u3066\u307F\u3066\u306F\u3069\u3046\u3067\u3057\u3087\u3046\u304B\uFF1F\r\n\u65E5\u6255\u3044\r\n\u6BCE\u65E5\u306E\u95A2\u5FC3\r\n\u5168\u984D\u8FD4\u91D1\r\n\u878D\u8CC7\u671F\u9593\r\n\u8CB8\u4ED8\u671F\u9650\u65E5\r\n\u6B8B\u308A\r\n\u4F7F\u7528\u4E2D\r\n\u30AB\u30B9\u30BF\u30DE\u30A4\u30BA\r\n\u30B5\u30A4\u30F3\r\n\u5E97\r\n\u5E97\u540D\r\n\u30D5\u30A9\u30F3\u30C8\u30B5\u30A4\u30BA\r\n\u6587\u5B57\u9593\u9694\r\n\u30AB\u30E9\u30FC\u30D4\u30C3\u30AB\u30FC\r\n\u7D42\u308F\u308A\r\n3D\u3092\u4F7F\u7528\u3059\u308B\r\n\u58C1\u7D19\r\n\u6210\u9577\r\n\u30B9\u30C8\u30EC\u30FC\u30B8\r\n\u90E8\u5C4B\r\n\u30A8\u30EA\u30A2\r\n\u30EC\u30D9\u30EB\r\n\u8CB7\u3046\r\n\u30AA\u30F3\u30E9\u30A4\u30F3\u6CE8\u6587\r\n\u6CE8\u6587\r\n\u30D5\u30A3\u30FC\u30C9\u30D0\u30C3\u30AF\r\n\u6CE8\u6587\u4FA1\u683C\r\n\u914D\u9001\u6599\r\n\u5408\u8A08\r\n\u62D2\u5426\u3059\u308B\r\n\u53D7\u3051\u5165\u308C\u308B\r\n\u6CE8\u6587\u53D7\u4ED8\r\n\u3054\u5E0C\u671B\u306E\u5546\u54C1\r\n\u30D4\u30FC\u30B9\r\n\u8FD4\u4E8B\r\n\u6D88\u53BB\r\n\u7DE8\u96C6\r\n\u5E97\r\n\u6750\u6599\r\n\u5E97\u8217\u7BA1\u7406\r\n\u30E9\u30A4\u30BB\u30F3\u30B9\r\n\u8ACB\u6C42\u66F8\r\n\u96C7\u3046\r\n\u53D6\u308A\u9664\u304F\r\n\u5378\u58F2\u696D\u8005\r\n\u88FD\u54C1\r\n\u5E97\u8217\u6539\u5584\r\n\u3053\u3053\u306F\u7A7A\u3044\u3066\u3044\u307E\u3059\u3001\u4F55\u304B\u8CB7\u3063\u3066\u304F\u3060\u3055\u3044\r\n\u5C0F\u8A08\r\n\u914D\u9001\r\n\u30C1\u30A7\u30C3\u30AF\u30A2\u30A6\u30C8\r\n\u9069\u7528\u3059\u308B\r\n\u5143\u91D1\u91D1\u984D\r\n\u6B8B\u308A\u65E5\u6570\r\n\u65E9\u671F\u652F\u6255\u3044\r\n\u5C11\u984D\u30ED\u30FC\u30F3\r\n\u4E2D\u578B\u30ED\u30FC\u30F3\r\n\u5927\u304D\u306A\u30ED\u30FC\u30F3\r\n\u30AF\u30EA\u30A2\r\n\u30EC\u30D9\u30EB\u3067\u30ED\u30C3\u30AF\u89E3\u9664\u3055\u308C\u307E\u3057\u305F\r\n\u4E8B\u4F8B\r\n\u5F97\u308B\r\n\u8CFC\u5165\u6E08\u307F\r\n\u6CE8\u6587\r\n\u6CE8\u6587\u306E\u8A73\u7D30\r\n\u30B3\u30E1\u30F3\u30C8\r\n\u88C5\u98FE\u54C1\r\n\u5E8A\r\n\u58C1\r\n\u30AD\u30E3\u30C3\u30B7\u30E3\u30FC\r\n\u30B9\u30C8\u30C3\u30AB\u30FC\r\n\u30B9\u30D4\u30FC\u30C9\r\n\u7D66\u6599\r\n\u30A8\u30CD\u30EB\u30AE\u30FC\r\n\u30A2\u30A4\u30C6\u30E0\r\n\u30D0\u30B9\u30B1\u30C3\u30C8\r\n\u7DCF\u68DA\u5546\u54C1\u6570\r\n\u7DCF\u30DC\u30C3\u30AF\u30B9\u5546\u54C1\u6570\r\n\u8CFC\u5165\u53EF\u80FD\r\n\u4EE5\u524D\u306E\u30A2\u30C3\u30D7\u30B0\u30EC\u30FC\u30C9\u304C\u5FC5\u8981\u3067\u3059\r\n\u58F2\u308B\r\n\u6B8B\u308A\u65E5\u6570\r\n\u6B8B\u308A\u306E\u652F\u6255\u3044\r\n\u652F\u6255\u3044\u9045\u5EF6\r\n\u9045\u5EF6\u91D1\u5229\r\n\u304A\u652F\u6255\u3044\u7DCF\u984D\r\n\u672A\u6255\u3044\u306E\u65E5\u6570\r\n\u30A4\u30F3\u30BF\u30FC\u30CD\u30C3\u30C8\u63A5\u7D9A\u304C\u3042\u308A\u307E\u305B\u3093\r\n\u5F85\u3063\u3066\u3044\u308B\u304A\u5BA2\u69D8\r\n\u30B9\u30AD\u30E3\u30F3\u88FD\u54C1\r\n\u652F\u6255\u3044\u5F85\u3061\r\n\u30EC\u30B8\r\n\u304A\u652F\u6255\u3044\u91D1\u984D\r\n\u652F\u6255\u3044\r\n\u5909\u5316\r\nPOS\u3078\u306E\u5165\u529B\r\n\u8FD1\u65E5\u516C\u958B\uFF01\r\n\u30EC\u30B8\u4FC2\u304C\u3044\u308B\u3088\uFF01\r\n\u30EC\u30D9\u30EB5\u306B\u5230\u9054\u3057\u307E\u3057\u3087\u3046\uFF01\r\n{0}
      \u30D4\u30C3\u30AF\u30A2\u30C3\u30D7\r\n{0} \u30AD\u30E3\u30EA\u30FC (\u9577\u62BC\u3057)\r\n{0}\u30C9\u30ED\u30C3\u30D7\r\n{0}
      \u6295\u3052\u308B\r\n{0}\u56DE\u8EE2\r\n{0} \u30AA\u30FC\u30D7\u30F3\r\n{0}
      \u9589\u3058\u308B\r\n{0} \u30AD\u30E3\u30F3\u30BB\u30EB\r\n{0}\u30B4\u30DF\u7BB1\r\n{0}
      \u30C6\u30A4\u30AF\r\n{0} \u304B\u6240\r\n{0}\u30B9\u30AD\u30E3\u30F3\r\n{0}
      \u691C\u67FB\u3059\u308B\r\n{0} \u627F\u8A8D\u3059\u308B\r\n{0}\u8FFD\u52A0\r\n{0}
      \u524A\u9664\r\n{0} \u7761\u7720\r\n{0} \u30A4\u30F3\u30BF\u30E9\u30AF\u30B7\u30E7\u30F3\r\n{0}\u30C9\u30E9\u30A4\u30D6\r\n{0}\u51FA\u3066\u884C\u3051\r\n{0}
