    characterSequence: "\u9867\u5BA2\u304B\u3089\u652F\u6255\u3044\u3092\u53D7\u3051\u53D6\u308A\u307E\u3059\r\n\u304A\u3082\u3061\u3083\u306E\u4FA1\u683C\u3092\u8A2D\u5B9A
