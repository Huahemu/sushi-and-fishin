    characterSequence: "\uB527 !\"#$%()*,-./0123456789:>?@BCDEFIMNOPRSTVXYabcdehilmnoprstuvy{|}\u2014\uAC00\uAC01\uAC04\uAC08\uAC10\uAC11\uAC12\uAC14\uAC15\uAC16\uAC19\uAC1A\uAC1C\uAC1D\uAC70\uAC71\uAC74\uAC78\uAC80\uAC81\uAC83\uAC8C\uACA0\uACA9\uACAC\uACB0\uACB8\uACBC\uACBD\uACC4\uACE0\uACE7\uACE8\uACF0\uACF3\uACF5\uACFC\uACFD\uAD00\uAD11\uAD1C\uAD34\uAD50\uAD6C\uAD6D\uAD70\uAD74\uAD81\uAD8C\uADC0\uADF8\uADFC\uAE00\uAE08\uAE09\uAE30\uAE34\uAE38\uAE41\uAE4A\uAE4C\uAE50\uAE54\uAE68\uAEBC\uAED8\uAEF4\uAF2D\uAF34\uAF64\uAFB8\uAFC0\uAFC8\uB00C\uB04A\uB04C\uB054\uB057\uB05D\uB08C\uB098\uB09C\uB0A0\uB0A8\uB0A9\uB0AC\uB0AD\uB0AE\uB0B4\uB0B8\uB0BC\uB0C5\uB0C8\uB0E5\uB108\uB118\uB123\uB124\uB137\uB141\uB154\uB155\uB178\uB179\uB180\uB188\uB18D\uB192\uB193\uB194\uB204\uB20C\uB274\uB290\uB294\uB298\uB2A5\uB2A6\uB2C8\uB2D0\uB2D8\uB2DD\uB2E4\uB2E5\uB2EB\uB2EC\uB2F4\uB2F5\uB2F9\uB300\uB354\uB358\uB370\uB3C4\uB3C5\uB3C8\uB3D9\uB3FC\uB410\uB418\uB41C\uB420\uB428\uB429\uB450\uB451\uB4A4\uB4DC\uB4DD\uB4E0\uB4E3\uB4E4\uB4ED\uB4EF\uB4F1\uB514\uB518\uB530\uB54C\uB5A0\uB5A4\uB5A8\uB5BB\uB610\uB6F0\uB77C\uB77D\uB780\uB784\uB78C\uB78D\uB790\uB791\uB798\uB799\uB79C\uB7AB\uB7C9\uB7EC\uB7F0\uB7FC\uB7FD\uB807\uB808\uB824\uB825\uB82C\uB834\uB835\uB838\uB839\uB840\uB85C\uB85D\uB860\uB864\uB86D\uB86F\uB8B0\uB8CC\uB8E8\uB8FB\uB958\uB968\uB96D\uB974\uB978\uB97C\uB984\uB985\uB9AC\uB9AD\uB9B0\uB9B4\uB9BC\uB9BD\uB9C8\uB9C9\uB9CC\uB9CE\uB9D0\uB9DD\uB9DE\uB9E4\uBA38\uBA39\uBA3C\uBA48\uBA4B\uBA4D\uBA54\uBA70\uBA74\uBA85\uBA87\uBAA8\uBAA9\uBAAC\uBAB0\uBABB\uBB20\uBB34\uBB38\uBB3C\uBB50\uBB54\uBBAC\uBBC0\uBBF8\uBBFC\uBBFF\uBC00\uBC0F\uBC14\uBC15\uBC16\uBC18\uBC1B\uBC1C\uBC1D\uBC24\uBC29\uBC30\uBC31\uBC84\uBC88\uBC8C\uBC94\uBC95\uBCA0\uBCA4\uBCA8\uBCBD\uBCC0\uBCC4\uBCD1\uBCF4\uBCF5\uBCF8\uBCFC\uBD07\uBD09\uBD10\uBD59\uBD80\uBD84\uBD88\uBD93\uBDF0\uBE0C\uBE44\uBE4C\uBE5B\uBE60\uBE68\uBE7C\uBED0\uBFD0\uC058\uC068\uC069\uC0AC\uC0AD\uC0B0\uC0B4\uC0B6\uC0BD\uC0C1\uC0C8\uC0C9\uC0D0\uC0DD\uC0F5\uC11C\uC11D\uC120\uC124\uC131\uC138\uC139\uC13C\uC154\uC158\uC15C\uC168\uC18C\uC18D\uC190\uC1A1\uC1E0\uC1FC\uC218\uC219\uC21C\uC228\uC22B\uC26C\uC2A4\uC2A8\uC2AC\uC2B5\uC2B9\uC2DC\uC2DD\uC2E0\uC2E4\uC2EC\uC2ED\uC2F1\uC2F6\uC2F8\uC2FC\uC309\uC368\uC4F0\uC4F8\uC500\uC52C\uC539\uC544\uC545\uC548\uC54A\uC54C\uC557\uC558\uC55E\uC560\uC561\uC568\uC571\uC57C\uC57D\uC591\uC598\uC5B4\uC5B5\uC5B8\uC5BB\uC5BC\uC5C4\uC5C5\uC5C6\uC5C7\uC5C8\uC5C9\uC5D0\uC5EC\uC5ED\uC5F0\uC5F4\uC5FD\uC600\uC601\uC608\uC61B\uC624\uC628\uC62C\uC633\uC635\uC640\uC644\uC654\uC65C\uC678\uC67C\uC694\uC695\uC69C\uC6A9\uC6B0\uC6B1\uC6B4\uC6B8\uC6C0\uC6C5\uC6CC\uC6D0\uC6D4\uC6E0\uC704\uC708\uC720\uC728\uC73C\uC740\uC744\uC74C\uC751\uC758\uC774\uC775\uC778\uC77C\uC783\uC784\uC785\uC788\uC78A\uC790\uC791\uC794\uC798\uC7A0\uC7A1\uC7A4\uC7A5\uC7AC\uC7C1\uC800\uC801\uC804\uC808\uC80A\uC810\uC815\uC81C\uC82F\uC838\uC84C\uC870\uC871\uC874\uC880\uC885\uC88B\uC8E0\uC8FC\uC8FD\uC900\uC904\uC90D\uC911\uC92C\uC988\uC98C\uC990\uC998\uC9C0\uC9C1\uC9C4\uC9C8\uC9D1\uC9D3\uC9D5\uC9F8\uCA4C\uCABD\uCC0D\uCC28\uCC29\uCC2E\uCC38\uCC3C\uCC3D\uCC3E\uCC44\uCC98\uCC9C\uCCAB\uCCAD\uCCB4\uCCD0\uCCE4\uCD08\uCD1D\uCD5C\uCD94\uCD95\uCD9C\uCDA4\uCDA9\uCDB0\uCDE8\uCE20\uCE21\uCE58\uCE5C\uCE60\uCE68\uCE74\uCE90\uCE94\uCEE4\uCEE8\uCEF4\uCF1C\uCF58\uCF8C\uCFE0\uD06C\uD070\uD074\uD0A4\uD0C0\uD0C1\uD0D0\uD0D5\uD0DC\uD0DD\uD130\uD14C\uD14D\uD150\uD15C\uD1A0\uD1B5\uD29C\uD2B8\uD2B9\uD2C0\uD2F0\uD301\uD305\uD30C\uD310\uD314\uD328\uD398\uD3B4\uD3B8\uD3C9\uD3D0\uD3EC\uD3ED\uD45C\uD478\uD480\uD488\uD48D\uD4E8\uD504\uD508\uD50C\uD53C\uD53D\uD544\uD551\uD558\uD559\uD55C\uD560\uD568\uD569\uD56D\uD574\uD588\uD589\uD5A5\uD5CC\uD5D8\uD604\uD608\uD611\uD615\uD638\uD654\uD655\uD658\uD65C\uD669\uD68C\uD68D\uD6A8\uD6C4\uD6CC\uD6D4\uD6E8\uD734\uD754\uD758\uD760\uD761\uD765\uD76C\uD788\uD78C\uD798\uACE0\uAC1D\uC5D0\uAC8C\uC11C
      \uACB0\uC81C\uB97C \uBC1B\uC73C\uC2ED\uC2DC\uC624\r\n\uC7A5\uB09C\uAC10 \uAC00\uACA9
      \uC124\uC815 : \uD569\uB9AC\uC801\uC778\r\n\uC2A4\uCE94\uD560 \uC81C\uD488\uC744
      \uD074\uB9AD\uD558\uC138\uC694\r\n\uC7A5\uB09C\uAC10\uC744 \uC120\uBC18\uC5D0
      \uB123\uAE30\r\n\uC8FC\uBB38\uD55C \uC74C\uC2DD\uC744 \uC678\uBD80\uC5D0\uC11C
      \uD53D\uC5C5\uD558\uC138\uC694.\r\n\uCEF4\uD4E8\uD130\uB97C \uC0AC\uC6A9\uD558\uC5EC
      \uC7A5\uB09C\uAC10 \uC8FC\uBB38\r\n\uB9E4\uC7A5 \uC624\uD508\r\n\uD78C\uD2B8:
      \uB799\uC5D0\uC11C RMB\uB97C \uC0AC\uC6A9\uD558\uC5EC \uC0AC\uC6A9\uC790 \uC815\uC758\uD558\uC138\uC694!\r\n\uD78C\uD2B8:
      \uACF5\uC6D0\uC5D0\uC11C \uB3C4\uC6C0\uC744 \uC904 \uC218 \uC788\uB294 \uC0AC\uB78C\uC744
      \uCC3E\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\r\n\uD78C\uD2B8: \uC8FC\uBB38\uC744
      \uBC30\uB2EC\uD558\uB294 \uB3D9\uC548 \uC2A4\uCFE0\uD130\uB97C \uC0AC\uC6A9\uD558\uB294
      \uAC83\uC744 \uC78A\uC9C0 \uB9C8\uC138\uC694!\r\n\uD78C\uD2B8: \uB354 \uB9CE\uC740
      \uAE30\uB2A5\uC5D0 \uB300\uD55C \uB9AC\uBDF0\uB97C \uC791\uC131\uD558\uB294
      \uAC83\uC744 \uC78A\uC9C0 \uB9C8\uC138\uC694!\r\n\uD78C\uD2B8: \uD3EC\uD478\uC758
      \uBE44\uBC00 \uBA54\uC2DC\uC9C0\uB97C \uCC3E\uB294 \uAC83\uC744 \uC78A\uC9C0
      \uB9C8\uC138\uC694!\r\n\uC120\uBC18\uC744 \uC8FC\uBB38\uC744 \uBC1B\uC544\uC11C
      \uB9CC\uB4DC\uC2ED\uC2DC\uC624\r\n\uC7A5\uB09C\uAC10 \uAD6C\uB9E4\r\n\uC7A5\uB09C\uAC10
      \uD310\uB9E4\r\n\uAC00\uACA9\uD45C \uC124\uC815\r\n\uC120\uBC18 \uC0AC\uC6A9\uC790
      \uC815\uC758\r\n\uC0C1\uC810 \uAC04\uD310 \uC0AC\uC6A9\uC790 \uC815\uC758\r\n\uC7A5\uC2DD
      \uAD6C\uB9E4\r\n\uC2A4\uCFE0\uD130\uB97C \uC6B4\uC804\uD558\uC138\uC694.\r\n\uB77C\uC774\uC13C\uC2A4\uB97C
      \uC7A0\uAE08 \uD574\uC81C\uD558\uC2ED\uC2DC\uC624.\r\n\uC628\uB77C\uC778 \uC8FC\uBB38\uC73C\uB85C
      \uC8FC\uBB38 \uBC1B\uAE30\r\n\uBC14\uB2E5\uC744 \uCCAD\uC18C\uD558\uC138\uC694\r\n\uC2DC\uAC01
      \uC7A5\uC560\uC778\uACFC \uB300\uD654\r\nTab \uD0A4\uB97C \uB20C\uB7EC \uD560
      \uC77C \uBAA9\uB85D\uC744 \uC5FD\uB2C8\uB2E4.\r\n\uC1FC\uD551\uD558\uB7EC \uAC00\uAE30\r\n\uC0C1\uC0AC\uC640
      \uB300\uD654\r\n\uD560 \uC77C \uC5F4\uAE30\r\n\uD560 \uC77C \uB2EB\uAE30\r\n\uAC78\uB808\uB97C
      \uAC00\uC838 \uAC00\uB77C\r\n\uBA3C\uC9C0\uB97C \uCCAD\uC18C\uD558\uC138\uC694\r\n\uBB38\uC744
      \uC5F4\uC5B4\uB77C\r\n\uB300\uAC78\uB808\uB97C \uB358\uC838\uB77C\r\n\uB799\uC744
      \uAC00\uC838 \uAC00\uB77C\r\n\uB799 \uBC30\uCE58\r\n\uC628\uB77C\uC778 \uC8FC\uBB38
      \uBC1B\uAE30\r\n\uC628\uB77C\uC778 \uC8FC\uBB38 \uC0C1\uC790 \uBC1B\uAE30\r\n\uC628\uB77C\uC778
      \uC8FC\uBB38 \uC81C\uD488 \uBC1B\uAE30\r\n\uC628\uB77C\uC778 \uC8FC\uBB38 \uBC30\uC1A1\r\n\uC2A4\uCFE0\uD130\uB97C
      \uC6B4\uC804\uD558\uC138\uC694\r\n\uC154\uD130\uB97C \uC5F4\uC5B4\uB77C\r\n\uACE0\uAC1D\uC744
      \uAE30\uB2E4\uB824\uC8FC\uC138\uC694\r\n\uC9D1\uC73C\uB85C \uC774\uB3D9\r\n\uBCA4\uCE58\uB85C
      \uC774\uB3D9\r\n\uC0C1\uC790\uB97C \uC4F0\uB808\uAE30\uD1B5\uC5D0 \uBC84\uB9AC\uC138\uC694\r\n\uAE08\uC804\uB4F1\uB85D\uAE30\uB85C
      \uC774\uB3D9\r\n{0}\uC744(\uB97C) \uB204\uB974\uC138\uC694\r\n\uC791\uC5C5\r\n\uD560
      \uC77C \uBAA9\uB85D\r\n\uC544\uCE68\uC744 \uBA39\uC5B4\uB77C\r\n\uC77C\uD558\uB7EC
      \uAC00\uC138\uC694\r\n\uC9D1\uC138\uB97C \uC9C0\uBD88\uD558\uC138\uC694\r\n\uB2F9\uC2E0\uC740
      \uBB34\uC5C7\uC744 \uC6D0\uD558\uC138\uC694?\r\n\uB098\uB294 \uAC8C\uC784\uC744
      \uD558\uACE0 \uC2F6\uB2E4.\r\n\"\uD2B9\uBCC4\uD55C \uC7A5\uB09C\uAC10\uC744
      \uC790\uB791\uD574\uBCF4\uC138\uC694.\r\n\"\r\n\uAD1C\uCC2E\uC544\uC694.\r\n\uC800\uB294
      \uC4F0\uB9AC \uCE74\uB4DC \uBAAC\uD14C(Three Card Monte)\uB97C \uD50C\uB808\uC774\uD558\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4.\r\n\uB098\uB294 \uC8FC\uC0AC\uC704\uB97C \uAD74\uB9B4
      \uAC83\uC774\uB2E4.\r\n\uC8FC\uC0AC\uC704 \uD3EC\uC778\uD2B8 -> {0}\r\n5\uB2EC\uB7EC\uC5D0
      \uBB34\uC5C7\uC744 \uAC78\uACE0 \uC2F6\uB098\uC694?\r\n\uC2A4\uD06C\uB798\uCE58
      \uCE74\uB4DC\uB97C \uC8FC\uC138\uC694.\r\n\uD2B9\uBCC4\uD55C \uC7A5\uB09C\uAC10?
      \uC544\uC9C1 \uC5EC\uAE30\uC5D0\uB294 \uC5C6\uC9C0\uB9CC \uACE7 \uB0B4 \uC190\uC5D0
      \uB4E4\uC5B4\uC62C \uAC83\uC785\uB2C8\uB2E4.\r\n\uB2F9\uC2E0\uC774 \uC774\uACBC\uC5B4\uC694!
      \uD558\uC9C0\uB9CC \uB2E4\uC74C \uBC88\uC5D0\uB294 \uADF8 \uD589\uC6B4\uC744
      \uAE30\uB300\uD558\uC9C0 \uB9C8\uC138\uC694.\r\n\uB2F9\uC2E0\uC740 \uC783\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC5B4\uCA4C\uBA74 \uC774 \uB3C4\uBC15 \uC0AC\uC5C5\uC774 \uB2F9\uC2E0\uC744
      \uC704\uD55C \uAC83\uC774 \uC544\uB2D0\uC9C0\uB3C4 \uBAA8\uB974\uC8E0?\r\n\uB3C8\uC774
      \uC5C6\uC5B4\uC694, \uD615. \uC800\uB9AC \uAC00\uC694.\r\n\uB77C\uC774\uBC8C
      \uC0C1\uC810\uC744 \uBC29\uD574\uD560 \uC218 \uC788\uB098\uC694?\r\n\uC5B4\uB5A4
      \uC0C9\uAE54\uC5D0 \uBCA0\uD305\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\r\n\uB300\uB9AC\uC11D
      \uACBD\uC8FC\uB97C \uD558\uACE0 \uC2F6\uC5B4\uC694.\r\n\uBE68\uAC04\uC0C9.\r\n\uBCF4\uB77C.\r\n\uB179\uC0C9.\r\n\uB178\uB780\uC0C9.\r\n\uB3C8\uC774
      \uC5C6\uC5B4\uC694, \uD615. \uC800\uB9AC \uAC00\uC694.\r\n\uB300\uB9AC\uC11D
      \uACBD\uC8FC\uB97C \uD558\uACE0 \uC2F6\uC5B4\uC694.\r\n\"\"\"Blind Man\"\"\uC740
      \uCCAB \uBC88\uC9F8 \uAD74\uB9BC\uC5D0\uC11C 7\uC774\uB098 11\uC774 \uB098\uC624\uBA74
      \uC2B9\uB9AC\uD569\uB2C8\uB2E4.\r\n\uCCAB \uBC88\uC9F8 \uAD74\uB9BC\uC5D0\uC11C
      2, 3, 12\uAC00 \uB098\uC624\uBA74 \uB2F9\uC2E0\uC774 \uC2B9\uB9AC\uD569\uB2C8\uB2E4.\r\n4,
      5, 6, 8, 9, 10\uC774 \uB098\uC624\uBA74 \uD574\uB2F9 \uC22B\uC790\uAC00 \"\"\uD3EC\uC778\uD2B8\"\"\uB85C
      \uC124\uC815\uB418\uACE0 \uAC8C\uC784\uC740 \uACC4\uC18D\uB429\uB2C8\uB2E4.\r\n\uADF8\uB54C\uBD80\uD130
      \"\"Blind Man\"\"\uC774 7\uC774 \uB098\uC624\uBA74 \uB2F9\uC2E0\uC774 \uC2B9\uB9AC\uD569\uB2C8\uB2E4.
      \uADF8\uAC00 \"\"\uD3EC\uC778\uD2B8\"\" \uC22B\uC790\uB97C \uAD74\uB9AC\uBA74
      Blind Man\uC774 \uC2B9\uB9AC\uD569\uB2C8\uB2E4.\"\r\n\uC54C\uACA0\uC2B5\uB2C8\uB2E4!\r\n\uC8FC\uC0AC\uC704
      \uAC8C\uC784\uC744 \uC544\uC2DC\uB098\uC694?\r\n\uB124, \uC54C\uC544\uC694!\r\n\uC544\uB2C8\uC694\r\n\uC548\uB155\uD558\uC138\uC694.\r\n\uC7A5\uB09C\uAC10\uC774
      {0}\uAC1C \uC788\uC2B5\uB2C8\uB2E4.\r\n{0}\uC774(\uAC00) \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC88B\uC740
      \uD558\uB8E8 \uBCF4\uB0B4\uC138\uC694!\r\n\r\n\uC624\uB298 \uAE30\uBD84\uC774
      \uC5B4\uB5A0\uC138\uC694?\r\n\uBB34\uC5C7\uC744 \uCC3E\uACE0 \uACC4\uC2E0\uAC00\uC694?\r\n\uC635\uC158\uC774
      \uC65C \uC774\uB807\uAC8C \uC801\uB098\uC694?\r\n\r\n\r\n\uC548\uB155\uD558\uC138\uC694.\r\n\uC608?\r\n\uB09C
      \uAD1C\uCC2E\uC544\uC694, \uACE0\uB9C8\uC6CC\uC694!\r\n\uC6B0\uB9AC\uB294 \uC544\uC9C1
      \uB9CC\uB098\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uC815\uC2DD \uBC84\uC804\uC5D0\uC11C
      \uB354 \uB9CE\uC740 \uC815\uBCF4\uB97C \uB9CC\uB098\uBCF4\uC138\uC694!\r\n\r\n\r\n\r\n\r\n\r\n\r\n\uAE08\uC804\uB4F1\uB85D\uAE30\uB294
      \uC5B4\uB514\uC5D0 \uC788\uB098\uC694?\r\n{0}\uC774(\uAC00) \uC788\uB098\uC694?\r\n\r\n\r\n\r\n\uC5C6\uB294
      \uAC83 \uAC19\uC2B5\uB2C8\uB2E4. \uC2E4\uB9DD\uC2A4\uB7FD\uB124\uC694.\r\n\uC544,
      \uB098 \uC5EC\uAE30\uC11C \uC1FC\uD551 \uC911\uC774\uC57C!\r\n\uACC4\uC18D
      \uC774\uB7EC\uBA74 \uC1FC\uD551\uC744 \uBABB\uD574\uC694.\r\n\uADF8\uB7FC \uC774\uAC8C
      \uB2F9\uC2E0\uC758 \uD50C\uB808\uC774 \uC2A4\uD0C0\uC77C\uC774\uAD70\uC694,
      \uADF8\uB807\uC8E0?\r\n{0}\uC744(\uB97C) \uCC3E\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uBC29\uAE08
      \uB124 \uCEE4\uD53C \uAC12\uB3C4 \uB0B4\uAC00 \uC9C0\uBD88\uD588\uB2C8?\r\n\uBC29\uAE08
      \uB124 \uC810\uC2EC\uAC12\uB3C4 \uB0B4\uAC00 \uC9C0\uBD88\uD588\uB2C8?\r\n\uB0B4\uAC00
      \uBC29\uAE08 \uB2F9\uC2E0\uC758 \uD301\uBCD1\uC5D0 \uAE30\uBD80\uD588\uB098\uC694?\r\n\uC774\uC81C
      \uC0AC\uD0D5\uC744 \uC5B4\uB5BB\uAC8C \uC0AC\uB098\uC694?\r\n\uD558\uC9C0\uB9CC
      \uB098\uB294 \uADF8\uAC83\uC744 \uB3FC\uC9C0 \uC800\uAE08\uD1B5\uC744 \uC704\uD574
      \uC544\uAEF4\uB450\uC5C8\uC5B4\uC694!\r\n\uC6B0\uB9AC \uC544\uC774\uC5D0\uAC8C\uB294
      \uC5B4\uB5A4 \uC7A5\uB09C\uAC10\uC774 \uAC00\uC7A5 \uC88B\uC744\uAE4C\uC694?\r\n\uC5B4\uB290
      \uAC83\uC744 \uBC1B\uC544\uC57C \uD569\uB2C8\uAE4C?\r\n\uC544\uC774\uB4E4\uC774
      \uC774 {0}\uC744(\uB97C) \uC88B\uC544\uD560\uC9C0 \uAD81\uAE08\uD569\uB2C8\uB2E4.\r\n\uACB0\uC815\uC744
      \uBABB\uD558\uACA0\uC2B5\uB2C8\uB2E4... {0}\uC744 \uC120\uD0DD\uD574\uC57C
      \uD560\uAE4C\uC694?\r\n\uC5B4\uB290 \uAC83\uC744 \uACE8\uB77C\uC57C\uD560\uC9C0
      \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4 ...\r\n\uBA4B\uC9C4! \uC774\uC5D0 \uB300\uD55C
      \uD560\uC778\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uAF2D \uAC00\uC838\uAC08\uAC8C\uC694.\r\n\uC7A0\uAE50\uB9CC\uC694,
      \uC81C\uAC00 \uBCF8 \uAC00\uACA9\uC774 \uC544\uB2C8\uB124\uC694. \uD45C\uC2DC\uB41C
      \uAC00\uACA9\uC744 \uC9C0\uBD88\uD558\uACA0\uC2B5\uB2C8\uB2E4.\r\n{0} \uAC00\uACA9\uC774
      \uB108\uBB34 \uBE44\uC2F8\uC694.\r\n{0} \uAF64 \uBE44\uC309\uB2C8\uB2E4.\r\n{0}
      \uBE44\uC2F8\uC694.\r\n{0} \uC88B\uC740 \uAC00\uACA9.\r\n\uC548\uB3FC \uC548\uB3FC
      \uC548\uB3FC..\r\n\uC7A0\uAE50\uB9CC\uC694, \uB09C \uBC84\uADF8\uAC00 \uC544\uB2C8\uC5C8\uC5B4\uC694...\r\n\uB4DC\uB514\uC5B4
      \uC548\uC73C\uB85C \uB4E4\uC5B4\uC654\uC2B5\uB2C8\uB2E4...\r\n\uBE4C\uC5B4\uBA39\uC744
      \uB300\uAE30\uC5F4, \uB4E4\uC5B4\uAC08 \uC218\uB3C4 \uC5C6\uC5C8\uC5B4\uC694!\r\n\uC774
      \uAC00\uAC8C\uB294 \uC65C \uBB38\uC744 \uB2EB\uC558\uB294\uC9C0...\r\n\uB300\uAE30\uC5F4\uC774
      \uB108\uBB34 \uAE38\uC5B4\uC694...\r\n\uC904\uC774 \uC5C4\uCCAD \uB9CE\uC740
      \uAC83 \uAC19\uC740\uB370 \uAD1C\uD788 \uC654\uC5B4\uC694.\r\n\uB354 \uC774\uC0C1
      \uAE30\uB2E4\uB9B4 \uC218\uAC00 \uC5C6\uC5B4\uC694!\r\n{0}\uC774 \uC788\uAE30\uB97C
      \uBC14\uB78D\uB2C8\uB2E4.\r\n\uC774\uBD10, \uBB50\uD558\uB294 \uAC70\uC57C!\r\n\uADF8\uB9CC\uD574\uC694!\r\n@#$%!\r\n\uC54C\uC558\uC5B4
      \uC54C\uC558\uC5B4 \uB098 \uAC08\uAC8C!\r\n\uB2E4\uC2DC \uC2DC\uB3C4\uD558\uC9C0
      \uB9C8\uC138\uC694!\r\n\uC548\uB155! \uB098\uB294 \uB2F9\uC2E0\uC744 \uC774
      \uADFC\uCC98\uC5D0\uC11C \uD55C\uB3D9\uC548 \uBCF4\uC558\uC2B5\uB2C8\uB2E4.
      \uC7A5\uB09C\uAC10 \uC0AC\uC5C5\uC740 \uC218\uC775\uC131\uC774 \uC788\uB098\uC694?\r\n\uBCC4\uAC70
      \uC544\uB2C8\uC9C0\uB9CC \uC7AC\uBBF8\uC788\uB294 \uC9C1\uC5C5\uC774\uC5D0\uC694.\r\n\uBB3C\uB860
      \uC218\uC775\uC131\uC744 \uB192\uC774\uAE30 \uC704\uD574 \uB178\uB825\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC798 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4. \uC774
      \uBD84\uC57C\uC5D0\uC11C\uB294 \uC880 \uC5B4\uB835\uC2B5\uB2C8\uB2E4.\r\n\uB9CE\uC9C0\uB294
      \uC54A\uC9C0\uB9CC \uC544\uC774\uB4E4\uC774 \uD589\uBCF5\uD574\uD558\uB294
      \uBAA8\uC2B5\uC744 \uBCF4\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4 \uCDA9\uBD84\uD569\uB2C8\uB2E4.\r\n\uC7AC\uBBF8\uC788\uB294?
      \uADF8\uB798\uC11C\uC778\uC9C0 \uC7A5\uB09C\uAC10 \uAC00\uAC8C \uC8FC\uC778\uB4E4\uC740
      \uD56D\uC0C1 \uCF8C\uD65C\uD574 \uBCF4\uC774\uB294 \uAC83 \uAC19\uC544\uC694!\r\n\uC0AC\uC2E4
      \uC694\uC998\uC5D0\uB294 \uBAA8\uB450\uAC00 \uC0B4\uC544\uB0A8\uAE30 \uC704\uD574
      \uC5F4\uC2EC\uD788 \uC77C\uD574\uC57C \uD569\uB2C8\uB2E4.\r\n\uC815\uB9D0 \uC88B\uC740
      \uBC29\uBC95\uC774\uB124\uC694. \uC138\uC0C1\uC5D0\uB294 \uB2F9\uC2E0 \uAC19\uC740
      \uC0AC\uB78C\uC774 \uB354 \uB9CE\uC774 \uD544\uC694\uD569\uB2C8\uB2E4!\r\n\uC774
      \uBD84\uC57C\uC5D0\uC11C \uD798\uB4E0\uAC00\uC694? \uC65C \uADF8\uB807\uAC8C
      \uC0DD\uAC01\uD558\uC138\uC694?\r\n\uC774 \uB3D9\uB124 \uC0AC\uB78C\uB4E4\uC740
      \uC7A5\uB09C\uAC10\uC744 \uBCC4\uB85C \uC0AC\uC9C0 \uC54A\uC544\uC694.\r\n\uACBD\uC7C1\uC774
      \uB108\uBB34 \uC2EC\uD574\uC11C \uB300\uD615 \uB9E4\uC7A5\uC774 \uC6B0\uB9AC\uB97C
      \uB354 \uD798\uB4E4\uAC8C \uD569\uB2C8\uB2E4.\r\n\uC774\uACF3\uC758 \uB300\uBD80\uBD84\uC758
      \uC0AC\uB78C\uB4E4\uC740 \uACBD\uC7C1\uC5C5\uCCB4\uC758 \uB354 \uC800\uB834\uD55C
      \uC635\uC158\uC744 \uC120\uD638\uD569\uB2C8\uB2E4.\r\n\uBAA8\uB974\uACA0\uC5B4\uC694.
      \uC5B4\uCA4C\uBA74 \uC81C\uAC00 \uBD80\uC871\uD574\uC11C\uC77C \uC218\uB3C4
      \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC0AC\uC2E4, \uC5B4\uCA4C\uBA74 \uADF8\uB4E4\uC758
      \uC6B0\uC120\uC21C\uC704\uAC00 \uB2E4\uB978 \uAC83\uC5D0 \uC9D1\uC911\uB418\uC5B4
      \uC788\uC744 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4\r\n\uB300\uD615 \uB9E4\uC7A5\uC740
      \uC704\uD611\uC801\uC77C \uC218 \uC788\uC9C0\uB9CC \uC9C0\uC5ED \uBE44\uC988\uB2C8\uC2A4\uB97C
      \uC9C0\uC6D0\uD558\uB294 \uAC83\uC740 \uC911\uC694\uD569\uB2C8\uB2E4.\r\n\uC544,
      \uB2F5\uB2F5\uD558\uB2E4. \uD558\uC9C0\uB9CC \uD488\uC9C8\uC740 \uD56D\uC0C1
      \uBE5B\uC744 \uBC1C\uD569\uB2C8\uB2E4!\r\n\uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uC9C0
      \uB9C8\uC138\uC694! \uBAA8\uB4E0 \uC9C1\uC5C5\uC5D0\uB294 \uC5B4\uB824\uC6C0\uC774
      \uC788\uC9C0\uB9CC \uC5EC\uB7EC\uBD84\uC5D0\uAC8C\uB294 \uC774\uAC83\uC774
      \uC788\uC2B5\uB2C8\uB2E4.\r\n\uB2F9\uC2E0\uC758 \uAC00\uAC8C\uB294 \uD765\uBBF8\uB86D\uC2B5\uB2C8\uB2E4!
      \uC77C\uBC18\uC801\uC73C\uB85C \uC7A5\uB09C\uAC10 \uAC00\uAC8C\uC5D0\uB294
      \uB3D9\uC77C\uD55C \uC720\uD615\uC758 \uC81C\uD488\uC774 \uC788\uC9C0\uB9CC
      \uADC0\uD558\uC758 \uC7A5\uB09C\uAC10 \uC0C1\uC810\uC740 \uC57D\uAC04 \uB2E4\uB978
      \uAC83 \uAC19\uC2B5\uB2C8\uB2E4. \uC0AC\uC5C5\uC740 \uC798 \uB418\uC5B4\uAC00\uACE0
      \uC788\uB098\uC694?\r\n\uAF64 \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC
      \uC800\uB294 \uD56D\uC0C1 \uAC1C\uC120\uD558\uAE30 \uC704\uD574 \uB178\uB825\uD558\uACE0
      \uC788\uC2B5\uB2C8\uB2E4.\r\n\uB098\uC058\uC9C0\uB294 \uC54A\uC9C0\uB9CC \uB54C\uB85C\uB294
      \uACBD\uC7C1\uC774 \uC5B4\uB824\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC798
      \uC9C4\uD589\uB418\uACE0 \uC788\uC9C0\uB9CC \uB54C\uB85C\uB294 \uC0C1\uD669\uC774
      \uC870\uAE08 \uB290\uB824\uC9C8 \uB54C\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC0AC\uC5C5\uC740
      \uAFB8\uC900\uD558\uC9C0\uB9CC \uB298 \uC0C8\uB85C\uC6B4 \uAC83\uC744 \uC2DC\uB3C4\uD558\uACE0
      \uC788\uC5B4\uC694.\r\n\uB124, \uBAA8\uB4E0 \uC0AC\uC5C5\uC740 \uACC4\uC18D\uD574\uC11C
      \uAC1C\uC120\uB418\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uD56D\uC0C1 \uBC14\uAFC0
      \uAC83\uC774 \uC788\uC2B5\uB2C8\uB2E4!\r\n\uB098\uC058\uC9C0\uB294 \uC54A\uC9C0\uB9CC
      \uB54C\uB85C\uB294 \uACBD\uC7C1\uC774 \uC5B4\uB824\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC798
      \uC9C4\uD589\uB418\uACE0 \uC788\uC9C0\uB9CC \uB54C\uB85C\uB294 \uC0C1\uD669\uC774
      \uC870\uAE08 \uB290\uB824\uC9C8 \uB54C\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC5EC\uAE30\uC11C
      \uB610 \uBB34\uC2A8 \uC77C\uC774 \uBC8C\uC5B4\uC9C0\uACE0 \uC788\uB294 \uAC78\uAE4C\uC694?
      \uC694\uC998 \uC0AC\uB78C\uB4E4\uC740 \uBB34\uC5C7\uC5D0 \uBE60\uC838 \uC788\uB098\uC694?\r\n\uCD5C\uADFC
      \uC0AC\uB78C\uB4E4\uC740 \uC57C\uC678\uC5D0\uC11C \uB354 \uB9CE\uC740 \uC2DC\uAC04\uC744
      \uBCF4\uB0B4\uB294 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4. \uACF5\uC6D0\uC774 \uC810\uC810
      \uB354 \uBC14\uBE60\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC774\uACF3\uC740
      \uAF64 \uD65C\uAE30\uAC00 \uB118\uCE58\uACE0 \uD56D\uC0C1 \uBB34\uC2A8 \uC77C\uC774
      \uC77C\uC5B4\uB098\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC0AC\uB78C\uB4E4\uC758
      \uC1FC\uD551 \uC2B5\uAD00\uC774 \uBC14\uB00C\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544\uC694.
      \uB354 \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC774 \uC628\uB77C\uC778\uC73C\uB85C
      \uC1FC\uD551\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uB098\uB294 \uC774 \uC8FC\uBCC0\uC5D0\uC11C
      \uB354 \uB9CE\uC740 \uC0AC\uAD50 \uD589\uC0AC\uAC00 \uC5F4\uB9AC\uB294 \uAC83\uC744
      \uBCF4\uC558\uC2B5\uB2C8\uB2E4. \uC774\uACF3\uC774 \uC880 \uB354 \uD65C\uAE30
      \uB118\uCE58\uB294 \uAC83 \uAC19\uC544\uC694\r\n\uB124, \uC790\uC5F0\uACFC
      \uC2E0\uC120\uD55C \uACF5\uAE30\uB294 \uC5B8\uC81C\uB098 \uB9E4\uB825\uC801\uC774\uC5D0\uC694.
      \uC0AC\uB78C\uB4E4\uC740 \uB54C\uB54C\uB85C \uBC16\uC5D0\uC11C \uD734\uC2DD\uC744
      \uCDE8\uD558\uACE0 \uC2F6\uC5B4\uD569\uB2C8\uB2E4.\r\n\uADF8 \uB9D0\uC744 \uB4E4\uC73C\uB2C8
      \uAE30\uC058\uB124\uC694! \uADF8\uACF3\uC740 \uD56D\uC0C1 \uBAA8\uB4E0 \uC77C\uC774
      \uC77C\uC5B4\uB098\uB294 \uC5ED\uB3D9\uC801\uC778 \uC7A5\uC18C\uC784\uC5D0
      \uD2C0\uB9BC\uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uB124, \uC628\uB77C\uC778 \uC1FC\uD551\uC774
      \uC815\uB9D0 \uB298\uC5C8\uC5B4\uC694. \uD558\uC9C0\uB9CC \uC624\uD504\uB77C\uC778
      \uB9E4\uC7A5\uC740 \uD2B9\uBCC4\uD55C \uBD84\uC704\uAE30\uB97C \uAC16\uACE0
      \uC788\uC5B4 \uC0AC\uB78C\uB4E4\uC758 \uAD00\uC2EC\uC744 \uB04C\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uD65C\uBC1C\uD558\uAC8C
      \uD65C\uB3D9\uD558\uB294 \uAC83\uC774 \uC88B\uC2B5\uB2C8\uB2E4! \uD589\uC0AC\uB294
      \uC0AC\uB78C\uB4E4\uC774 \uD568\uAED8 \uBAA8\uC77C \uC218 \uC788\uB294 \uC644\uBCBD\uD55C
      \uAE30\uD68C\uC785\uB2C8\uB2E4.\r\n\uAC00\uB054 \uC5EC\uAE30\uC11C \uC2DC\uAC04\uC744
      \uBCF4\uB0B4\uBA74 \uC0AC\uB78C\uB4E4\uC774 \uB108\uBB34 \uBE68\uB9AC \uC6C0\uC9C1\uC774\uC8E0?
      \uD56D\uC0C1 \uBB34\uC2A8 \uC77C\uC774 \uC77C\uC5B4\uB098\uACE0 \uC788\uB294
      \uAC83 \uAC19\uC544\uC694.\r\n\uB54C\uB54C\uB85C \uB098\uB294 \uC774 \uBAA8\uB4E0
      \uC18D\uB3C4\uC5D0 \uAE38\uC744 \uC783\uC740 \uB290\uB08C\uC744 \uBC1B\uC2B5\uB2C8\uB2E4.\r\n\uC751,
      \uBAA8\uB4E0 \uAC8C \uB108\uBB34 \uBE68\uB9AC \uD758\uB7EC\uAC00\uC11C \uB530\uB77C\uC7A1\uC744
      \uC218 \uC5C6\uC744 \uB54C\uB3C4 \uC788\uC5B4.\r\n\uC7A0\uC2DC \uC26C\uC5B4\uAC00\uB294
      \uAC83\uB3C4 \uC88B\uC744 \uD150\uB370, \uBAA8\uB4E0 \uAC83\uC774 \uD55C\uAEBC\uBC88\uC5D0
      \uAC15\uB82C\uD558\uAC8C \uB290\uAEF4\uC9C0\uB124\uC694.\r\n\uD56D\uC0C1 \uBB34\uC2A8
      \uC77C\uC774 \uC77C\uC5B4\uB098\uACE0 \uC788\uB294 \uAC83\uCC98\uB7FC \uB290\uAEF4\uC9C0\uC9C0\uB9CC
      \uB3D9\uC2DC\uC5D0 \uC2E4\uC81C\uB85C\uB294 \uC544\uBB34 \uC77C\uB3C4 \uC77C\uC5B4\uB098\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uBE60\uB974\uAC8C \uC6C0\uC9C1\uC774\uBA74 \uC9C0\uCE60
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uB3D9\uC2DC\uC5D0 \uC880
      \uD765\uBBF8\uB86D\uC9C0 \uC54A\uB098\uC694?\r\n\uB098\uB294 \uADF8\uAC83\uC744
      \uC774\uD574\uD55C\uB2E4. \uB54C\uB85C\uB294 \uBA48\uCDB0\uC11C \uC2EC\uD638\uD761\uC744
      \uD574\uC57C \uD560 \uB54C\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \uC0C1\uD669\uC774
      \uB290\uB824\uC9C0\uBA74 \uBAA8\uB4E0 \uAC83\uC744 \uC2E4\uC81C\uB85C \uC54C\uC544\uCC28\uB9B4
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uB124, \uB54C\uB54C\uB85C \uC6B0\uB9AC\uB294
      \uB108\uBB34 \uBC14\uBE60\uC11C \uC8FC\uBCC0\uC5D0\uC11C \uBB34\uC2A8 \uC77C\uC774
      \uC77C\uC5B4\uB098\uACE0 \uC788\uB294\uC9C0 \uC54C\uC544\uCC28\uB9AC\uC9C0
      \uBABB\uD560 \uB54C\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uB54C\uB85C\uB294 \uC2DC\uAC04\uC744
      \uCD94\uC801\uD558\uB294 \uAC83\uC774 \uC5B4\uB835\uC2B5\uB2C8\uB2E4. \uB2F9\uC2E0\uC5D0\uAC8C
      \uC2DC\uAC04\uC740 \uC5B4\uB5BB\uAC8C \uD758\uB7EC\uAC00\uB098\uC694?\r\n\uB54C\uB85C\uB294
      \uB108\uBB34 \uBE68\uB9AC \uC9C0\uB098\uAC00\uAE30\uB3C4 \uD558\uACE0 \uB54C\uB85C\uB294
      \uC815\uB9D0 \uB290\uB9AC\uAC8C \uB290\uAEF4\uC9C0\uAE30\uB3C4 \uD569\uB2C8\uB2E4.\r\n\uC544\uCE68\uC740
      \uBCF4\uD1B5 \uC9C0\uB8E8\uD558\uC9C0\uB9CC \uC800\uB141\uC774 \uB418\uBA74
      \uAE30\uBD84\uC774 \uC88B\uC544\uC9D1\uB2C8\uB2E4.\r\n\uBE60\uB974\uAC8C \uD758\uB7EC\uAC00\uC9C0\uB9CC
      \uB54C\uB85C\uB294 \uC18C\uC18C\uD55C \uC21C\uAC04\uB3C4 \uB193\uCE58\uACE0
      \uC2F6\uC9C0 \uC54A\uC744 \uB54C\uAC00 \uC788\uB2E4.\r\n\uB54C\uB85C\uB294
      \uC2DC\uAC04\uC744 \uC5B4\uB5BB\uAC8C \uBCF4\uB0B4\uB294\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4.\r\n\uB124,
      \uC5B4\uB5A4 \uB0A0\uC740 \uC790\uC2E0\uB3C4 \uBAA8\uB974\uAC8C \uD558\uB8E8\uAC00
      \uC9C0\uB098\uAC00\uB294 \uAC83\uCC98\uB7FC \uB290\uAEF4\uC9C8 \uB54C\uB3C4
      \uC788\uC2B5\uB2C8\uB2E4.\r\n\uD558\uB8E8\uC758 \uCC98\uC74C \uBA87 \uC2DC\uAC04\uC740
      \uD56D\uC0C1 \uAC00\uC7A5 \uD798\uB4E0 \uC2DC\uAC04\uC785\uB2C8\uB2E4. \uD558\uC9C0\uB9CC
      \uC800\uB141\uC740 \uAE34\uC7A5\uC744 \uD480\uAE30\uC5D0 \uC88B\uC544\uC694\r\n\uADF8\uB798\uC694,
      \uADF8 \uC791\uC740 \uC21C\uAC04\uB4E4\uC774 \uC815\uB9D0 \uC911\uC694\uD560
      \uC218 \uC788\uC5B4\uC694. \uADF8\uAC83\uB4E4\uC744 \uC54C\uC544\uCC28\uB9AC\uB294
      \uAC83\uC774 \uC804\uBD80\uC785\uB2C8\uB2E4\r\n\uADF8\uB798, \uAC00\uB054\uC740
      \uC77C\uC5D0 \uB108\uBB34 \uBE60\uC838\uC11C \uC2DC\uAC04\uC774 \uBE68\uB9AC
      \uD758\uB7EC\uAC00\uB294 \uACBD\uC6B0\uB3C4 \uC788\uC5B4\r\n\uC548\uB155\uD558\uC138\uC694!
      \uB2F9\uC2E0\uC740 \uC7A5\uB09C\uAC10\uC5D0 \uB300\uD574 \uB9CE\uC740 \uAC83\uC744
      \uC54C\uACE0 \uC788\uB294 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4. \uC5B4\uB5A4 \uC885\uB958\uC758
      \uC7A5\uB09C\uAC10\uC744 \uAC00\uC7A5 \uC88B\uC544\uD558\uB098\uC694?\r\n\uB098\uB294
      \uC7A5\uB09C\uAC10 \uC790\uB3D9\uCC28\uB97C \uAC00\uC7A5 \uC88B\uC544\uD574\uC694!\r\n\uC800\uB294
      \uBD09\uC81C\uC778\uD615\uC744 \uC815\uB9D0 \uC88B\uC544\uD574\uC694. \uB108\uBB34
      \uADC0\uC5FD\uAC70\uB4E0\uC694.\r\n\uC798 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4.
      \uBAA8\uB4E0 \uC7A5\uB09C\uAC10\uC774 \uB098\uC5D0\uAC8C\uB294 \uC7AC\uBBF8\uC788\uC2B5\uB2C8\uB2E4.\r\n\uCD5C\uACE0\uC758
      \uC7A5\uB09C\uAC10\uC740 \uCC3D\uC758\uC801\uC73C\uB85C \uB180 \uC218 \uC788\uAC8C
      \uD574\uC8FC\uB294 \uC7A5\uB09C\uAC10\uC774\uB77C\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4.\r\n\uC7A5\uB09C\uAC10
      \uC790\uB3D9\uCC28\uB294 \uC815\uB9D0 \uC7AC\uBBF8\uC788\uC5B4\uC694! \uBE68\uB9AC
      \uAC00\uB294 \uAC8C \uC2E0\uB098\uB294 \uC77C\uC774\uACA0\uC8E0?\r\n\uBD09\uC81C\uC778\uD615\uC740
      \uC815\uB9D0 \uC0AC\uB791\uC2A4\uB7FD\uC2B5\uB2C8\uB2E4. \uC548\uC544\uC8FC\uACE0
      \uD568\uAED8 \uC7A0\uB4E4 \uC218 \uC788\uC5B4\uC11C \uC88B\uC544\uC694!\r\n\uCC3D\uC758\uC801\uC778
      \uC7A5\uB09C\uAC10\uC740 \uC815\uB9D0 \uC7AC\uBBF8\uC788\uC5B4\uC694! \uC0C1\uC0C1\uB825\uC744
      \uC0AC\uC6A9\uD558\uC5EC \uAC00\uC9C0\uACE0 \uB180 \uC218 \uC788\uB294 \uBAA8\uB4E0
      \uAC83\uC740 \uB9E4\uC6B0 \uD2B9\uBCC4\uD569\uB2C8\uB2E4.\r\n\uC7A5\uB09C\uAC10\uC740
      \uC815\uB9D0 \uC7AC\uBBF8\uC788\uC9C0\uB9CC \uB54C\uB85C\uB294 \uD2B9\uC815
      \uC7A5\uB09C\uAC10\uC774 \uB354 \uD2B9\uBCC4\uD558\uAC8C \uB290\uAEF4\uC9C8
      \uB54C\uB3C4 \uC788\uC2B5\uB2C8\uB2E4. \uC624\uB798\uB41C \uC7A5\uB09C\uAC10\uC774
      \uC788\uB098\uC694?\r\n\uB124, \uC5B4\uB838\uC744 \uB54C \uB85C\uBD07\uC774
      \uC788\uC5C8\uC5B4\uC694. \uB098\uB294 \uADF8\uAC83\uC744 \uC88B\uC544\uD588\uB2E4.\r\n\uB124,
      \uC624\uB798\uB41C \uACF0\uC778\uD615\uC774 \uC788\uC5C8\uC5B4\uC694. \uB098\uB294
      \uD56D\uC0C1 \uADF8\uAC83\uC744 \uAC00\uC9C0\uACE0 \uB2E4\uB154\uC2B5\uB2C8\uB2E4.\r\n\uC544\uB2C8\uC694,
      \uD558\uC9C0\uB9CC \uC800\uB294 \uC624\uB798\uB41C \uC7A5\uB09C\uAC10\uC744
      \uBCF4\uB294 \uAC83\uC744 \uC88B\uC544\uD569\uB2C8\uB2E4.\r\n\uB098\uB294 \uD56D\uC0C1
      \uC0C8 \uC7A5\uB09C\uAC10\uC744 \uB354 \uC88B\uC544\uD574\uC694!\r\n\uC624\uB798\uB41C
      \uC7A5\uB09C\uAC10\uC740 \uC815\uB9D0 \uD2B9\uBCC4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uADF8\uB4E4\uACFC \uD568\uAED8 \uBCF4\uB0B8 \uC2DC\uAC04\uC740 \uC78A\uC744
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uBD09\uC81C\uC778\uD615\uC740 \uC815\uB9D0
      \uD2B9\uBCC4\uD574\uC694. \uADF8\uB4E4\uACFC \uD568\uAED8 \uC790\uBA74 \uC815\uB9D0
      \uD3B8\uC548\uD574\uC694!\r\n\uC624\uB798\uB41C \uC7A5\uB09C\uAC10\uC740 \uC815\uB9D0
      \uB2E4\uB978 \uB290\uB08C\uC744 \uC90D\uB2C8\uB2E4. \uADF8\uB4E4\uC744 \uBCF4\uACE0
      \uC788\uC73C\uBA74 \uB9C8\uCE58 \uC2DC\uAC04\uC744 \uAC70\uC2AC\uB7EC \uC62C\uB77C\uAC04
      \uB4EF\uD55C \uB290\uB08C\uC774 \uB4ED\uB2C8\uB2E4.\r\n\uC0C8\uB85C\uC6B4 \uC7A5\uB09C\uAC10\uB3C4
      \uD765\uBBF8\uB86D\uC2B5\uB2C8\uB2E4. \uC0C8\uB85C\uC6B4 \uAC83\uC744 \uBC1C\uACAC\uD558\uB294
      \uAC83\uC740 \uC5B8\uC81C\uB098 \uC990\uAC81\uC2B5\uB2C8\uB2E4!\r\n\uC774\uBC88
      \uC5EC\uB984\uC5D0 \uBB34\uC5C7\uC744 \uD560 \uACC4\uD68D\uC778\uAC00\uC694?\r\n\uB098\uB294
      \uD734\uAC00\uB97C \uAC08 \uC0DD\uAC01\uC774 \uBCC4\uB85C \uC5C6\uB2E4. \uB098\uB294
      \uB0B4 \uAC00\uAC8C\uC5D0\uC11C \uC77C\uD574\uC57C \uD574\uC694.\r\n\uBA87
      \uAD70\uB370\uB97C \uACE0\uBBFC\uD558\uACE0 \uC788\uC5C8\uB294\uB370 \uC544\uC9C1
      \uAD6C\uCCB4\uC801\uC778 \uACC4\uD68D\uC740 \uC5C6\uC5B4\uC694.\r\n\uC0C8\uB85C\uC6B4
      \uACF3\uC744 \uD0D0\uD5D8\uD558\uACE0 \uC2F6\uC9C0\uB9CC \uC544\uC9C1 \uACB0\uC815\uD558\uC9C0
      \uBABB\uD588\uC2B5\uB2C8\uB2E4.\r\n\uC751, \uB09C \uC815\uB9D0 \uD734\uAC00\uB97C
      \uBCF4\uB0B4\uACE0 \uC2F6\uC5B4. \uD574\uBCC0\uC5D0 \uAC00\uBA74 \uC88B\uC744
      \uAC83 \uAC19\uC544\uC694.\r\n\uC640, \uC880 \uC26C\uC5B4\uC57C\uC9C0! \uD558\uC9C0\uB9CC
      \uC5B4\uCA4C\uBA74 \uBC29\uD559 \uB3D9\uC548 \uC990\uAC70\uC6B4 \uC2DC\uAC04\uC744
      \uBCF4\uB0BC \uC218\uB3C4 \uC788\uACA0\uC8E0?\r\n\uD760, \uD734\uAC00\uB294
      \uC815\uB9D0 \uC7AC\uBBF8\uC788\uC744 \uAC83 \uAC19\uC544\uC694! \uC5B4\uB514\uB85C
      \uAC00\uACE0 \uC2F6\uB098\uC694?\r\n\uC544, \uD574\uBCC0\uC774 \uC815\uB9D0
      \uBA4B\uC838\uC694! \uBAA8\uB798\uB180\uC774\uB294 \uC815\uB9D0 \uC7AC\uBBF8\uC788\uC5B4\uC694!\r\n\uC0C8\uB85C\uC6B4
      \uACF3\uC744 \uD0D0\uD5D8\uD558\uC2DC\uB098\uC694? \uADF8\uAC8C \uC5B4\uB514
      \uC788\uACA0\uC5B4?\r\n\uB098\uB294 \uC0B0\uC9C0\uB97C \uC880 \uBCF4\uACE0
      \uC2F6\uC5B4\uC694. \uC790\uC5F0 \uC18D\uC5D0\uC11C \uC2DC\uAC04\uC744 \uBCF4\uB0B4\uB294
      \uAC83\uB3C4 \uC88B\uC744 \uAC83 \uAC19\uC544\uC694.\r\n\uC0AC\uC2E4\uC740
      \uB3C4\uC2DC \uC678\uACFD \uC5B4\uB518\uAC00\uB85C \uAC08 \uC0DD\uAC01\uC774\uC5D0\uC694.
      \uC5B4\uCA4C\uBA74 \uC870\uC6A9\uD55C \uC791\uC740 \uB9C8\uC744\uC77C\uC9C0\uB3C4
      \uBAA8\uB985\uB2C8\uB2E4.\r\n\uB124, \uBA87\uBA87 \uCE5C\uAD6C\uB4E4\uC774
      \uD574\uBCC0\uC5D0 \uAC00\uC790\uACE0 \uC81C\uC548\uD588\uC9C0\uB9CC \uC800\uB294
      \uBB54\uAC00 \uB2E4\uB978 \uAC83\uC744 \uBCF4\uACE0 \uC2F6\uC5B4\uC694.\r\n\uB098\uC5D0\uAC8C
      \uAC00\uC7A5 \uC911\uC694\uD55C \uAC83\uC740 \uD55C \uBC88\uB3C4 \uAC00\uBCF4\uC9C0
      \uBABB\uD55C \uACF3\uC73C\uB85C \uAC00\uB294 \uAC83\uC774\uB2E4. \uADF8\uB798\uC11C
      \uC544\uC9C1 \uACB0\uC815\uD558\uC9C0 \uBABB\uD588\uC5B4\uC694.\r\n\uC0B0?
      \uC544\uC544\uC544\uC544, \uB098\uBB34\uB3C4 \uB9CE\uACE0 \uC57C\uC0DD\uB3D9\uBB3C\uB3C4
      \uB9CE\uC744 \uAC83 \uAC19\uC544\uC694! \uC815\uB9D0 \uC7AC\uBBF8\uC788\uC744
      \uAC83 \uAC19\uC544\uC694!\r\n\uB9C8\uC744? \uC880 \uC9C0\uB8E8\uD55C \uAC83
      \uAC19\uAD70\uC694. \uD560 \uC77C\uC774 \uBB50 \uC788\uC5B4? \uC9C0\uB8E8\uD558\uC9C0
      \uC54A\uC744 \uAC70\uC5D0\uC694, \uADF8\uB807\uC8E0?\r\n\uD574\uBCC0\uB3C4
      \uC88B\uC9C0\uB9CC, \uC0C8\uB85C\uC6B4 \uACF3\uC744 \uBCF4\uB294 \uAC8C \uD6E8\uC52C
      \uB354 \uC2E0\uB098\uB294 \uAC83 \uAC19\uC544\uC694! \uC0C8\uB85C\uC6B4 \uC0AC\uC2E4\uC744
      \uB9CE\uC774 \uBC1C\uACAC\uD560 \uC218 \uC788\uC5B4\uC694!\r\n\uC544, \uADF8\uAC70
      \uBA4B\uC9C0\uB124\uC694! \uD55C \uBC88\uB3C4 \uAC00\uBCF8 \uC801 \uC5C6\uB294
      \uACF3\uC5D0 \uAC00\uBCF4\uB294 \uAC74 \uC815\uB9D0 \uC2E0\uB098\uB294 \uC77C\uC774\uC5D0\uC694!
      \uAC8C\uB2E4\uAC00, \uC0C8\uB85C\uC6B4 \uAC83\uB3C4 \uB9CE\uC774 \uBC30\uC6B8
      \uC218 \uC788\uC5B4\uC694!\r\n\uC6B0\uB9AC\uB294 \uC774\uBBF8 \uC774\uAC83\uC5D0
      \uB300\uD574 \uC774\uC57C\uAE30\uD588\uC2B5\uB2C8\uB2E4. \uB354 \uB4DC\uB9B4
      \uB9D0\uC500\uC740 \uC5C6\uC9C0\uB9CC \uCC44\uD305\uD574\uC8FC\uC154\uC11C
      \uAC10\uC0AC\uD569\uB2C8\uB2E4!\r\n\uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC778
      \uAC83 \uAC19\uC544\uC694. \uC9C0\uAE08\uC740 \uB354 \uC774\uC0C1 \uACF5\uC720\uD560
      \uAC83\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC9C0\uAE08\uC740 \uD560 \uC218
      \uC788\uB294 \uB9D0\uC740 \uB2E4 \uD588\uC5B4\uC694. \uADF8\uAC74 \uADF8\uB300\uB85C
      \uB194\uB450\uC790, \uC751?\r\n\uC774\uC81C \uC219\uC81C\uD558\uB7EC \uAC00\uC57C
      \uD574\uC694. \uC5B4\uCA4C\uBA74 \uB098\uC911\uC5D0!\r\n\uC624\uB298\uC740
      \uC774 \uC815\uB3C4\uB85C \uC598\uAE30\uD558\uBA74 \uCDA9\uBD84\uD560 \uAC83
      \uAC19\uC2B5\uB2C8\uB2E4. \uB180\uB7EC \uAC00\uC57C \uD574\uC694!\r\n\uB098\uB294
      \uC774\uBBF8 \uB2F9\uC2E0\uC5D0\uAC8C \uBAA8\uB4E0 \uAC83\uC744 \uB9D0\uD588\uC2B5\uB2C8\uB2E4.
      \uC774\uC81C \uB2EC\uB9AC\uACE0 \uB2E4\uB978 \uC77C\uC744 \uD574\uC57C \uD569\uB2C8\uB2E4!\r\n\uB3C4\uB300\uCCB4
      \uC5B4\uB514 \uC788\uB294 \uAC70\uC57C? \uB098\uB294 \uB2F9\uC2E0\uC774 \uD56D\uC0C1
      \uB2A6\uB294 \uAC83\uC5D0 \uC9C0\uCCE4\uC2B5\uB2C8\uB2E4!\r\n\uC544\uC9C1 \uC624\uC804
      8\uC2DC\uBC16\uC5D0 \uC548 \uB410\uB294\uB370\r\n\uB098\uBA38\uC9C0 \uC9C1\uC6D0\uB4E4\uC740
      \uC544\uC9C1 \uC548 \uC654\uB294\uB370, \uC81C\uAC00 \uCCAB \uBC88\uC9F8\uC785\uB2C8\uB2E4,
      \uC0AC\uC7A5\uB2D8.\r\n\uB2F9\uC2E0 \uB9D0\uC774 \uC633\uC2B5\uB2C8\uB2E4,
      \uBCF4\uC2A4. \uAE4A\uC774 \uC0AC\uACFC\uB4DC\uB9BD\uB2C8\uB2E4.\r\n\uADF8\uAC70\uBA74
      \uCDA9\uBD84\uD574\uC694! \uD574\uC57C \uD560 \uC77C\uC774 \uC5BC\uB9C8\uB098
      \uB9CE\uC740\uC9C0 \uC544\uC2DC\uB098\uC694?\r\n\uBAA8\uB974\uACA0\uC5B4\uC694.\r\n\uB098\uB294
      \uC5B4\uB5BB\uAC8C\uB4E0 \uC774 \uBAA8\uB4E0 \uAC83\uC744 \uCC98\uB9AC\uD560
      \uC218 \uC788\uC744 \uAC83\uC774\uB77C\uACE0 \uD655\uC2E0\uD569\uB2C8\uB2E4.\r\n\uC81C\uAC00
      \uB2E4 \uCC98\uB9AC\uD560\uAC8C\uC694, \uBCF4\uC2A4! \uB0B4\uAC00 \uB2E4 \uCC98\uB9AC\uD560
      \uD14C\uB2C8 \uAC71\uC815\uD558\uC9C0 \uB9C8\uC138\uC694!\r\n\uC774\uC81C \uCD9C\uADFC\uD574\uC11C
      \uC11C\uB450\uB974\uC138\uC694! \uC544\uB2C8\uBA74 \uACB0\uAD6D \uD574\uACE0\uB2F9\uD558\uAC8C
      \uB420 \uAC70\uC608\uC694! \uADF8\uB9AC\uACE0 \uD558\uB8E8 \uC77C\uACFC\uAC00
      \uB05D\uB098\uBA74 \uB0B4 \uC0AC\uBB34\uC2E4\uB85C \uC624\uB294 \uAC83\uB3C4
      \uC78A\uC9C0 \uB9C8\uC138\uC694.\r\n*\uD55C\uC228* \uC5EC\uAE30\uC11C \uC2E4\uC81C\uB85C
      \uC77C\uC744 \uC81C\uB300\uB85C \uD558\uACE0 \uC788\uB294 \uC0AC\uB78C\uC740
      \uB098\uBFD0\uC774\uC5D0\uC694.\r\n\uCD5C\uC120\uC744 \uB2E4\uD558\uACA0\uC2B5\uB2C8\uB2E4.\r\n\uC800
      \uC9C0\uAE08 \uBC14\uB85C \uC77C\uD558\uB7EC \uAC11\uB2C8\uB2E4, \uBCF4\uC2A4!
      \uB2F9\uC2E0\uC774 \uB0A0 \uD574\uACE0\uD558\uAC8C \uB194\uB450\uC9C0 \uC54A\uC744
      \uD14C\uB2C8 \uAC71\uC815\uD558\uC9C0 \uB9C8\uC138\uC694!\r\n\uB4DC\uB514\uC5B4
      \uB098\uD0C0\uB098\uC168\uAD70\uC694... \uC81C \uC0AC\uBB34\uC2E4\uAE4C\uC9C0
      \uC624\uC2DC\uB290\uB77C \uC774\uB807\uAC8C \uC624\uB798 \uAC78\uB9AC\uC168\uC8E0?\r\n\uC751,
      \uBA3C \uAE38\uC774\uC5C8\uC5B4.\r\n\uBC29\uAE08 \uD560 \uC77C\uC744 \uB9C8\uCE58\uACE0
      \uC5EC\uAE30\uB85C \uBC14\uB85C \uC654\uC2B5\uB2C8\uB2E4, \uBCF4\uC2A4.\r\n\uC77C\uC744
      \uB9C8\uCE58\uC790\uB9C8\uC790 \uB2EC\uB824\uAC14\uC2B5\uB2C8\uB2E4, \uBCF4\uC2A4!
      \uBAA8\uB4E0 \uC77C\uC774 \uAD1C\uCC2E\uAE30\uB97C \uBC14\uB78D\uB2C8\uB2E4!\r\n\uBC29\uAE08
      \uB2F9\uC2E0 \uB3D9\uB8CC \uC911 \uD55C \uBA85\uACFC \uC774\uC57C\uAE30\uB97C
      \uB098\uB204\uACE0 \uC788\uC5C8\uB294\uB370, \uADF8\uB4E4\uC774 \uB098\uC5D0\uAC8C
      \uD55C \uB9D0\uC744 \uD588\uC2B5\uB2C8\uB2E4...\r\n\uC640... \uB3D9\uB8CC\uB4E4\uC774
      \uB300\uD654\uD558\uB294 \uBC95\uC744 \uC544\uB294\uC9C0 \uBAB0\uB790\uC5B4\uC694.\r\n...\r\n\uBB34\uC2A8
      \uC77C\uC774\uC5D0\uC694, \uBCF4\uC2A4? \uC544\uBB34 \uBB38\uC81C \uC5C6\uAE38
      \uBC14\uB78D\uB2C8\uB2E4...\r\n\uC6D4\uBCC4 \uC7AC\uC815 \uAC80\uD1A0 \uC911\uC5D0
      \uADC0\uD558\uAC00 \uB2F4\uB2F9\uD558\uACE0 \uC788\uB294 \uB4F1\uB85D\uBD80\uC5D0\uC11C
      \uD604\uAE08\uC774 \uBD80\uC871\uD558\uB2E4\uB294 \uC0AC\uC2E4\uC744 \uBC1C\uACAC\uD588\uC2B5\uB2C8\uB2E4...
      \uB2F9\uC2E0\uC740 \uB3C4\uB451\uC785\uB2C8\uB2E4! \uB2F9\uC2E0\uC740 \uB0B4
      \uB3C8\uC744 \uD6D4\uCCE4\uC5B4\uC694!!!\r\n\uC774 \uBA4D\uCCAD\uC774\uB4E4\uC774
      \uB098\uB97C \uBE44\uBC29\uD558\uACE0 \uC788\uC5B4\uC694! \uB098\uB294 \uADF8\uB7F0
      \uC9D3\uC744\uD558\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4!\r\n\uC774\uAC83\uC740
      \uB9D0\uB3C4 \uC548\uB418\uB294 \uC18C\uB9AC\uC785\uB2C8\uB2E4. \uB098\uB294
      \uB3C8\uC744 \uD6D4\uCE58\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4!\r\n\uC120\uC0DD\uB2D8,
      \uC800\uB294 \uADF8\uB7F0 \uC9D3\uC744 \uD55C \uC801\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uC6A9\uC11C\uD574\uC8FC\uC138\uC694, \uAC04\uC808\uD788 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4!\r\n\uC5EC\uAE30\uC11C
      \uB098\uAC00\uC11C \uB2E4\uC2DC\uB294 \uC5BC\uAD74 \uBCF4\uC774\uC9C0 \uB9C8\uC138\uC694,
      \uC774 \uB3C4\uB451\uB188\uC544! \uB108\uD76C \uAC00\uC871 \uBAA8\uB450\uAC00
      \uC774 \uBE44\uC6A9\uC744 \uC9C0\uBD88\uD558\uAC8C \uD574\uC904\uAC8C!\r\n\uD6C4\uD68C\uD558\uAC8C
      \uB420 \uAC70\uC57C, \uADF8\uB0E5 \uAE30\uB2E4\uB824! \uC774 \uC4F0\uB808\uAE30\uC57C!\r\n\uC774\uAC74
      \uBD88\uACF5\uD3C9\uD574\uC694! \uC774\uB7F0 \uBE44\uB09C\uC744 \uADFC\uAC70\uB85C
      \uB098\uB97C \uD574\uACE0\uD560 \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4!\r\n\uB098\uD55C\uD14C\uB294
      \uC774 \uC77C\uC774 \uAF2D \uD544\uC694\uD574\uC694. \uC800\uB97C \uD574\uACE0\uD558\uC9C0
      \uB9C8\uC138\uC694. \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4. \uADF8\uB807\uAC8C
      \uD558\uBA74 \uB09C \uACB0\uAD6D \uB178\uC219\uC790\uAC00 \uB420 \uAC70\uC608\uC694.\r\n*\uC544\uC544\uC544\uC544\uC544*
      \uC88B\uC740 \uC544\uCE68\uC774\uC5D0\uC694. \uC5B4\uC82F\uBC24\uC5D0 \uC7A0\uC744
      \uBABB \uC7A4\uC5B4\uC694.\r\n\uCE5C\uAD6C\uC57C, \uC9C0\uAE08\uC774 \uBA87
      \uC2DC\uC778\uC9C0 \uC54C\uC544? \uBC29\uAE08 \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uB124\uC694!
      \uC0AC\uC7A5\uB2D8\uC774 \uBC8C\uC368 \uB0A0 \uC539\uC5B4\uBA39\uC5C8\uC5B4!
      \uC5B4\uC11C, \uC6B0\uB9AC\uB294 \uD560 \uC77C\uC774 \uB9CE\uC544\uC694!\r\n\uC544\uCE68.
      \uC774 \uC791\uC5C5\uC744 \uB3C4\uC640\uC8FC\uC2E4 \uC218 \uC788\uB098\uC694?\r\n\uD658\uC601!
      \uC7A0\uC744 \uCDA9\uBD84\uD788 \uBABB \uC790\uBA74 \uAC00\uC11C \uC26C\uC138\uC694.
      \uB0B4\uAC00 \uB2E4 \uCC98\uB9AC\uD560\uAC8C!\r\n\uB2F9\uC2E0\uC740 \uCE5C\uAD6C\uC758
      \uC791\uC5C5\uC744 \uCC98\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAC04\uC2DD
      \uBA39\uC73C\uB7EC \uAC08 \uAC74\uB370, \uCEE4\uD53C\uB77C\uB3C4 \uB9C8\uC2E4\uB798?\r\n\uC9C8\uC2DD\uD574\uB77C.\r\n\uC544\uB2C8\uC694.\r\n\uC544\uB2C8\uC694,
      \uD558\uC9C0\uB9CC \uC81C \uC77C\uC774 \uB05D\uB098\uBA74 \uAE30\uAEBC\uC774
      \uAC00\uC838\uB2E4 \uB4DC\uB9AC\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4.\r\n\uC54C\uC558\uC5B4,
      \uB098\uC911\uC5D0 \uC7A1\uC544.\r\n...\r\n\uC548\uB155.\r\n\uD734\uC2DD\uC744
      \uCDE8\uD558\uC138\uC694!\r\n\uC774\uBBF8 \uC54C\uACE0 \uACC4\uC2DC\uACA0\uC9C0\uB9CC,
      \uB2E4\uC2DC \uD55C \uBC88 \uC0C1\uAE30\uC2DC\uCF1C \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.
      \uC5B4\uC81C\uAC00 \uC784\uB300\uB8CC\uB97C \uB0BC \uC218 \uC788\uB294 \uB9C8\uC9C0\uB9C9
      \uB0A0\uC774\uC5C8\uC2B5\uB2C8\uB2E4!\r\n\uB124, \uC54C\uC544\uC694.\r\n...\r\n\uB124,
      \uC54C\uC544\uC694.\r\n\uADF8\uB798\uC11C?\r\n\uB098\uB294 \uB3C8\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uBC29\uAE08
      \uD574\uACE0\uB2F9\uD588\uC5B4\uC694. \uB3C8\uC774 \uC5C6\uC5B4\uC694.\r\n\uBC29\uAE08
      \uD574\uACE0\uB410\uB294\uB370, \uC2DC\uAC04\uB9CC \uC8FC\uC2DC\uBA74 \uC81C\uAC00
      \uC0C8 \uC9C1\uC7A5\uC744 \uAD6C\uD574\uC11C \uADF8 \uB3C8\uC73C\uB85C \uAC1A\uC544\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.\r\n*\uD55C\uC228*
      \uACB0\uC81C\uD560 \uC2DC\uAC04\uC744 \uCDA9\uBD84\uD788 \uC92C\uB294\uB370...
      \uBBF8\uC548\uD558\uC9C0\uB9CC \uB354 \uC774\uC0C1 \uB0B4 \uC9D1\uC5D0 \uBA38\uBB3C\uAC8C
      \uD560 \uC218 \uC5C6\uC5B4.\r\n\uAD1C\uCC2E\uC740!\r\n...\r\n\uC54C\uC558\uC5B4,
      \uACE0\uB9C8\uC6CC...\r\n\uC778\uD130\uB137\uC744 \uB04A\uACE0 \uC18D\uB3C4\uB97C
      \uB2A6\uCD94\uC790. ($50)\r\n\uC7A0\uC2DC \uB3D9\uC548 \uAD8C\uB825\uC744 \uC8FD\uC774\uACE0
      \uC77C\uC744 \uC5C9\uB9DD\uC73C\uB85C \uB9CC\uB4E4 \uC2DC\uAC04\uC785\uB2C8\uB2E4.
      ($25)\r\n\uC4F0\uB808\uAE30 \uC218\uAC70\uCC28\uB97C \uBCF4\uB0B4\uC11C \uC545\uCDE8\uB97C
      \uD48D\uAE30\uAC8C \uD558\uC138\uC694. ($100)\r\n\uC544, \uD560 \uC77C\uC774
      \uC788\uC5B4\uC11C \uB098\uC911\uC5D0 \uB9CC\uB098\uC694!\r\n\uC9C0\uAE08\uC740
      \uCC44\uD305\uD560 \uC2DC\uAC04\uC774 \uC5C6\uC2B5\uB2C8\uB2E4. \uB098\uC911\uC5D0
      \uBD59\uACA0\uC2B5\uB2C8\uB2E4!\r\n\uC5B4\uB518\uAC00\uC5D0 \uC788\uC744 \uD14C\uB2C8
      \uC870\uC2EC\uD558\uC138\uC694!\r\n\uD734\uC2DD\uC774 \uD544\uC694\uD574\uC694.
      \uB098\uC911\uC5D0 \uC598\uAE30\uD558\uACA0\uC2B5\uB2C8\uB2E4.\r\n\uCDA9\uBD84\uD788
      \uC598\uAE30\uD588\uC73C\uB2C8 \uAC00\uBD10\uC57C\uACA0\uC5B4\uC694.\r\n\uB098
      \uB098\uAC00\uC57C \uD574, \uB098\uC911\uC5D0 \uBCF4\uC790!\r\n\uC6B0\uB9AC\uAC00
      \uB9E4\uC77C \uADF8\uB807\uAC8C \uD55C\uB2E4\uBA74, \uADF8\uB4E4\uC740 \uC54C\uC544\uCC28\uB9B4
      \uAC83\uC785\uB2C8\uB2E4. \uC774\uD2C0\uB9C8\uB2E4 \uB354 \uC548\uC804\uD569\uB2C8\uB2E4.\r\n\uC774\uB7EC\uD55C
      \uBC29\uD574 \uC804\uD30C \uC7A5\uCE58\uB294 \uAD6C\uD558\uAE30 \uC5B4\uB835\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC2DC \uC0AC\uC6A9\uD558\uB824\uBA74 \uD558\uB8E8\uB97C \uAE30\uB2E4\uB824\uC57C
      \uD569\uB2C8\uB2E4.\r\n\uD558\uB8E8\uC5D0 \uD55C \uAC1C, \uADF8 \uC774\uC0C1\uC740
      \uD754\uC801\uC744 \uB0A8\uAE41\uB2C8\uB2E4.\r\n\uB0AE\uC5D0 \uD558\uB294 \uAC83\uC774
      \uC88B\uC2B5\uB2C8\uB2E4. \uBC24\uC5D0\uB294 \uB108\uBB34 \uC870\uC6A9\uD574\uC838\uC11C
      \uBAA8\uB450\uAC00 \uB2F9\uC2E0\uC744 \uC54C\uC544\uBCFC \uAC83\uC785\uB2C8\uB2E4.\r\n\uD655\uC778\r\n\uCDE8\uC18C\r\n\uC800\uC7A5
      \uC2E4\uD328\r\n\uD30C\uC77C\uC774 \uB2E4\uB978 \uACF3\uC5D0\uC11C \uC5F4\uB824
      \uC788\uAC70\uB098 \uC800\uC7A5 \uACF5\uAC04\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4.\r\n\uD30C\uC77C\uC744
      \uC800\uC7A5\uD560 \uAD8C\uD55C\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC774 \uC800\uC7A5
      \uC2AC\uB86F \uC9C0\uC6B0\uAE30\r\n\uD574\uB2F9 \uC800\uC7A5 \uC2AC\uB86F \uB0B4\uC758
      \uBAA8\uB4E0 \uC9C4\uD589 \uC0AC\uD56D\uC774 \uC601\uAD6C\uC801\uC73C\uB85C
      \uC0AD\uC81C\uB429\uB2C8\uB2E4.\r\n\uD29C\uD1A0\uB9AC\uC5BC\r\n\uD1A0\uC774\uC0F5
      \uC2DC\uBBAC\uB808\uC774\uD130 \uD29C\uD1A0\uB9AC\uC5BC\uC5D0 \uC624\uC2E0
      \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4\r\n\uD658\uC601\uD569\uB2C8\uB2E4\r\n\uD1A0\uC774\uC0F5
      \uC2DC\uBBAC\uB808\uC774\uD130\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4\r\n\uAC00\uACA9
      \uBCC0\uACBD\r\n\uC2B9\uC778\r\n\uBC30\uCE58\r\n\uACE0\uAC1D\uC73C\uB85C\uBD80\uD130
      \uACB0\uC81C \uBC1B\uAE30\r\n\uC7A5\uB09C\uAC10\uC758 \uAC00\uACA9 \uC124\uC815\uD558\uAE30\r\n\uC81C\uD488\uC744
      \uC2A4\uCE94\uD558\uB824\uBA74 \uD074\uB9AD\uD558\uC138\uC694\r\n\uC7A5\uB09C\uAC10\uC744
      \uC120\uBC18\uC5D0 \uBC30\uCE58\uD558\uAE30\r\n\uBC16\uC5D0\uC11C \uC8FC\uBB38
      \uC218\uB839\uD558\uAE30\r\n\uCEF4\uD4E8\uD130\uB97C \uC0AC\uC6A9\uD558\uC5EC
      \uC7A5\uB09C\uAC10 \uC8FC\uBB38\uD558\uAE30\r\n\uC0C1\uC810 \uC5F4\uAE30\r\n\uBB50\uC57C
      \uC774\uAC74?\r\n\uB808\uBCA8 \uC5C5!\r\n\uD310\uB9E4?\r\n{0}\uC744(\uB97C)
      \uBC1B\uC744 \uAC83\uC785\uB2C8\uB2E4\r\n\uD310\uB9E4\uD558\uC9C0 \uC54A\uAE30\r\n\uD310\uB9E4\uD558\uAE30\r\n\uACBD\uACE0:
      \uC870\uC2EC\uD574\uC11C \uB2E4\uB8E8\uC138\uC694!\r\n\uC774 \uAC15\uB825\uD55C
      \uBB20\uB2C8\uB974\uB294 \uC5BC\uB9AC \uC561\uC138\uC2A4\uC5D0\uC11C \uBC84\uADF8\uB97C
      \uBC15\uC0B4\uB0B4\uB294 \uB370 \uB3C4\uC6C0\uC744 \uC904 \uAC83\uC785\uB2C8\uB2E4.
      \uD558\uC9C0\uB9CC \uB108\uBB34 \uB9CE\uC740 \uD798\uC740 \uBC84\uADF8 \uD3ED\uD48D\uC744
      \uBD88\uB7EC\uC62C \uC218 \uC788\uC73C\uB2C8 \uC870\uC2EC\uD558\uC138\uC694!\r\n\uBE44\uC6A9\r\n\uAC00\uACA9\r\n\uC2DC\uC7A5
      \uAC00\uACA9\r\n\uC774\uC775\r\n\uBC18\uC62C\uB9BC\uD558\uB2E4\r\n\uB108\uBB34
      \uBE44\uC2FC\r\n\uD569\uB9AC\uC801\uC778\r\n\uAC10\uB2F9\uD560 \uC218 \uC788\uB294\r\n\uC2FC\r\n\"\uC0AC\uB791\uD558\uB294
      \uC190\uC790\uC5D0\uAC8C,\r\n\r\n\uC5B4\uC82F\uBC24, \uC5EC\uC804\uD788 \uB3C4\uC2DC\uC5D0\uC11C
      \uC0B4\uACE0 \uC788\uB294 \uC624\uB79C \uCE5C\uAD6C\uC5D0\uAC8C \uB108\uAC00
      ToyVerse\uC5D0\uC11C \uD574\uACE0\uB418\uACE0 \uBCA4\uCE58\uC5D0\uC11C \uD558\uB8FB\uBC24\uC744
      \uBCF4\uB0C8\uB2E4\uB294 \uC18C\uC2DD\uC744 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC774 \uC18C\uC2DD\uC740 \uB098\uB97C \uC2AC\uD504\uAC8C \uD588\uC9C0\uB9CC,
      \uC0C8\uB85C\uC6B4 \uC2DC\uC791\uC758 \uAE30\uD68C\uB85C \uBCFC \uC218\uB3C4
      \uC788\uB2E4\uACE0 \uC0DD\uAC01\uD569\uB2C8\uB2E4. \uB108\uB294 \uC80A\uACE0
      \uAC15\uD558\uBA70 \uB2A5\uB825\uC774 \uC788\uC2B5\uB2C8\uB2E4\u2014\uC774
      \uB098\uC774\uAC00 \uB41C \uB098\uC5D0\uAC8C\uB294 \uC5C6\uB294 \uC790\uC9C8\uB4E4\uC785\uB2C8\uB2E4.\r\n\r\n\uB0B4
      \uC0B6\uC740 \uB9CE\uC740 \uB3C4\uC804\uC73C\uB85C \uAC00\uB4DD\uD588\uC73C\uBA70,
      \uB108\uC5D0\uAC8C \uB0B4 \uC774\uC57C\uAE30\uB97C \uB098\uB204\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4.\r\n\r\n\uB9CE\uC740
      \uD574 \uC804, \uB098\uB294 \uC9C0\uAE08\uC758 \uC2DC\uB0B4 \uC911\uC2EC\uC9C0\uC5D0\uC11C
      \uC791\uC740 \uC7A5\uB09C\uAC10 \uAC00\uAC8C\uB97C \uC6B4\uC601\uD588\uC2B5\uB2C8\uB2E4.
      \uB098\uB294 \uB098\uBB34\uB85C \uB9CC\uB4E0 \uC7A5\uB09C\uAC10\uC744 \uB9CC\uB4E4\uBA70
      \uC0B4\uC544\uAC00\uACE0 \uC544\uC774\uB4E4\uC5D0\uAC8C \uAE30\uC068\uC744
      \uC8FC\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8\uAC74 \uACB8\uC190\uD55C \uC0B6\uC774\uC5C8\uC9C0\uB9CC
      \uC758\uBBF8 \uC788\uB294 \uC0B6\uC774\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098
      \uBAA8\uB4E0 \uAC83\uC740 ToyVerse\uAC00 \uB0B4 \uAC00\uAC8C \uBC14\uB85C \uAC74\uB108\uD3B8\uC5D0
      \uC5F4\uB9AC\uBA74\uC11C \uBCC0\uD588\uC2B5\uB2C8\uB2E4. \uCC98\uC74C\uC5D0\uB294
      \uC6B0\uB9AC\uAC00 \uACF5\uC874\uD560 \uC218 \uC788\uC744 \uAC83\uC774\uB77C
      \uC0DD\uAC01\uD588\uACE0, \uC544\uB9C8\uB3C4 \uAC74\uAC15\uD55C \uACBD\uC7C1\uC744
      \uD1B5\uD574 \uD568\uAED8 \uC131\uC7A5\uD560 \uC218 \uC788\uC744 \uAC70\uB77C\uACE0
      \uBBFF\uC5C8\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uADF8 \uB2F9\uC2DC\uC758
      \uC8FC\uC778\uC740 \uC774\uC0C1\uD55C \uB300\uBA38\uB9AC \uB0A8\uC790\uC600\uACE0,
      \uBB34\uC790\uBE44\uD558\uACE0 \uD0D0\uC695\uC5D0 \uAC00\uB4DD \uCC28 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uADF8\uB294 \uBAA8\uB4E0 \uBC29\uBC95\uC744 \uB3D9\uC6D0\uD574 \uB0B4 \uACE0\uAC1D\uC744
      \uBE7C\uC557\uACE0 \uB0B4 \uC0AC\uC5C5\uC744 \uBC29\uD574\uD588\uC2B5\uB2C8\uB2E4.
      \uC544\uBB34\uB9AC \uC5F4\uC2EC\uD788 \uC77C\uD574\uB3C4 \uB098\uB294 \uB530\uB77C\uC7A1\uC744
      \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4. \uACB0\uAD6D, \uB098\uB294 \uAC00\uAC8C\uB97C
      \uB2EB\uACE0 \uB0B4\uAC00 \uB9CC\uB4E4\uC5B4\uC628 \uAFC8\uC744 \uD3EC\uAE30\uD574\uC57C
      \uD588\uC2B5\uB2C8\uB2E4.\r\n\r\n\uB108\uAC00 ToyVerse\uC5D0\uC11C \uC77C\uD55C\uB2E4\uB294
      \uC18C\uC2DD\uC744 \uB4E4\uC5C8\uC744 \uB54C, \uB098\uB294 \uADF8 \uC544\uD508
      \uAE30\uC5B5\uB4E4\uC744 \uB5A8\uCCD0\uB0B4\uACE0 \uB108\uB97C \uAE30\uBED0\uD558\uB824\uACE0
      \uD588\uC2B5\uB2C8\uB2E4. \uC0C8\uB85C\uC6B4 \uACBD\uC601\uC9C4\uC774 \uB354
      \uB098\uC744 \uAC83\uC774\uB77C\uACE0 \uAE30\uB300\uD588\uC8E0. \uD558\uC9C0\uB9CC
      \uB108\uC5D0\uAC8C \uC77C\uC5B4\uB09C \uC77C\uC744 \uB4E3\uACE0 \uBCF4\uB2C8,
      \uB0B4\uAC00 \uD2C0\uB838\uC74C\uC744 \uC54C\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC774\uC81C,
      \uB098\uB294 \uB108\uC5D0\uAC8C \uB450 \uBC88\uC9F8 \uAE30\uD68C\uB97C \uC8FC\uACE0
      \uC2F6\uC2B5\uB2C8\uB2E4. \uC774 \uD3B8\uC9C0\uC5D0\uB294 \uB0B4 \uC61B \uAC00\uAC8C\uC758
      \uC5F4\uC1E0\uAC00 \uD568\uAED8 \uC788\uC2B5\uB2C8\uB2E4. \uADF8 \uAC00\uAC8C\uB294
      \uC624\uB7AB\uB3D9\uC548 \uC0AC\uC6A9\uB418\uC9C0 \uC54A\uC558\uC73C\uBBC0\uB85C
      \uC0C1\uD0DC\uAC00 \uC5B4\uB5A4\uC9C0 \uB9D0\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uADF8\uB7FC\uC5D0\uB3C4 \uB098\uB294 \uB108\uB97C \uBBFF\uC2B5\uB2C8\uB2E4.
      \uB108\uB294 \uC5F4\uC815\uACFC \uC80A\uC74C, \uC7AC\uB2A5\uC774 \uC788\uC73C\uBA70
      \uADF8 \uAC00\uAC8C\uB97C \uB418\uC0B4\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC55E\uC73C\uB85C \uB2E4\uAC00\uC62C \uB3C4\uC804\uB4E4\uC744 \uB450\uB824\uC6CC\uD558\uC9C0
      \uB9C8\uC138\uC694. \uC7A5\uB09C\uAC10 \uAC00\uAC8C\uB97C \uC6B4\uC601\uD558\uB294
      \uAC83\uC740 \uC6B0\uB9AC \uAC00\uC871\uC758 \uD608\uD1B5\uC774\uBBC0\uB85C,
      \uB098\uB294 \uB124\uAC00 \uADF8\uAC83\uC744 \uD6CC\uB96D\uD55C \uAC83\uC73C\uB85C
      \uB9CC\uB4E4 \uC218 \uC788\uB2E4\uACE0 \uD655\uC2E0\uD569\uB2C8\uB2E4. \uC544\uB9C8\uB3C4
      \uB0B4 \uC2DC\uB300\uBCF4\uB2E4 \uB354 \uB098\uC740 \uAC83\uC73C\uB85C \uB9CC\uB4E4
      \uC218 \uC788\uC744 \uAC83\uC785\uB2C8\uB2E4. \uC774 \uAE30\uD68C\uB97C \uC7A1\uC544
      \uB108\uB9CC\uC758 \uC774\uC57C\uAE30\uB97C \uC4F0\uACE0, \uC6B0\uB9AC\uC758
      \uC720\uC0B0\uC744 \uC774\uC5B4\uAC00\uBA70 ToyVerse\uC5D0\uAC8C \uC9C4\uC815\uD55C
      \uC7A5\uC778\uC815\uC2E0\uACFC \uD5CC\uC2E0\uC774 \uBB34\uC5C7\uC778\uC9C0
      \uBCF4\uC5EC\uC8FC\uC138\uC694. \uB108\uB294 \uBC18\uB4DC\uC2DC \uC131\uACF5\uD560
      \uAC83\uC785\uB2C8\uB2E4.\r\n\"\r\n\uACE0\uB9C8\uC6CC\uC694, \uD560\uC544\uBC84\uC9C0.
      \uC81C\uAC00 \uD560\uAC8C\uC694!\r\n\uC0AC\uC6A9\uC790 \uC815\uC758\r\n\uC0C9\uC0C1
      1\r\n\uC0C9\uC0C1 2\r\n\uC801\uC6A9\r\n\uBAA8\uB450 \uC801\uC6A9\r\n\uC77C\uC77C
      \uBCF4\uACE0\uC11C\r\n\uD558\uB8E8\r\n\uACE0\uAC1D\r\n\uB9CC\uC871\uD55C \uACE0\uAC1D\r\n\uCC3E\uC744
      \uC218 \uC5C6\uB294 \uC81C\uD488\r\n\uBE44\uC2F8\uB2E4\uACE0 \uC0DD\uAC01\uB41C
      \uC81C\uD488\r\n\uCD1D \uACE0\uAC1D\r\n\uB9E4\uC7A5 \uC810\uC218\r\n\uC218\uC775\r\n\uACF5\uAE09
      \uBE44\uC6A9\r\n\uC5C5\uADF8\uB808\uC774\uB4DC \uBE44\uC6A9\r\n\uCD1D \uC774\uC775\r\n\uC794\uC561\r\n\uAC00\uAC8C\r\n\uACBD\uC81C\r\n\uC774\uC775\r\n\uC0C8\uB85C\uC6B4
      \uB0A0 \uC2DC\uC791\r\n\uACC4\uC0B0\uC6D0 \uAE09\uC5EC\r\n\uC7AC\uACE0 \uB2F4\uB2F9\uC790
      \uAE09\uC5EC\r\n\uD29C\uD1A0\uB9AC\uC5BC \uAC74\uB108\uB6F0\uAE30\r\n\uC544\uC9C1
      \uD558\uB8E8\uAC00 \uB05D\uB098\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4\r\n\uAD6C\uB9E4
      \uC644\uB8CC\r\n\uAC70\uC2A4\uB984\uB3C8\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4\r\n\uAC70\uB798
      \uC2E4\uD328\r\n\uC0C1\uC790\uC5D0 \uC81C\uD488\uC774 \uC5C6\uC2B5\uB2C8\uB2E4\r\n\uC120\uBC18\uC774
      \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4\r\n\uC0C1\uC790\uAC00 \uAC00\uB4DD \uCC3C\uC2B5\uB2C8\uB2E4\r\n\uC120\uBC18\uC774
      \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4\r\n\uC120\uBC18\uC5D0 \uC788\uB294 \uC81C\uD488\uC740
      \uC0C1\uC790\uC5D0 \uB123\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4\r\n\uC120\uBC18\uC758
      \uC81C\uD488 \uC720\uD615\uC774 \uC0C1\uC790\uC758 \uC81C\uD488 \uC720\uD615\uACFC
      \uC77C\uCE58\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4\r\n\uC0C1\uC790\uC5D0 \uC801\uD569\uD558\uC9C0
      \uC54A\uC740 \uC81C\uD488 \uC720\uD615\uC785\uB2C8\uB2E4\r\n\uC81C\uD488 \uC720\uD615\uC774
      \uC0C1\uC790\uC758 \uC81C\uD488 \uC720\uD615\uACFC \uC77C\uCE58\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4\r\n\uC774 \uC81C\uD488\uC740 \uC5EC\uAE30\uC5D0 \uB193\uC744
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4\r\n\uC120\uBC18\uC758 \uC81C\uD488 \uC720\uD615\uC774
      \uC81C\uD488 \uC720\uD615\uACFC \uC77C\uCE58\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4\r\n\uC774
      \uC120\uBC18\uC5D0\uB294 \uC774 \uC720\uD615\uC758 \uC81C\uD488\uC744 \uB193\uC744
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4\r\n\uCC3D\uACE0 \uC139\uC158\uC744 \uC5F4\uB824\uBA74
      \uC0C1\uC810 \uB808\uBCA8\uC744 2\uB85C \uC62C\uB824\uC57C \uD569\uB2C8\uB2E4\r\n\uAD11\uACE0
      \uC644\uB8CC\r\n\uAD11\uACE0 \uC2E4\uD328\r\n\uC794\uC561\uC774 \uBD80\uC871\uD569\uB2C8\uB2E4\r\n\uACB0\uC81C
      \uC644\uB8CC\r\n\uADC0\uD558\uC758 \uC2E0\uC6A9\uC774 \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4\r\n\uC77C\uC77C
      \uB300\uCD9C \uC0C1\uD658\uC774 \uC774\uB8E8\uC5B4\uC9C0\uC9C0 \uC54A\uC544
      \uC774\uC790\uAC00 \uBD80\uACFC\uB418\uC5C8\uC2B5\uB2C8\uB2E4\r\n\uB300\uCD9C
      \uC0C1\uD658\uC561\uC774 \uC794\uC561\uC744 \uCD08\uACFC\uD588\uC2B5\uB2C8\uB2E4.
      \uC624\uB298 \uC9C0\uBD88\uD558\uC9C0 \uC54A\uC73C\uBA74 \uD30C\uC0B0\uD569\uB2C8\uB2E4\r\n\uAC00\uAC8C
      \uC548\uC5D0 \uC544\uC9C1 \uACE0\uAC1D\uC774 \uC788\uC2B5\uB2C8\uB2E4\r\n\uD558\uB8E8\uAC00
      \uB05D\uB0AC\uC2B5\uB2C8\uB2E4. \uC7A0\uC790\uB9AC\uC5D0 \uB4DC\uC138\uC694\r\n\uCE74\uB4DC
      \uC624\uB958!\r\n\uC798\uBABB\uB41C \uAE08\uC561!\r\n{0} \uC218\uC815 \uC644\uB8CC!\r\n\uD558\uB8E8\uAC00
      \uB05D\uB0AC\uC2B5\uB2C8\uB2E4. \uC7A0\uC790\uB9AC\uC5D0 \uB4DC\uC138\uC694\r\n\uACE0\uAC1D\uC774
      \uACC4\uC0B0\uB300\uC5D0\uC11C \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4\r\n\uC774
      \uC81C\uD488\uC740 \uC120\uBC18\uC5D0 \uB9DE\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4!\r\n\uC8FC\uBB38
      \uC644\uB8CC\r\n\uACE0\uAC1D\uC774 \uADC0\uD558\uB97C \uD3C9\uAC00\uD588\uC2B5\uB2C8\uB2E4\r\n\uC8FC\uBB38
      \uC0C1\uC790\uAC00 \uC0DD\uC131\uB418\uC5C8\uC2B5\uB2C8\uB2E4\r\n{0}\uC758
      \uC2DC\uC7A5 \uAC00\uACA9\uC774 \uC62C\uB790\uC2B5\uB2C8\uB2E4!\r\n\uC7A5\uBC14\uAD6C\uB2C8\uC5D0
      \uCD94\uAC00\uB418\uC5C8\uC2B5\uB2C8\uB2E4\r\n\uD398\uC778\uD2B8\uD1B5\uC774
      \uBE44\uC5C8\uC2B5\uB2C8\uB2E4\r\n\uC77C\uCE58\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4\r\n\uBD93\uC744
      \uC591\uB3D9\uC774\uC5D0 \uB2F4\uADF8\uC2ED\uC2DC\uC624\r\n\uD30C\uAD34\uB428\r\n\uACC4\uC0B0\uB300
      \uBC14\uC068\r\n\uC798\uBABB\uB41C \uC0C1\uD488\uC744 \uBC1B\uC558\uACE0, \uBC1B\uC740
      \uAC83\uB3C4 \uC190\uC0C1\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC\uB294
      \uC5EC\uAE30\uC11C \uC8FC\uBB38\uD558\uC9C0 \uC54A\uC744 \uAC83\uC785\uB2C8\uB2E4.\r\n\uC8FC\uBB38\uC774
      \uBD88\uC644\uC804\uD588\uACE0, \uBC1B\uC740 \uC81C\uD488\uC740 \uD488\uC9C8\uC774
      \uC88B\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uB9E4\uC6B0 \uC2E4\uB9DD\uD588\uC2B5\uB2C8\uB2E4.\r\n\uC8FC\uBB38\uC758
      \uC808\uBC18\uC774 \uB204\uB77D\uB418\uC5C8\uACE0, \uBC1B\uC740 \uAC83\uB4E4\uB3C4
      \uC81C\uAC00 \uC694\uCCAD\uD55C \uAC83\uC774 \uC544\uB2C8\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC6A9\uB0A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4!\r\n\uC81C\uAC00 \uC9C0\uBD88\uD55C
      \uAC83\uC744 \uBC1B\uC9C0 \uBABB\uD588\uACE0, \uACE0\uAC1D \uC11C\uBE44\uC2A4\uB3C4
      \uD615\uD3B8\uC5C6\uC5C8\uC2B5\uB2C8\uB2E4. \uD658\uBD88\uC744 \uC6D0\uD569\uB2C8\uB2E4!\r\n\uC124\uBA85\uACFC
      \uB2E4\uB974\uAC8C \uB3C4\uCC29\uD588\uACE0, \uC804\uCCB4\uC801\uC778 \uACBD\uD5D8\uC774
      \uB2F5\uB2F5\uD588\uC2B5\uB2C8\uB2E4. \uB354 \uB098\uC740 \uC11C\uBE44\uC2A4\uB97C
      \uAE30\uB300\uD569\uB2C8\uB2E4!\r\n\uBC30\uC1A1\uC774 \uB2A6\uC5C8\uACE0, \uC0C1\uD488\uC740
      \uC644\uC804\uD788 \uC798\uBABB\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC774 \uC11C\uBE44\uC2A4\uC5D0
      \uB9E4\uC6B0 \uBD88\uB9CC\uC785\uB2C8\uB2E4.\r\n\uC81C \uC8FC\uBB38\uC774 \uB108\uBB34
      \uC5C9\uB9DD\uC73C\uB85C \uCC98\uB9AC\uB418\uC5B4 \uCDA9\uACA9\uC744 \uBC1B\uC558\uC2B5\uB2C8\uB2E4.
      \uBAA8\uB4E0 \uAC83\uC774 \uC798\uBABB\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uC81C
      \uC8FC\uBB38\uC758 \uB300\uBD80\uBD84\uC744 \uBC1B\uC9C0 \uBABB\uD588\uACE0,
      \uBC1B\uC740 \uAC83\uC740 \uC4F8\uBAA8\uAC00 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4.
      \uB054\uCC0D\uD55C \uACBD\uD5D8\uC785\uB2C8\uB2E4.\r\n\uC798\uBABB\uB41C \uC81C\uD488\uC774
      \uBC1C\uC1A1\uB418\uC5C8\uACE0, \uBB38\uC81C\uB97C \uD574\uACB0\uD558\uB824\uB2C8
      \uB108\uBB34 \uBC88\uAC70\uB86D\uC2B5\uB2C8\uB2E4. \uBC88\uAC70\uB85C\uC6B8
      \uAC00\uCE58\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uB3C8 \uB0AD\uBE44\uC600\uC2B5\uB2C8\uB2E4.
      \uC8FC\uBB38\uC774 \uC804\uBD80 \uD2C0\uB838\uACE0, \uD574\uACB0\uB41C \uAC83\uC774
      \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\uC8FC\uBB38\uC758 \uB300\uBD80\uBD84\uC740
      \uB9DE\uC558\uC9C0\uB9CC, \uBA87 \uAC00\uC9C0 \uBB3C\uD488\uC774 \uB204\uB77D\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uB354 \uB098\uC544\uC9C8 \uC218 \uC788\uC744 \uAC83\uC785\uB2C8\uB2E4.\r\n\uD544\uC694\uD55C
      \uBB3C\uD488\uC744 \uBC1B\uC558\uC9C0\uB9CC, \uD3EC\uC7A5\uC774 \uC190\uC0C1\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC2DC \uC8FC\uBB38\uD560\uC9C0 \uACE0\uBBFC \uC911\uC785\uB2C8\uB2E4.\r\n\uC8FC\uBB38\uC740
      \uB300\uBD80\uBD84 \uC815\uD655\uD588\uC9C0\uB9CC, \uBC30\uC1A1\uC774 \uC608\uC0C1\uBCF4\uB2E4
      \uC624\uB798 \uAC78\uB838\uC2B5\uB2C8\uB2E4.\r\n\uBB3C\uAC74\uC740 \uAD1C\uCC2E\uC558\uC9C0\uB9CC,
      \uBA87 \uAC00\uC9C0\uAC00 \uBE60\uC84C\uC2B5\uB2C8\uB2E4. \uC804\uBC18\uC801\uC73C\uB85C
      \uBB34\uB09C\uD55C \uACBD\uD5D8\uC785\uB2C8\uB2E4.\r\n\uAC70\uC758 \uBAA8\uB4E0
      \uAC83\uC774 \uB9DE\uC558\uC9C0\uB9CC, \uBA87 \uAC00\uC9C0 \uC2E4\uC218\uAC00
      \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uB098\uC058\uC9C0 \uC54A\uC9C0\uB9CC \uB6F0\uC5B4\uB098\uC9C0\uB3C4
      \uC54A\uC2B5\uB2C8\uB2E4.\r\n\uAD1C\uCC2E\uC740 \uC8FC\uBB38\uC774\uC5C8\uC9C0\uB9CC,
      \uBA87 \uAC00\uC9C0 \uD56D\uBAA9\uC774 \uC798\uBABB\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC74C \uBC88\uC5D0\uB294 \uB354 \uB098\uC544\uC9C0\uAE38 \uBC14\uB78D\uB2C8\uB2E4.\r\n\uB300\uBD80\uBD84\uC758
      \uC81C\uD488\uC774 \uB9DE\uC558\uC9C0\uB9CC, \uC8FC\uBB38\uC5D0 \uBA87 \uAC00\uC9C0
      \uBB38\uC81C\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uAC70\uC758 \uBAA8\uB4E0
      \uBB3C\uD488\uC744 \uBC1B\uC558\uC9C0\uB9CC, \uBA87 \uAC00\uC9C0\uB294 \uC124\uBA85\uACFC
      \uB2EC\uB790\uC2B5\uB2C8\uB2E4. \uD3C9\uBC94\uD55C \uACBD\uD5D8\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\uC8FC\uBB38\uC740
      \uAD1C\uCC2E\uC558\uC9C0\uB9CC, \uB204\uB77D\uB41C \uC81C\uD488\uC774 \uB3C4\uCC29\uD558\uB294
      \uB370 \uB354 \uC624\uB798 \uAE30\uB2E4\uB824\uC57C \uD588\uC2B5\uB2C8\uB2E4.\r\n\uAC70\uC758
      \uB9CC\uC871\uC2A4\uB7EC\uC6E0\uC9C0\uB9CC, \uC8FC\uBB38\uC758 \uC815\uD655\uC131\uC774
      \uB354 \uC88B\uC558\uC73C\uBA74 \uD588\uC2B5\uB2C8\uB2E4.\r\n\uBAA8\uB4E0 \uAC83\uC774
      \uC644\uBCBD\uD588\uC2B5\uB2C8\uB2E4! \uBAA8\uB4E0 \uC81C\uD488\uC774 \uC815\uD655\uD788
      \uC8FC\uBB38\uB300\uB85C \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4. \uB2E4\uC2DC
      \uC8FC\uBB38\uD560 \uAC83\uC785\uB2C8\uB2E4!\r\n\uD6CC\uB96D\uD55C \uACBD\uD5D8\uC774\uC5C8\uC2B5\uB2C8\uB2E4!
      \uC8FC\uBB38\uC774 \uC815\uD655\uD588\uACE0 \uBC30\uC1A1\uC774 \uC815\uC2DC\uC5D0
      \uC774\uB8E8\uC5B4\uC84C\uC2B5\uB2C8\uB2E4. \uB9E4\uC6B0 \uB9CC\uC871\uD569\uB2C8\uB2E4!\r\n\uAE30\uB300\uD55C
      \uB300\uB85C \uBAA8\uB4E0 \uAC83\uC774 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4.
      \uBE60\uB974\uACE0 \uC2E0\uB8B0\uD560 \uC218 \uC788\uB294 \uC11C\uBE44\uC2A4\uC785\uB2C8\uB2E4!\r\n\uC8FC\uBB38\uC774
      \uC644\uBCBD\uD588\uACE0 \uB354\uD560 \uB098\uC704 \uC5C6\uC774 \uAE30\uC069\uB2C8\uB2E4.
      \uAC15\uB825 \uCD94\uCC9C\uD569\uB2C8\uB2E4!\r\n\uBAA8\uB4E0 \uAC83\uC774 \uC8FC\uBB38\uB300\uB85C
      \uB3C4\uCC29\uD588\uACE0, \uD488\uC9C8\uB3C4 \uD6CC\uB96D\uD588\uC2B5\uB2C8\uB2E4.
      \uB9E4\uC6B0 \uB9CC\uC871\uC2A4\uB7FD\uC2B5\uB2C8\uB2E4!\r\n\uC644\uBCBD\uD55C
      \uC8FC\uBB38, \uD6CC\uB96D\uD55C \uC11C\uBE44\uC2A4, \uBE60\uB978 \uBC30\uC1A1\uC774\uC5C8\uC2B5\uB2C8\uB2E4.
      \uB354 \uC774\uC0C1 \uBC14\uB784 \uAC8C \uC5C6\uC2B5\uB2C8\uB2E4!\r\n\uC815\uB9D0
      \uAC10\uB3D9\uD588\uC2B5\uB2C8\uB2E4! \uBAA8\uB4E0 \uD56D\uBAA9\uC774 \uC815\uD655\uD588\uACE0,
      \uBC30\uC1A1\uB3C4 \uC2E0\uC18D\uD588\uC2B5\uB2C8\uB2E4.\r\n\uC81C\uAC00 \uC8FC\uBB38\uD55C
      \uAC83\uC744 \uBB38\uC81C \uC5C6\uC774 \uC815\uD655\uD788 \uBC1B\uC558\uC2B5\uB2C8\uB2E4.
      \uC774 \uC11C\uBE44\uC2A4\uC5D0 \uB9E4\uC6B0 \uB9CC\uC871\uD569\uB2C8\uB2E4!\r\n\uC8FC\uBB38\uC774
      \uC644\uBCBD\uD588\uACE0, \uBD84\uBA85\uD788 \uB2E4\uC2DC \uC8FC\uBB38\uD560
      \uAC83\uC785\uB2C8\uB2E4.\r\n\uD658\uC0C1\uC801\uC778 \uC11C\uBE44\uC2A4\uC785\uB2C8\uB2E4!
      \uC8FC\uBB38\uC774 100% \uC815\uD655\uD588\uACE0 \uBAA8\uB4E0 \uAC83\uC774
      \uC815\uC2DC\uC5D0 \uBC30\uC1A1\uB418\uC5C8\uC2B5\uB2C8\uB2E4. !\"%(),.015:?BCFIMRTXYabdehnort{}\uAC00\uAC01\uAC04\uAC08\uAC10\uAC12\uAC15\uAC16\uAC19\uAC1C\uAC1D\uAC70\uAC74\uAC78\uAC80\uAC83\uAC8C\uACA0\uACA9\uACB0\uACBC\uACBD\uACC4\uACE0\uACE7\uACF3\uACF5\uACFC\uAD00\uAD1C\uAD6C\uAD70\uAD74\uAD8C\uADC0\uADF8\uAE08\uAE30\uAE34\uAE38\uAE4C\uAE50\uAE54\uAE68\uAF2D\uB054\uB057\uB05D\uB098\uB09C\uB0A8\uB0A9\uB0AC\uB0AD\uB0B4\uB108\uB123\uB124\uB155\uB178\uB179\uB204\uB20C\uB274\uB294\uB298\uB2A5\uB2A6\uB2C8\uB2D0\uB2D8\uB2E4\uB2E5\uB2EB\uB2EC\uB2F5\uB2F9\uB300\uB354\uB358\uB370\uB3C4\uB3C8\uB3D9\uB418\uB41C\uB429\uB4DC\uB4E0\uB4E4\uB4F1\uB514\uB5A0\uB5A4\uB6F0\uB77C\uB77D\uB780\uB784\uB78C\uB78D\uB790\uB791\uB798\uB799\uB7EC\uB7FC\uB7FD\uB807\uB808\uB824\uB825\uB838\uB839\uB85C\uB85D\uB864\uB86D\uB86F\uB8B0\uB8CC\uB8E8\uB958\uB96D\uB974\uB978\uB97C\uB9AC\uB9AD\uB9B4\uB9BC\uB9C8\uB9CC\uB9CE\uB9D0\uB9DD\uB9DE\uB9E4\uBA38\uBA4B\uBA54\uBA74\uBA85\uBA87\uBAA8\uBAA9\uBAAC\uBABB\uBB34\uBB38\uBB3C\uBB50\uBBAC\uBBF8\uBBFC\uBC00\uBC14\uBC15\uBC16\uBC18\uBC1B\uBC1C\uBC29\uBC30\uBC31\uBC84\uBC88\uBC8C\uBC94\uBCA0\uBCA8\uBCBD\uBCC0\uBCC4\uBCD1\uBCF4\uBCF8\uBD80\uBD84\uBD88\uBDF0\uBE0C\uBE44\uBE60\uBE68\uC058\uC069\uC0AC\uC0AD\uC0B0\uC0B4\uC0C1\uC0C8\uC0C9\uC0DD\uC0F5\uC11C\uC11D\uC120\uC124\uC131\uC138\uC13C\uC158\uC18C\uC18D\uC190\uC1A1\uC1FC\uC218\uC2A4\uC2AC\uC2B5\uC2B9\uC2DC\uC2DD\uC2E0\uC2E4\uC2EC\uC2ED\uC2F6\uC2F8\uC4F0\uC4F8\uC544\uC545\uC548\uC54A\uC558\uC560\uC561\uC571\uC57C\uC5B4\uC5B8\uC5BC\uC5C5\uC5C6\uC5C7\uC5C8\uC5C9\uC5D0\uC5EC\uC5F4\uC5FD\uC600\uC601\uC608\uC624\uC628\uC62C\uC635\uC644\uC65C\uC678\uC694\uC69C\uC6A9\uC6B0\uC6B4\uC6B8\uC6C0\uC6CC\uC6D0\uC6E0\uC704\uC73C\uC740\uC744\uC74C\uC758\uC774\uC778\uC77C\uC783\uC784\uC785\uC788\uC78A\uC790\uC791\uC794\uC798\uC7A0\uC7A5\uC7AC\uC800\uC801\uC804\uC808\uC810\uC815\uC81C\uC838\uC84C\uC870\uC871\uC885\uC88B\uC8E0\uC8FC\uC904\uC911\uC9C0\uC9C1\uC9C4\uC9C8\uC9D1\uCA4C\uCC0D\uCC29\uCC2E\uCC3E\uCC98\uCC9C\uCCAD\uCCB4\uCD08\uCD94\uCD95\uCD9C\uCDA4\uCDA9\uCDE8\uCE58\uCE74\uCE90\uCE94\uCEE4\uCEE8\uCEF4\uCFE0\uD06C\uD070\uD074\uD0A4\uD0C0\uD130\uD14C\uD1A0\uD1B5\uD29C\uD2B8\uD2B9\uD2C0\uD301\uD305\uD30C\uD310\uD328\uD398\uD3B4\uD3B8\uD3C9\uD3EC\uD3ED\uD45C\uD478\uD480\uD488\uD48D\uD4E8\uD508\uD50C\uD53C\uD53D\uD544\uD551\uD558\uD55C\uD560\uD568\uD569\uD56D\uD574\uD588\uD589\uD5A5\uD5D8\uD615\uD638\uD654\uD655\uD658\uD669\uD68C\uD6A8\uD6CC\uD734\uD788\uD78C\uD798\r\n\uC0C8
      \uAC8C\uC784\r\n\uACC4\uC18D\uD558\uAE30\r\n\uC635\uC158\r\n\uC885\uB8CC\r\n\uD328\uCE58
      \uB178\uD2B8\r\n\uC800\uC7A5 \uC2AC\uB86F\uC774 \uBE44\uC5B4 \uC788\uC2B5\uB2C8\uB2E4\r\n\uAC8C\uC784
      \uD50C\uB808\uC774\r\n\uBE44\uB514\uC624\r\n\uC0AC\uC6B4\uB4DC\r\n\uCEE8\uD2B8\uB864
      (\uACE7 \uC81C\uACF5)\r\n\uC885\uB8CC\uD558\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?
      \uC9C4\uD589 \uC0C1\uD669\uC774 \uC800\uC7A5\uB429\uB2C8\uB2E4.\r\n\uBA38\uBB34\uB974\uAE30\r\n\uAC10\uB3C4\r\n\uBC31\uADF8\uB77C\uC6B4\uB4DC\uC5D0\uC11C
      \uC2E4\uD589\r\nY\uCD95 \uBC18\uC804\r\nX\uCD95 \uBC18\uC804\r\n\uC5B8\uC5B4\r\n\uC124\uC815
      \uCD08\uAE30\uD654\r\n\uC804\uCCB4 \uD654\uBA74\r\n\uD488\uC9C8\r\n\uC218\uC9C1
