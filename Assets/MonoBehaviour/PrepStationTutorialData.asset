  <TutorialId>k__BackingField: 0
  <TitleLocalizationKey>k__BackingField: tutorial.prep_station.title
  <BodyLocalizationKey>k__BackingField: tutorial.prep_station.body
  <Title>k__BackingField: Prep Station
  <Body>k__BackingField: "Prepare raw ingredients here.\n\nSelect a cuttable ingredient from your inventory using 1–4, then place it on the Prep Station. Choose the cut type by clicking a knife, such as Long Strip or Nigiri Cut.\n\nFollow the cut markers to prepare the ingredient. When the cutting is complete, place the prepared ingredient into the Gastro Pan on the Prep Station. Then take the Gastro Pan to the Chef Desk and place it there to use the ingredient in recipes."
  <VideoClip>k__BackingField: {fileID: 32900000, guid: 2624dfdf0c0f2e044b75bfb600adb285, type: 3}
