  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_vi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Tạm biệt!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Chào bạn, tôi có thể giúp gì cho bạn?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Một chiếc đồng hồ.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Cái gì?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Cái gì có hai tay và một khuôn mặt, nhưng không có tay và chân?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Họ không đủ can đảm.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Tại sao?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Tại sao các bộ xương không đánh nhau?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Một bức tranh vẽ bằng bột nhão.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Tại sao?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Bạn gọi món mì Ý giả là gì?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Vì ông ấy xuất sắc trong lĩnh vực của mình.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Tại sao?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Tại sao người rơm lại đoạt giải?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Phô mai Nacho.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Tại sao?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Bạn gọi loại pho mát không phải của mình là gì?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Nó quá mệt mỏi.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Tại sao?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Tại sao xe đạp không thể tự đứng vững?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Được mô tả chi tiết.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Tại sao?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Bạn gọi một con cá đeo nơ là gì?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Nó bị cướp mất rồi.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Tại sao?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Tại sao quán cà phê lại trình báo cảnh sát?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Một cây cọ.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Tại sao?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Loại cây nào vừa vặn trong lòng bàn tay bạn?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Vì nó nhìn thấy nước sốt salad.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Tại sao?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Tại sao quả cà chua lại chuyển sang màu đỏ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Một con gấu dẻo.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Tại sao?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Bạn gọi một con gấu không có răng là gì?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Hẹn gặp lại sớm!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Chào mừng đến với Chợ Xanh!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
