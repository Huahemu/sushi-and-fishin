  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Čau, čau!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Dobrý den, jak vám mohu pomoci?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Hodiny.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Co?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Co má dvě ruce a obličej, ale žádné paže a nohy?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Nemají odvahu.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Proč?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Proč kostry nebojují mezi sebou?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Těstovinový podvodník!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Proč?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Jak se říká falešným špagetám?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Protože byl ve svém oboru vynikající.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Proč?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Proč strašák získal cenu?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Nacho sýr.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Proč?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Jak se říká sýru, který není tvůj?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Protože byla dvakrát unavená!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Proč?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Proč se kolo nemůže samo postavit?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofistikovaná ryba!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Proč?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Jak se říká rybě s motýlkem?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Protože jí někdo ukradl šálek!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Proč?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Proč káva zavolala policii?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Palma.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Proč?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Jaký strom se ti vejde do ruky?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Protože vidělo zálivku na salát.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Proč?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Proč rajče zčervenalo?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Gumový medvídek.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Proč?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Jak se říká medvědovi bez zubů?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Brzy na viděnou!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Vítejte na Zeleném trhu!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
