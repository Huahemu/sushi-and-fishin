MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_zh-TW
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh-TW
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: 掰掰！
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: 嗨，需要我幫你什麼嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: ㄎㄎ。
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: 什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: 丁丁走在路上被揍一拳會變成什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: 地瓜囚。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: 什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: 地瓜被關起來會變成什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: 不好意鼠！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: 什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: 很有禮貌的老鼠叫什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: 因為它是「金排球」……真歹笑！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: 為什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: 為什麼金色的排球一點都不好笑？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: 因為他們總是「製作多琴」。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: 為什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: 為什麼做鋼琴的人在感情上容易暈船？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: 洋遇騙。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: 什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: 一個被騙的外國人叫什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: 小便。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: 什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: 小美走在路上突然尿急會變成什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: 派KEA！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: 什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: IKEA 的家具壞掉會變成什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: 因為是在「當鋪裡」……Dumpling！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: 為什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: 為什麼要去當鋪吃水餃？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: 川媽臭臭鍋！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: 什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: 三媽臭臭鍋倒了會變成什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: 因為失綿了！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: 為什麼？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: 你知道綿羊剃完毛後為什麼會睡不著嗎？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: 再見！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: 歡迎來到綠色市集！
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
