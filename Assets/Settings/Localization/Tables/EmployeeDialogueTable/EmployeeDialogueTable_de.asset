  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Tschüss!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Hallo, wie kann ich Ihnen helfen?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Eine Uhr.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Was?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Was hat zwei Hände und ein Gesicht, aber keine Arme und Beine?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Ihnen fehlt der Mut.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Warum bekämpfen sich Skelette nicht gegenseitig?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Ein Impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Wie nennt man gefälschte Spaghetti?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Weil er in seinem Fachgebiet herausragend war.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Warum hat die Vogelscheuche einen Preis gewonnen?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Nacho-Käse.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Wie nennt man Käse, der einem nicht gehört?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Es war zu müde.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Warum kann ein Fahrrad nicht von alleine stehen?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofischtifiziert.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Wie nennt man einen Fisch mit einer Fliege?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Es wurde überfallen.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Warum hat das Café Anzeige bei der Polizei erstattet?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Eine Palme.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Welcher Baum passt gut in Ihre Hand?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Weil es das Salatdressing gesehen hat.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Warum ist die Tomate rot geworden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Ein Gummibärchen.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Warum?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Wie nennt man einen Bären ohne Zähne?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Bis bald!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Willkommen im Green Market!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
