  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_no
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: no
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Ha det bra!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Hallo, hvordan kan jeg hjelpe deg?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: En klokke.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Hva?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Hva har to hender og et ansikt, men ingen armer og ben?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: De har ikke guts.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Hvorfor slåss ikke skjeletter med hverandre?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: En impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Hva kaller du falsk spaghetti?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Fordi han var fremragende i sitt felt.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Hvorfor vant fugleskremselen en pris?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Nacho-ost.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Hva kaller du ost som ikke er din?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Det var to slitne.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Hvorfor kan ikke en sykkel stå oppreist av seg selv?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofistikert.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Hva kaller man en fisk som har på seg en sløyfe?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Den ble ranet.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Hvorfor anmeldte kaffen saken til politiet?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Et palmetre.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Hva slags tre passer i hånden din?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Fordi den så salatdressingen.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Hvorfor ble tomaten rød?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: En gummibjørn.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Hva kaller man en bjørn uten tenner?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Vi sees snart!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Velkommen til Grønt Marked!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
