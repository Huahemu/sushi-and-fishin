  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_fi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: fi
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Hei hei hei!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Hei, miten voin auttaa?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Kello.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Mitä?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Millä on kaksi kättä ja kasvot, mutta ei käsivarsia eikä jalkoja?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Heillä ei ole rohkeutta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Miksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Miksi luurangot eivät taistele keskenään?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Miksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Mitä kutsutaan feikkispagetiksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Koska hän oli alallaan erinomainen.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Miksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Miksi peltikurpitsa voitti palkinnon?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Nachojuustoa.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Miksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Mitä kutsutaan juustoksi, joka ei ole sinun?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Oli kaksi väsynyttä.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Miksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Miksi polkupyörä ei pysy pystyssä itsestään?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Hienostunut.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Miksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Mitä kutsutaan kalaksi, jolla on rusetti?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Se ryöstettiin.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Miksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Miksi kahvi teki rikosilmoituksen?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Palmu.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Miksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Millainen puu sopii käteesi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Koska se näki salaatinkastikkeen.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Miksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Miksi tomaatti muuttui punaiseksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Nallekarkki.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Miksi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Mitä kutsutaan karhuksi, jolla ei ole hampaita?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Nähdään pian!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Tervetuloa Vihreille markkinoille!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
