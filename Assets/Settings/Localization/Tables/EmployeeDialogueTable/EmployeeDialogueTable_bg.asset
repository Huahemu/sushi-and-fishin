  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_bg
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: bg
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Чао, чао!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Здравейте, как мога да ви помогна?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Часовник.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Какво?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Какво има две ръце и лице, но няма ръце и крака?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Те нямат смелостта.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Защо?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Защо скелетите не се бият помежду си?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Импаста.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Защо?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Как се наричат ​​фалшиви спагети?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Защото беше изключителен в своята област.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Защо?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Защо плашилото спечели награда?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Начо сирене.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Защо?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Как се нарича сирене, което не е твое?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Бяха двама уморени.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Защо?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Защо велосипедът не може да стои сам?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Изтънчен.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Защо?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Как се нарича риба, носеща папионка?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Ограбиха го.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Защо?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Защо кафето подаде полицейски доклад?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Палма.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Защо?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Какъв вид дърво се побира в ръката ви?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Защото видя дресинга за салата.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Защо?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Защо доматът стана червен?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Гумено мече.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Защо?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Как се нарича мечка без зъби?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Ще се видим скоро!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Добре дошли на Зеления пазар!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
