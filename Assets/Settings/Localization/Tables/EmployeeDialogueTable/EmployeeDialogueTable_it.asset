  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_it
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: it
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Ciao ciao!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Salve, come posso aiutarla?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Un orologio.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Che cosa?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Cos'è che ha due mani e una faccia, ma non braccia e gambe?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Non ne hanno il coraggio.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Perché?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Perché gli scheletri non combattono tra loro?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Un'impastata.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Perché?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Come si chiamano gli spaghetti finti?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Perché eccelleva nel suo campo.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Perché?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Perché lo spaventapasseri ha vinto un premio?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Formaggio nacho.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Perché?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Come si chiama il formaggio che non è tuo?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Era troppo stanco.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Perché?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Perché una bicicletta non riesce a stare in piedi da sola?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofisticato.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Perché?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Come si chiama un pesce che indossa un papillon?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: È stato rapinato.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Perché?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Perché il caffè ha sporto denuncia alla polizia?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Una palma.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Perché?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Che tipo di albero può stare nel palmo della tua mano?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Perché ha visto il condimento dell'insalata.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Perché?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Perché il pomodoro è diventato rosso?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Un orsetto gommoso.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Perché?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Come si chiama un orso senza denti?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Arrivederci!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Benvenuti al Green Market!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
