  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_es
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: ¡Adiós!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Hola, ¿en qué puedo ayudarte?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Un reloj.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: ¿Qué?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: ¿Qué tiene dos manecillas y una cara, pero no brazos ni piernas?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Porque no tienen agallas.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: ¿Por qué los esqueletos no pelean entre ellos?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Un impostor de pasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: ¿Cómo llamas a unos espaguetis falsos?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Porque destacaba en su campo.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: ¿Por qué ganó un premio el espantapájaros?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Queso nacho.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: ¿Cómo llamas al queso que no es tuyo?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Porque estaba dos veces cansada.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: ¿Por qué una bicicleta no puede mantenerse de pie sola?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofisticado de pez.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: ¿Cómo llamas a un pez con pajarita?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Porque la atracaron en una taza.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: ¿Por qué el café presentó una denuncia?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Una palmera.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: ¿Qué tipo de árbol cabe en tu mano?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Porque vio cómo se aliñaba la ensalada.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: ¿Por qué se puso rojo el tomate?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Un osito de goma.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: ¿Por qué?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: ¿Cómo llamas a un oso sin dientes?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: ¡Hasta pronto!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: ¡Bienvenido a Green Market!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
