  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_sv
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: sv
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Hej då!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Hej, hur kan jag hjälpa dig?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: En klocka.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Vad?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Vad har två händer och ett ansikte, men inga armar och ben?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: De har inte modet.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Varför?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Varför slåss inte skelett med varandra?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: En impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Varför?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Vad kallar man falsk spaghetti?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: För att han var framstående inom sitt område.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Varför?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Varför vann fågelskrämman ett pris?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Nacho-ost.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Varför?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Vad kallar man ost som inte är din?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Det var två trötta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Varför?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Varför kan inte en cykel stå upp av sig själv?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofistikerad.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Varför?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Vad kallar man en fisk som bär fluga?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Den blev rånad.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Varför?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Varför gjorde kaffet en polisanmälan?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: En palm.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Varför?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Vilken sorts träd får plats i din hand?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Eftersom den såg salladsdressingen.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Varför?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Varför blev tomaten röd?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: En gummibjörn.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Varför?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Vad kallar man en björn utan tänder?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Vi ses snart!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Välkommen till Gröna Marknaden!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
