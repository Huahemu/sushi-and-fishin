  m_TableData:
  - m_Id: 6570463232
    m_Localized: Selamat tinggal!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Halo, ada yang bisa saya bantu?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Sebuah jam.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Apa?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Apa yang memiliki dua tangan dan wajah, tetapi tidak memiliki lengan dan kaki?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Mereka tidak punya nyali.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Mengapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Mengapa kerangka tidak saling berkelahi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Sebuah impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Mengapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Apa sebutan untuk spaghetti palsu?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Karena dia sangat unggul di bidangnya.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Mengapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Mengapa orang-orangan sawah memenangkan penghargaan?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Keju nacho.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Mengapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Apa sebutan untuk keju yang bukan milikmu?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Itu sangat melelahkan.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Mengapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Mengapa sepeda tidak bisa berdiri sendiri?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofishticated.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Mengapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Apa sebutan untuk ikan yang mengenakan dasi kupu-kupu?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Tempat itu dirampok.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Mengapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Mengapa kopi itu membuat laporan polisi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Pohon palem.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Mengapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Pohon jenis apa yang muat di telapak tanganmu?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Karena ia melihat saus salad.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Mengapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Mengapa tomat itu berubah menjadi merah?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Permen beruang gummy.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Mengapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Apa sebutan untuk beruang yang tidak memiliki gigi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Sampai berjumpa lagi!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Selamat datang di Pasar Hijau!
    m_Metadata:
      m_Items: []
  references:
    version: 2
