  m_TableData:
  - m_Id: 6570463232
    m_Localized: Tot ziens!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Hallo, waarmee kan ik u helpen?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Een klok.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Wat?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Wat heeft twee handen en een gezicht, maar geen armen en benen?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Ze hebben er het lef niet voor.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Waarom?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Waarom vechten skeletten niet met elkaar?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Een impapaste.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Waarom?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Hoe noem je nep-spaghetti?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Omdat hij uitblonk in zijn vakgebied.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Waarom?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Waarom won de vogelverschrikker een prijs?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Nachokaas.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Waarom?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Hoe noem je kaas die niet van jou is?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Het waren er twee die moe waren.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Waarom?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Waarom kan een fiets niet vanzelf rechtop blijven staan?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofishticated.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Waarom?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Hoe noem je een vis die een vlinderdas draagt?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Het werd beroofd.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Waarom?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Waarom heeft de koffiezaak aangifte gedaan bij de politie?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Een palmboom.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Waarom?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Welke boom past in je hand?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Omdat het de saladedressing zag.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Waarom?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Waarom werd de tomaat rood?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Een gummibeer.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Waarom?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Hoe noem je een beer zonder tanden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Tot snel!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Welkom bij Green Market!
    m_Metadata:
      m_Items: []
  references:
    version: 2
