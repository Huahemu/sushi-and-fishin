  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_tr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: tr
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Hoşça kal!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Merhaba, sana nasıl yardımcı olabilirim?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Çünkü işi çok ağırdı.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Hamal neden işten ayrıldı?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Kalem.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Yazı yazmayı en çok seven sebze hangisidir?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Çünkü çok çekingenmiş.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Fotoğraf makinesi neden arkadaş edinememiş?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Çünkü hep başı dönüyormuş.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Vantilatör neden doktora gitmiş?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Çünkü bütün parasını faize yatırmış.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Matematikçi neden bankadan çıkmıyormuş?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Çaydanlık.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: En çok çay içen ev eşyası hangisidir?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Çünkü sürekli lafı dolandırıyormuş.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Viraj neden kimseyle anlaşamıyormuş?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Çünkü bütün gün boş boş bakıyormuş.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Pencere neden işten kovulmuş?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Çünkü hesabı kabarık gelmiş.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Kirpi neden restoranda sinirlenmiş?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Çünkü tuşlarına basılmış.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Klavye neden morali bozukmuş?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Çünkü her şeyi büyütüyormuş.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Neden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Büyüteç neden arkadaşlarını sinirlendiriyormuş?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Yakında görüşürüz!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Green Market'e hoş geldin!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
