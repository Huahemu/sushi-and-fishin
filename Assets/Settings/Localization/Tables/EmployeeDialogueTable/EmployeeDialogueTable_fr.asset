  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_fr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Au revoir !
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Bonjour, comment puis-je vous aider ?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Une horloge.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Quoi?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Qu'est-ce qui a deux mains et un visage, mais pas de bras ni de jambes ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Ils n'ont pas le courage.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Pourquoi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Pourquoi les squelettes ne se battent-ils pas entre eux ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Une impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Pourquoi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Comment appelle-t-on les faux spaghettis ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Parce qu'il était exceptionnel dans son domaine.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Pourquoi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Pourquoi l'épouvantail a-t-il remporté un prix ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Fromage nacho.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Pourquoi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Comment appelle-t-on un fromage qui ne vous appartient pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Il était trop fatigué.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Pourquoi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Pourquoi un vélo ne peut-il pas tenir debout tout seul ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofishticed.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Pourquoi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Comment appelle-t-on un poisson qui porte un nœud papillon ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Il a été cambriolé.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Pourquoi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Pourquoi le café a-t-il porté plainte auprès de la police ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Un palmier.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Pourquoi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Quel type d'arbre tient dans votre main ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Parce qu'elle a vu la vinaigrette.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Pourquoi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Pourquoi la tomate est-elle devenue rouge ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Un ourson en gélatine.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Pourquoi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Comment appelle-t-on un ours sans dents ?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: À bientôt!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Bienvenue au Marché Vert !
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
