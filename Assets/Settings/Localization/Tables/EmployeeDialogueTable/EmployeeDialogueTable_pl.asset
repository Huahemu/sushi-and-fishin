  m_TableData:
  - m_Id: 6570463232
    m_Localized: Żegnaj!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Cześć, w czym mogę pomóc?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Zegar.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Co?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Co ma dwie ręce i twarz, ale nie ma rąk ani nóg?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Oni nie mają odwagi.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Dlaczego szkielety nie walczą ze sobą?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Jak nazywa się sztuczny spaghetti?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Ponieważ był wybitny w swojej dziedzinie.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Dlaczego strach na wróble dostał nagrodę?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Nacho z serem.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Jak nazwać ser, który nie jest twój?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Byłem już zmęczony.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Dlaczego rower nie może stać sam?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Wyrafinowany.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Jak nazywa się ryba nosząca muszkę?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Został napadnięty.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Dlaczego firma zajmująca się kawą zgłosiła sprawę na policję?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Palma.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Jakie drzewo mieści się w Twojej dłoni?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Ponieważ zobaczył sos sałatkowy.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Dlaczego pomidor zrobił się czerwony?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Miś żelowy.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Dlaczego?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Jak nazywa się niedźwiedzia bez zębów?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Do zobaczenia wkrótce!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Witamy w Green Market!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
