  m_TableData:
  - m_Id: 6570463232
    m_Localized: Bye bye!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Hello, How can I help you?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: A clock.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: What?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: What has two hands and a face, but no arms and legs?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: They don't have the guts.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Why don't skeletons fight each other?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: An impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: What do you call fake spaghetti?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Because he was outstanding in his field.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Why did the scarecrow win an award?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Nacho cheese.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: What do you call cheese that isn't yours?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: It was two tired.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Why can't a bicycle stand up by itself?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofishticated.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: What do you call a fish wearing a bowtie?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: It got mugged.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Why did the coffee file a police report?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: A palm tree.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: What kind of tree fits in your hand?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Because it saw the salad dressing.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Why did the tomato turn red?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: A gummy bear.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Why?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: What do you call a bear with no teeth?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: See you soon!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Welcome to Green Market!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
