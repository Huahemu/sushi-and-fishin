--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_el
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: el
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Αντίο αντίο!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Γεια σας, πώς μπορώ να σας βοηθήσω;
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Ένα ρολόι.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Τι;
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Τι έχει δύο χέρια και ένα πρόσωπο, αλλά όχι χέρια και πόδια;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Δεν έχουν τα κότσια.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Γιατί;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Γιατί οι σκελετοί δεν πολεμούν μεταξύ τους;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Μια ιμπάστα.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Γιατί;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Πώς λέγονται τα ψεύτικα σπαγγέτι;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Επειδή ήταν εξαιρετικός στον τομέα του.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Γιατί;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Γιατί κέρδισε το σκιάχτρο ένα βραβείο;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Τυρί Νάτσος.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Γιατί;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Πώς λέγεται το τυρί που δεν είναι δικό σου;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Ήταν δύο κουρασμένοι.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Γιατί;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Γιατί ένα ποδήλατο δεν μπορεί να σταθεί όρθιο μόνο του;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Εκλεπτυσμένος.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Γιατί;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Πώς λέγεται ένα ψάρι που φοράει παπιγιόν;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Το ληστεύσαν.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Γιατί;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Γιατί ο καφές υπέβαλε καταγγελία στην αστυνομία;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Ένας φοίνικας.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Γιατί;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Τι είδους δέντρο χωράει στο χέρι σου;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Επειδή είδε τη σάλτσα σαλάτας.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Γιατί;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Γιατί η ντομάτα έγινε κόκκινη;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Μια ζελεδένια αρκούδα.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Γιατί;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Πώς λέγεται μια αρκούδα χωρίς δόντια;
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Τα λέμε σύντομα!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Καλώς ορίσατε στην Πράσινη Αγορά!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
