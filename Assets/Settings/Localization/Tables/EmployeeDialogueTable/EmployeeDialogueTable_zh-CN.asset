MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_zh-CN
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh-CN
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: 再见！
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: 您好，请问有什么可以帮到您？
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: 钟表。
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: 什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: 什么东西有两根指针和一张脸，却没有胳膊和腿？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: 因为它们没有胆。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: 为什么骷髅之间不互相打架？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: 冒牌意面（impasta）！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: 假意大利面该叫什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: 因为它在田里站得特别出色。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: 稻草人为什么会获奖？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: 不是你的芝士——是纳乔芝士！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: 不属于你的芝士叫什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: 因为它太累了，而且只有两个轮子。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: 为什么自行车不能自己站立？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: 一条很有“鳍质”的鱼。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: 一条戴着领结的鱼叫什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: 因为它被“杯”劫了。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: 为什么咖啡要报警？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: 棕榈树——palm 也有“手掌”的意思。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: 哪种树能装在你的手掌里？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: 因为它看见沙拉在换衣服。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: 为什么番茄会变红？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: 软糖熊。
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: 为什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: 没有牙齿的熊叫什么？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: 再见！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: 欢迎来到绿色市场！
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
