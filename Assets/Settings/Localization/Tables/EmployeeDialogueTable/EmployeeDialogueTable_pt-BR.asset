  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_pt-BR
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Bye Bye!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Olá, como posso ajudar?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Um relógio.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: O que?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: O que tem duas mãos e um rosto, mas não tem braços nem pernas?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Eles não têm coragem.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Por que?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Por que os esqueletos não lutam entre si?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Uma impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Por que?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Como se chama espaguete falso?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Porque ele era excepcional em sua área.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Por que?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Por que o espantalho ganhou um prêmio?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Queijo nacho.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Por que?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Como se chama o queijo que não é seu?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Estava muito cansado.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Por que?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Por que uma bicicleta não consegue ficar em pé sozinha?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofishticado.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Por que?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Como se chama um peixe que usa gravata borboleta?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Foi assaltado.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Por que?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Por que o dono da cafeteria registrou um boletim de ocorrência?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Uma palmeira.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Por que?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Que tipo de árvore cabe na palma da sua mão?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Porque viu o molho para salada.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Por que?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Por que o tomate ficou vermelho?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Um ursinho de goma.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Por que?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Como se chama um urso sem dentes?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Vejo você em breve!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Bem-vindo ao Green Market!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
