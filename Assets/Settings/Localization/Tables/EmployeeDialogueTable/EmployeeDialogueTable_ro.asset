  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_ro
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ro
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Pa! Pa!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Bună ziua, cum te pot ajuta?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Un ceas.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Ce?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Ce are două mâini și o față, dar nu are brațe și picioare?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Nu au curaj.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: De ce?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: De ce nu se luptă scheletele între ele?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: O impastă.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: De ce?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Cum se numesc spaghete false?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Pentru că era remarcabil în domeniul său.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: De ce?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: De ce a câștigat sperietoarea un premiu?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Brânză nacho.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: De ce?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Cum se numește brânza care nu este a ta?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Erau doi obosiți.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: De ce?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: De ce nu poate o bicicletă să stea în picioare singură?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofisticat.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: De ce?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Cum se numește un pește care poartă papion?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: A fost jefuit.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: De ce?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: De ce a depus cafeaua plângere la poliție?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Un palmier.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: De ce?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Ce fel de copac îți încape în mână?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Pentru că a văzut dressingul de salată.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: De ce?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: De ce s-a înroșit roșia?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Un ursuleț de gumă.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: De ce?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Cum se numește un urs fără dinți?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Pe curând!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Bine ați venit la Piața Verde!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
