  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_hu
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: hu
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Viszlát!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Helló, Miben segíthetek?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Egy óra.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Mi?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Minek van két keze és arca, de nincsenek karjai és lábai?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Nincs hozzá bátorságuk.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Miért?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Miért nem harcolnak egymással a csontvázak?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Egy impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Miért?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Mit nevezel műspagettinek?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Mert kiemelkedő volt a saját területén.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Miért?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Miért nyert díjat a madárijesztő?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Nacho sajt.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Miért?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Hogy hívják azt a sajtot, ami nem a tiéd?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Két fáradtság volt.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Miért?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Miért nem áll meg magától egy bicikli?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Kifinomult.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Miért?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Hogy hívják azt a halat, ami masnit visel?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Kirabolták.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Miért?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Miért tett a kávé rendőrségi feljelentést?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Egy pálmafa.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Miért?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Milyen fa illik a kezedbe?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Mert meglátta a salátaöntetet.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Miért?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Miért lett piros a paradicsom?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Egy gumimaci.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Miért?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Hogy hívják a fogatlan medvét?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Hamarosan találkozunk!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Üdvözöljük a Zöld Piactéren!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
