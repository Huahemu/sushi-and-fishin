  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Selamat tinggal!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Salam, Apa yang boleh saya bantu?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Sebuah jam.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Apa?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Apa yang mempunyai dua tangan dan muka, tetapi tiada lengan dan kaki?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: Mereka tidak mempunyai keberanian.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Kenapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Mengapa rangka tidak bergaduh antara satu sama lain?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: Satu impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Kenapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Apa yang awak panggil spageti palsu?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Kerana beliau cemerlang dalam bidangnya.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Kenapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Mengapakah orang-orangan sawah itu memenangi anugerah?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Keju Nacho.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Kenapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Apa nama keju yang bukan milik anda?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Dua-dua tu penat.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Kenapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Mengapa basikal tidak boleh berdiri sendiri?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Dikenali dengan baik.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Kenapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Apa yang anda panggil ikan yang memakai tali leher kupu-kupu?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Ia telah dirompak.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Kenapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Mengapa kopi itu membuat laporan polis?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Pokok palma.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Kenapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Pokok jenis apa yang muat di tangan awak?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Kerana ia nampak kuah salad.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Kenapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Mengapakah tomato itu bertukar menjadi merah?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: Seekor beruang gebu.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Kenapa?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Apa yang anda panggil beruang yang tidak bergigi?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Jumpa lagi!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Selamat datang ke Pasar Hijau!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
