MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_ar
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ar
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: مع السلامة!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: مرحباً، كيف يمكنني مساعدتك؟
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: ساعة.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: ماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: ما الذي له يدان ووجه، ولكن ليس له أذرع ولا أرجل؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: إنهم يفتقرون إلى الشجاعة.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: لماذا لا تتقاتل الهياكل العظمية فيما بينها؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: مكرونة منتحلة!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: ماذا تسمي المعكرونة المزيفة؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: لأنه كان متميزاً في مجاله.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: لماذا فاز الفزاعة بجائزة؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: جبنة الناتشو.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: ماذا تسمي الجبن الذي ليس ملكك؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: لأنها كانت متعبة مرتين!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: لماذا لا تستطيع الدراجة أن تقف بمفردها؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: سمكة راقية جدًا!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: ماذا تسمي سمكة ترتدي ربطة عنق؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: لأن أحدهم سرق كوبها!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: لماذا قدّمت القهوة بلاغًا للشرطة؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: شجرة نخيل.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: أي نوع من الأشجار يناسب يدك؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: لأنه رأى تتبيلة السلطة.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: لماذا تحول لون الطماطم إلى الأحمر؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: دبٌّ من الحلوى المطاطية.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: لماذا؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: ماذا تسمي دبًا بلا أسنان؟
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: أراك قريباً!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: أهلاً بكم في السوق الأخضر!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
