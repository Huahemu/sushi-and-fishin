MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_ja
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: ja
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: バイバイ！
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: おう、いらっしゃい！何か用かい？
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: アルミ缶の上にあるみかん！
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: 何？
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: アルミ缶の上にあるものは？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: フライパン！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: パンはパンでも、食べられないパンは？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: ゾウ！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: 冷蔵庫の中にいる動物は？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: アイス！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: 椅子は椅子でも、冷たくて美味しい椅子は？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: トラック！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: ９匹のトラが乗っている車は？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: しか！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: 歯医者さんによく行く動物は？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: おもちゃ！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: お茶はお茶でも、乗って遊べるお茶は？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: たか！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: いつも値段が高い鳥は？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: 景気
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: どんなに食べてもお腹がいっぱいにならないケーキは？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: お城！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: 色が黒くても「白」と呼ばれる建物は？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: 梅干し！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: どうして？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: 星は星でも、とってもすっぱい星は？
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: ありがとうございました！
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: グリーンマーケットへいらっしゃいませ！
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
