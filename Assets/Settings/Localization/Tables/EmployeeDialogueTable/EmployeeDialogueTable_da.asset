  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: EmployeeDialogueTable_da
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: da
  m_SharedData: {fileID: 11400000, guid: 9f49d74a07cbe054484a77729a619daa, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 6570463232
    m_Localized: Farvel!
    m_Metadata:
      m_Items: []
  - m_Id: 6583046144
    m_Localized: Hej, hvordan kan jeg hjælpe dig?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046145
    m_Localized: Et ur.
    m_Metadata:
      m_Items: []
  - m_Id: 6583046146
    m_Localized: Hvad?
    m_Metadata:
      m_Items: []
  - m_Id: 6583046147
    m_Localized: Hvad har to hænder og et ansigt, men ingen arme og ben?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240448
    m_Localized: De har ikke modet.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240449
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240450
    m_Localized: Hvorfor kæmper skeletter ikke mod hinanden?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240451
    m_Localized: En impasta.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240452
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240453
    m_Localized: Hvad kalder man falsk spaghetti?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240454
    m_Localized: Fordi han var fremragende inden for sit felt.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240455
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240456
    m_Localized: Hvorfor vandt fugleskræmslet en pris?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240457
    m_Localized: Nacho-ost.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240458
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240459
    m_Localized: Hvad kalder man ost, der ikke er din?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240460
    m_Localized: Det var to trætte.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240461
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240462
    m_Localized: Hvorfor kan en cykel ikke stå op af sig selv?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240463
    m_Localized: Sofistikeret.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240464
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240465
    m_Localized: Hvad kalder man en fisk med en butterfly?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240466
    m_Localized: Den blev overfaldet.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240467
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240468
    m_Localized: Hvorfor anmeldte kaffen det til politiet?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240469
    m_Localized: Et palmetræ.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240470
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240471
    m_Localized: Hvilken slags træ passer i din hånd?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240472
    m_Localized: Fordi den så salatdressingen.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240473
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240474
    m_Localized: Hvorfor blev tomaten rød?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240475
    m_Localized: En vingummibamser.
    m_Metadata:
      m_Items: []
  - m_Id: 6587240476
    m_Localized: Hvorfor?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240477
    m_Localized: Hvad kalder man en bjørn uden tænder?
    m_Metadata:
      m_Items: []
  - m_Id: 6587240478
    m_Localized: Vi ses snart!
    m_Metadata:
      m_Items: []
  - m_Id: 6587240479
    m_Localized: Velkommen til Grønt Marked!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
