  m_TableData:
  - m_Id: 11263889408
    m_Localized: Странен компас
    m_Metadata:
      m_Items: []
  - m_Id: 11263889410
    m_Localized: Нова риба
    m_Metadata:
      m_Items: []
  - m_Id: 11263889412
    m_Localized: Използвайте конвейера
    m_Metadata:
      m_Items: []
  - m_Id: 11263889414
    m_Localized: Сервирайте гарнитури
    m_Metadata:
      m_Items: []
  - m_Id: 11263889416
    m_Localized: Обслужете първия си клиент
    m_Metadata:
      m_Items: []
  - m_Id: 11263889418
    m_Localized: Почистване на масата
    m_Metadata:
      m_Items: []
  - m_Id: 11263889420
    m_Localized: Спестете пари за конвейера
    m_Metadata:
      m_Items: []
  - m_Id: 11263889422
    m_Localized: Възстановете конвейера
    m_Metadata:
      m_Items: []
  - m_Id: 11263889424
    m_Localized: Фиксирано меню за нигири със скумрия
    m_Metadata:
      m_Items: []
  - m_Id: 11263889426
    m_Localized: Хванете първата си риба
    m_Metadata:
      m_Items: []
  - m_Id: 11263889428
    m_Localized: Отключи морския скутер
    m_Metadata:
      m_Items: []
  - m_Id: 11263889430
    m_Localized: Потопете се по-дълбоко
    m_Metadata:
      m_Items: []
  - m_Id: 11263889432
    m_Localized: Намерете новата част от компаса
    m_Metadata:
      m_Items: []
  - m_Id: 11263889434
    m_Localized: Подгответе се за последното гмуркане
    m_Metadata:
      m_Items: []
  - m_Id: 11263889436
    m_Localized: Направете Маки с краставица
    m_Metadata:
      m_Items: []
  - m_Id: 11263889438
    m_Localized: Включете нова риба в менюто
    m_Metadata:
      m_Items: []
  - m_Id: 11263889440
    m_Localized: Пригответе скумрия за суши
    m_Metadata:
      m_Items: []
  - m_Id: 11263889442
    m_Localized: Следвайте сигнала на компаса
    m_Metadata:
      m_Items: []
  - m_Id: 11263889444
    m_Localized: Вашият първи ден
    m_Metadata:
      m_Items: []
  - m_Id: 11263889446
    m_Localized: Завършете първата си поръчка за риба
    m_Metadata:
      m_Items: []
  - m_Id: 11263889448
    m_Localized: Вземете първата си поръчка
    m_Metadata:
      m_Items: []
  - m_Id: 11263889450
    m_Localized: Увеличете стойността на поръчката
    m_Metadata:
      m_Items: []
  - m_Id: 11263889452
    m_Localized: Възстановете ресторанта
    m_Metadata:
      m_Items: []
  - m_Id: 11263889454
    m_Localized: Купете съставки
    m_Metadata:
      m_Items: []
  - m_Id: 11263889456
    m_Localized: Отворете ресторанта
    m_Metadata:
      m_Items: []
  - m_Id: 11263889458
    m_Localized: Филе на скумрия
    m_Metadata:
      m_Items: []
  - m_Id: 11263889460
    m_Localized: Завършете първия си работен ден
    m_Metadata:
      m_Items: []
  - m_Id: 11263889462
    m_Localized: Сварете ориза
    m_Metadata:
      m_Items: []
  - m_Id: 11263889464
    m_Localized: Край на деня
    m_Metadata:
      m_Items: []
  - m_Id: 11263889466
    m_Localized: Победете червения кралски рак
    m_Metadata:
      m_Items: []
  - m_Id: 11263889468
    m_Localized: Подгответе повече риба за сервиране
    m_Metadata:
      m_Items: []
  - m_Id: 11263889470
    m_Localized: Отворете втората маса
    m_Metadata:
      m_Items: []
  - m_Id: 11263889472
    m_Localized: Открийте фара
    m_Metadata:
      m_Items: []
  - m_Id: 11263889474
    m_Localized: Ново суши
    m_Metadata:
      m_Items: []
  - m_Id: 11263889476
    m_Localized: Отключи харпуна
    m_Metadata:
      m_Items: []
  - m_Id: 11263889478
    m_Localized: Пригответе си суши с нигири и скумрия
    m_Metadata:
      m_Items: []
  - m_Id: 11263889480
    m_Localized: Подгответе бюрото на главния готвач
    m_Metadata:
      m_Items: []
  - m_Id: 11263889482
    m_Localized: Подгответе се за по-задълбочено гмуркане
    m_Metadata:
      m_Items: []
  - m_Id: 11263889484
    m_Localized: Последното гмуркане
    m_Metadata:
      m_Items: []
  - m_Id: 11263889486
    m_Localized: Задайте менюто
    m_Metadata:
      m_Items: []
  - m_Id: 11263889488
    m_Localized: Нарежете краставицата
    m_Metadata:
      m_Items: []
  - m_Id: 11263889490
    m_Localized: Запознайте се с Гейб
    m_Metadata:
      m_Items: []
  - m_Id: 11263889492
    m_Localized: Вземете една краставица от щайгата за краставици на едро
    m_Metadata:
      m_Items: []
  - m_Id: 11263889494
    m_Localized: Спечелете пари за водолазния костюм
    m_Metadata:
      m_Items: []
  - m_Id: 11263889496
    m_Localized: Задръжте X, за да сканирате околностите си и да намерите калмар
    m_Metadata:
      m_Items: []
  - m_Id: 11263889498
    m_Localized: Използвайте бюрото на готвача
    m_Metadata:
      m_Items: []
  - m_Id: 11263889500
    m_Localized: Отворете приложението „Меню“
    m_Metadata:
      m_Items: []
  - m_Id: 11263889502
    m_Localized: Добавете гарнитура към менюто
    m_Metadata:
      m_Items: []
  - m_Id: 11263889504
    m_Localized: Победете червения кралски рак
    m_Metadata:
      m_Items: []
  - m_Id: 11263889506
    m_Localized: Открийте фара
    m_Metadata:
      m_Items: []
  - m_Id: 11263889508
    m_Localized: Ремонт на конвейера
    m_Metadata:
      m_Items: []
  - m_Id: 11263889510
    m_Localized: Поставете скумрията в машината за филе
    m_Metadata:
      m_Items: []
  - m_Id: 11263889512
    m_Localized: Отидете до зоната за дрифт Goldenfin
    m_Metadata:
      m_Items: []
  - m_Id: 11263889514
    m_Localized: Нарежете краставица на подготвителната станция
    m_Metadata:
      m_Items: []
  - m_Id: 11263889516
    m_Localized: Отворете колелото с инструменти (задръжте R)
    m_Metadata:
      m_Items: []
  - m_Id: 11263889518
    m_Localized: Сън
    m_Metadata:
      m_Items: []
  - m_Id: 11263889520
    m_Localized: Хвани калмар
    m_Metadata:
      m_Items: []
  - m_Id: 11263889522
    m_Localized: Ремонт на конвейерни столове
    m_Metadata:
      m_Items: []
  - m_Id: 11263889524
    m_Localized: Почистете боклука
    m_Metadata:
      m_Items: []
  - m_Id: 11263889526
    m_Localized: Екипирайте харпун
    m_Metadata:
      m_Items: []
  - m_Id: 11263889528
    m_Localized: Изчистване на тавата (Отиване в кошчето)
    m_Metadata:
      m_Items: []
  - m_Id: 11263889530
    m_Localized: Отидете до зоната на рифа Блукърънт
    m_Metadata:
      m_Items: []
  - m_Id: 11263889532
    m_Localized: Улов на черноморска ципура
    m_Metadata:
      m_Items: []
  - m_Id: 11263889534
    m_Localized: Приемете поръчката на клиента
    m_Metadata:
      m_Items: []
  - m_Id: 11263889536
    m_Localized: Намерете новата част от компаса
    m_Metadata:
      m_Items: []
  - m_Id: 11263889538
    m_Localized: Отидете до района на плитчините Силвър Стрийм
    m_Metadata:
      m_Items: []
  - m_Id: 11263889540
    m_Localized: Купете 1 пакет Нори
    m_Metadata:
      m_Items: []
  - m_Id: 11263889542
    m_Localized: Използвайте бюрото на главния готвач
    m_Metadata:
      m_Items: []
  - m_Id: 11263889544
    m_Localized: Направете нигири със скумрия
    m_Metadata:
      m_Items: []
  - m_Id: 11263889546
    m_Localized: Екипирайте компас (задръжте R)
    m_Metadata:
      m_Items: []
  - m_Id: 11263889548
    m_Localized: Печелете пари от конвейера
    m_Metadata:
      m_Items: []
  - m_Id: 11268083713
    m_Localized: Завъртете табелата, за да отворите
    m_Metadata:
      m_Items: []
  - m_Id: 11268083715
    m_Localized: Отворете менюто на приложението (натиснете TAB)
    m_Metadata:
      m_Items: []
  - m_Id: 11268083717
    m_Localized: Надстройте водолазен костюм до ниво 4
    m_Metadata:
      m_Items: []
  - m_Id: 11268083719
    m_Localized: Отидете на пазара на Марина
    m_Metadata:
      m_Items: []
  - m_Id: 11268083721
    m_Localized: Добавете нарязана краставица в гастро тигана на Chef Desk
    m_Metadata:
      m_Items: []
  - m_Id: 11268083723
    m_Localized: Сервирайте калмари нигири
    m_Metadata:
      m_Items: []
  - m_Id: 11268083725
    m_Localized: Добавете Маки с краставица към менюто
    m_Metadata:
      m_Items: []
  - m_Id: 11268083727
    m_Localized: Екипирайте морския скутер (задръжте R)
    m_Metadata:
      m_Items: []
  - m_Id: 11268083729
    m_Localized: Отворете ресторанта
    m_Metadata:
      m_Items: []
  - m_Id: 11268083731
    m_Localized: Вземете гарнитура и я добавете в тавата
    m_Metadata:
      m_Items: []
  - m_Id: 11268083733
    m_Localized: Добавете чиния към конвейера
    m_Metadata:
      m_Items: []
  - m_Id: 11268083735
    m_Localized: Отключете още една маса за хранене
    m_Metadata:
      m_Items: []
  - m_Id: 11268083737
    m_Localized: Отворете таблета (натиснете TAB)
    m_Metadata:
      m_Items: []
  - m_Id: 11268083739
    m_Localized: Сервирайте гарнитура
    m_Metadata:
      m_Items: []
  - m_Id: 11268083741
    m_Localized: Обслужваме клиенти до вечерта
    m_Metadata:
      m_Items: []
  - m_Id: 11268083743
    m_Localized: Използвайте подготвителната станция
    m_Metadata:
      m_Items: []
  - m_Id: 11268083745
    m_Localized: Вземете варен ориз
    m_Metadata:
      m_Items: []
  - m_Id: 11268083747
    m_Localized: Говори с Гейб
    m_Metadata:
      m_Items: []
  - m_Id: 11268083749
    m_Localized: Отидете до зоната на портала на дълбокото течение
    m_Metadata:
      m_Items: []
  - m_Id: 11268083751
    m_Localized: Купете 1 пакет краставица
    m_Metadata:
      m_Items: []
  - m_Id: 11268083753
    m_Localized: Изберете рецептата за маки с краставица от книгата с рецепти
    m_Metadata:
      m_Items: []
  - m_Id: 11268083755
    m_Localized: Попитай Гейб
    m_Metadata:
      m_Items: []
  - m_Id: 11268083757
    m_Localized: Използвайте подготвителната станция
    m_Metadata:
      m_Items: []
  - m_Id: 11268083759
    m_Localized: Отидете на риболовния магазин на Гейб
    m_Metadata:
      m_Items: []
  - m_Id: 11268083761
    m_Localized: Купете 1 пакет ориз
    m_Metadata:
      m_Items: []
  - m_Id: 11268083763
    m_Localized: Стартирайте оризоварката
    m_Metadata:
      m_Items: []
  - m_Id: 11268083765
    m_Localized: Отидете на пазара на Марина
    m_Metadata:
      m_Items: []
  - m_Id: 11268083767
    m_Localized: Поставете нигири от скумрия в тавата
    m_Metadata:
      m_Items: []
  - m_Id: 11268083769
    m_Localized: Вземете компас
    m_Metadata:
      m_Items: []
  - m_Id: 11268083771
    m_Localized: Направете темаки със сьомга чинук
    m_Metadata:
      m_Items: []
  - m_Id: 11268083772
    m_Localized: Отиди в ресторанта си.
    m_Metadata:
      m_Items: []
  - m_Id: 11268083773
    m_Localized: Отидете в ресторанта
    m_Metadata:
      m_Items: []
  - m_Id: 11268083775
    m_Localized: Използвайте машината за филетиране
    m_Metadata:
      m_Items: []
  - m_Id: 11268083777
    m_Localized: Добавете ориз в оризоварката
    m_Metadata:
      m_Items: []
  - m_Id: 11268083779
    m_Localized: Надстройте водолазен костюм до ниво 5
    m_Metadata:
      m_Items: []
  - m_Id: 11268083781
    m_Localized: Спечелете 3000 долара
    m_Metadata:
      m_Items: []
  - m_Id: 11268083783
    m_Localized: Следвайте сигнала на компаса и намерете последното парче
    m_Metadata:
      m_Items: []
  - m_Id: 11268083785
    m_Localized: Улов на сьомга Chinook
    m_Metadata:
      m_Items: []
  - m_Id: 11268083787
    m_Localized: Вземете нарязана краставица
    m_Metadata:
      m_Items: []
  - m_Id: 11268083789
