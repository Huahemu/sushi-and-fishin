      m_Items: []
  - m_Id: 38711612305415
    m_Localized: Inget utrymme att skapa en gastropan.
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305416
    m_Localized: Den färdiga ingrediensen gick förlorad. Stationen återfunnen.
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305417
    m_Localized: Gastropannan är full. Den rymmer inte fler ingredienser.
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305418
    m_Localized: Ingredienserna är olika. Du kan inte blanda dem.
    m_Metadata:
