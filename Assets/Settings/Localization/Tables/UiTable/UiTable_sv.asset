      m_Items: []
  - m_Id: 38711528419328
    m_Localized: En ingrediens i ett recept kan inte placeras i en gastropan
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111104
    m_Localized: Flytta sushin från mitten innan du ändrar receptet
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111105
    m_Localized: Flytta sushin från mitten innan du gör en ny
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111106
    m_Localized: Ingen plats att placera sushin. Den kommer att stanna i mitten.
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111107
    m_Localized: Hoppsan! Åtgärden kunde inte slutföras.
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111108
    m_Localized: Recept fyllda gastropaner
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111109
    m_Localized: Välj ett recept först
    m_Metadata:
      m_Items: []
