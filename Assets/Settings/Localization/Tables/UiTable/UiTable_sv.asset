    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541248
    m_Localized: Offentlig
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541249
    m_Localized: REDO
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541250
    m_Localized: REDO
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541251
    m_Localized: Värden väljer sparfilen. Alla åker tillsammans.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541252
    m_Localized: 'Kräv att alla är redo: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541253
    m_Localized: Laget är redo. Välj en sparfil och segla iväg tillsammans.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541254
    m_Localized: Uppdatera
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541255
    m_Localized: 'Ta bort lösenord: Nej'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541256
    m_Localized: 'Ta bort lösenord: Nej'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541257
    m_Localized: 'Ta bort lösenord: Ja'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541258
    m_Localized: 'Kräv att alla är redo: På'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541259
    m_Localized: Lobbyvärden tog bort din åtkomst.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541260
    m_Localized: Tillträde till lobbyn godkändes inte. Anslut igen med lobbykoden och lösenordet.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541261
    m_Localized: Du är redan i den här lobbyn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541262
    m_Localized: Bannlysningen hävd.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541263
    m_Localized: En lobbyåtgärd pågår redan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541264
    m_Localized: Lobbyvärden kan inte tas bort.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541265
    m_Localized: Välj mellan 1 och 5 spelare.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541266
    m_Localized: Spelargränsen får inte vara lägre än det nuvarande laget.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541267
    m_Localized: Anslut till Steam för att bläddra bland lobbyer.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541268
    m_Localized: Anslut till Steam för att skapa en lobby.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541269
    m_Localized: Anslut till Steam innan du ansluter till en lobby.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541270
    m_Localized: Lobbykoden kopierad.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541271
    m_Localized: Steam kunde inte skapa en lobby. Försök igen.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541272
    m_Localized: Lobbyn skapad.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541273
    m_Localized: Värden använder en annan spelversion.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541274
    m_Localized: Den här lobbyn är för värdens Steam-vänner.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541275
    m_Localized: Steam kunde inte kontakta lobbyvärden.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541276
    m_Localized: Lobbyvärden lämnade. Återvänder till din egen lobby.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541277
    m_Localized: Värden startar spelet. Försök om en stund.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541278
    m_Localized: Lobbyvärden svarade inte. Försök igen.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541279
    m_Localized: Lobbyvärden är inte tillgänglig.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541280
    m_Localized: Steam-identiteten är inte tillgänglig.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541281
    m_Localized: Den här lobbyn använder en inkompatibel lobbyversion.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541282
    m_Localized: Den här lobbykoden är ogiltig.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541283
    m_Localized: Lobbyanslutningen avbröts.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541284
    m_Localized: Steam kunde inte ansluta till lobbyn. Kontrollera koden och försök igen.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541285
    m_Localized: Ansluten till lobbyn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541286
    m_Localized: Du lämnade lobbyn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541287
    m_Localized: Steam kunde inte uppdatera lobbylåset.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541288
    m_Localized: Lobbynamn får innehålla högst 32 tecken.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541289
    m_Localized: Ange ett lobbynamn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541290
    m_Localized: Värden lämnade eller byttes under anslutningen. Använd en ny lobbykod.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541291
    m_Localized: Lobbyvärden byttes under anslutningen. Försök igen.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541292
    m_Localized: Lösenord får inte innehålla kontrolltecken.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541293
    m_Localized: Lösenord måste innehålla 4–32 tecken.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541294
    m_Localized: Lösenordet är för långt.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541295
    m_Localized: Den här lobbyn kräver ett lösenord.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541296
    m_Localized: Spelaren bannlyst. Bannlysningen gäller tills du häver den.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541297
    m_Localized: Spelaren borttagen. Spelaren kan ansluta igen om 30 sekunder.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541298
    m_Localized: Spelaren har redan lämnat.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541299
    m_Localized: Steam kunde inte godkänna inbjudan till den privata lobbyn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541300
    m_Localized: För många försök. Vänta en stund.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541301
    m_Localized: Anslut till en väntande lobby innan du ändrar din redostatus.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541302
    m_Localized: Steam kunde inte uppdatera lobbylistan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541303
    m_Localized: Lobbylistan uppdateras redan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541304
    m_Localized: Endast lobbyvärden kan ta bort spelare.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541305
    m_Localized: Steam kunde inte slutföra lobbybegäran.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541306
    m_Localized: Återvänd till huvudmenyn innan du skapar en lobby.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541307
    m_Localized: Den här lobbyn är full.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541308
    m_Localized: Den här lobbyn är låst.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541309
    m_Localized: Endast värden kan ändra inställningar medan lobbyn väntar.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541310
    m_Localized: Lobbyinställningar saknas.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541311
    m_Localized: Lobbyinställningarna sparade.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541312
    m_Localized: Den här lobbyn är inte tillgänglig eller använder en äldre spelversion.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541313
    m_Localized: Endast värden kan häva bannlysningar.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541314
    m_Localized: Ange en giltig SUSHI-lobbykod.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541315
    m_Localized: Steam kunde inte uppdatera lobbyns synlighet.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541316
    m_Localized: Välj en giltig synlighet för lobbyn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541317
    m_Localized: Fel lobbylösenord.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541318
    m_Localized: Du är bannlyst från den här värdens lobbyer.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541319
    m_Localized: Lobbyvärden bannlyste dig.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541320
    m_Localized: Du togs bort. Vänta 30 sekunder innan du ansluter igen.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541321
    m_Localized: Du togs bort från lobbyn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541322
    m_Localized: Lobbyvärden tog bort dig.
    m_Metadata:
      m_Items: []
