    m_Localized: Tabellen återställdes
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111125
    m_Localized: Den översta ingrediensen matchar inte den i gastropanen
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111126
    m_Localized: Det finns inte tillräckligt med gastropaner för detta recept
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305408
    m_Localized: Det finns inget på bordet att hämta
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305409
    m_Localized: Denna ingrediens kan inte placeras i gastropanen
    m_Metadata:
      m_Items: []
