      m_Items: []
  - m_Id: 4233246647152651
    m_Localized: WEET JE HET ZEKER?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152652
    m_Localized: Bevestigen
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152653
    m_Localized: Deze actie heeft gevolgen voor de huidige lobby.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152654
    m_Localized: Steam-lobby
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152655
    m_Localized: Code kopiëren
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152656
    m_Localized: Maximaal 5 spelers. Wachtwoord en gereedheidscontrole staan in de lobbyinstellingen.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152657
    m_Localized: Zoek een team of maak een lobby om te beginnen.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152658
    m_Localized: Geef je lobby een naam en kies wie mag deelnemen. Je kunt de instellingen later wijzigen.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152659
    m_Localized: LOBBY MAKEN
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152660
    m_Localized: TEAM
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152661
    m_Localized: TEAM  {0}/{1}  •  {2}
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152662
    m_Localized: Zorg dat je klaar bent voordat de host een opgeslagen spel kiest.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152663
    m_Localized: Wacht tot je hele team klaar is.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152664
    m_Localized: "Geen lobby's gevonden.\nVernieuw de lijst, kijk bij Vrienden\nof maak een lobby voor je team."
    m_Metadata:
      m_Items: []
