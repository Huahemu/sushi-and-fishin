  - m_Id: 201706673623040
    m_Localized: Al schoon!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205952
    m_Localized: Kan het niet plaatsen!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205953
    m_Localized: Er is al een ander drankje neergezet.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205954
    m_Localized: Nieuwe plek voor eettafel vrijgemaakt
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205955
    m_Localized: Voltooi eerst de handleiding!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205956
    m_Localized: De koelkast zit vol.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205957
    m_Localized: Spel succesvol opgeslagen.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205958
    m_Localized: Ik heb het momenteel druk!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205959
    m_Localized: Het kan niet worden overgebracht naar de gastropan die u vasthoudt.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205960
    m_Localized: Ik verliet de lobby.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205961
    m_Localized: Geen lege plek.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205962
    m_Localized: Er is geen gratis snelvakje voor de vuilbak.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400256
    m_Localized: Geen vrije snelsleuf voor het dienblad.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400257
    m_Localized: Er ligt niets op tafel. Je mag geen mes gebruiken.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400258
    m_Localized: Er is niet genoeg geld om de transportband te repareren!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400259
    m_Localized: Niet genoeg geld om de tafel te repareren!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400260
    m_Localized: Hier mogen alleen rauwe ingrediënten worden gesneden.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400261
    m_Localized: Open eerst de koelkastdeur.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400262
    m_Localized: Bereik eerst het vereiste restaurantniveau.
    m_Metadata:
      m_Items: []
