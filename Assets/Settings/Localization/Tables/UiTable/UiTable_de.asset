    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152651
    m_Localized: BIST DU SICHER?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152652
    m_Localized: Bestätigen
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152653
    m_Localized: Diese Aktion betrifft die aktuelle Lobby.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152654
    m_Localized: Steam-Lobby
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152655
    m_Localized: Code kopieren
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152656
    m_Localized: Bis zu 5 Spieler. Passwort und Bereitschaftsprüfung findest du in den Lobby-Einstellungen.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152657
    m_Localized: Finde ein Team oder erstelle eine Lobby, um anzufangen.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152658
    m_Localized: Benenne deine Lobby und wähle, wer beitreten darf. Die Einstellungen kannst du später ändern.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152659
    m_Localized: LOBBY ERSTELLEN
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152660
    m_Localized: TEAM
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152661
    m_Localized: TEAM  {0}/{1}  •  {2}
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152662
    m_Localized: Sei bereit, bevor der Gastgeber einen Spielstand wählt.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152663
    m_Localized: Warte, bis dein gesamtes Team bereit ist.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152664
    m_Localized: "Keine Lobbys gefunden.\nAktualisiere die Liste, sieh unter Freunde nach\noder erstelle eine Lobby für dein Team."
    m_Metadata:
      m_Items: []
