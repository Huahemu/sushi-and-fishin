    m_Localized: Jogador expulso. Poderá voltar a entrar após 30 segundos.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541298
    m_Localized: Este jogador já saiu.
    m_Metadata:
      m_Items: []
