    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541251
    m_Localized: O anfitrião escolhe o jogo guardado. Todos viajam juntos.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541252
    m_Localized: 'Exigir que todos estejam prontos: {0}'
    m_Metadata:
      m_Items: []
