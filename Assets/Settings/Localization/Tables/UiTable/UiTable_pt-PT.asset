    m_Localized: A equipa está pronta. Escolhe um jogo guardado e zarpa com a equipa.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541254
    m_Localized: Atualizar
    m_Metadata:
      m_Items: []
