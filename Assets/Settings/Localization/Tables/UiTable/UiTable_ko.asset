    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152646
    m_Localized: X
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152647
    m_Localized: 참가 코드
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152648
    m_Localized: 참가 코드를 복사했습니다. 팀원에게 공유하세요.
    m_Metadata:
      m_Items: []
