    m_Metadata:
      m_Items: []
  - m_Id: 190972220755979
    m_Localized: RẠN NỨT VỰC SÂU
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755980
    m_Localized: CHIỀU SÂU BỊ LÃNG QUÊN
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755981
    m_Localized: VÙNG CHƯA BIẾT
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755982
    m_Localized: DÂY CÂU ĐÃ THẢ
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755983
    m_Localized: Đang chờ cá cắn câu.
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755984
    m_Localized: KHÔNG CÓ CÁ Ở ĐÂY
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755985
    m_Localized: Ở đây không có cá.
    m_Metadata:
      m_Items: []
  - m_Id: 201706673623040
    m_Localized: Đã sạch sẽ rồi!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205952
    m_Localized: Không thể đặt!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205953
    m_Localized: Đã chuẩn bị sẵn một loại đồ uống khác.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205954
    m_Localized: Đã mở khóa vị trí bàn ăn mới
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205955
    m_Localized: Trước tiên hãy hoàn thành hướng dẫn!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205956
    m_Localized: Tủ lạnh đầy rồi.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205957
    m_Localized: Trò chơi đã được lưu thành công.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205958
    m_Localized: Tôi đang bận!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205959
    m_Localized: Không thể chuyển vào Khay Gastronorm bạn đang cầm.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205960
    m_Localized: Rời khỏi sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205961
    m_Localized: Không còn chỗ trống.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205962
    m_Localized: Không có khe cắm nhanh trống dành cho khay bẩn.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400256
    m_Localized: Không có khe cắm nhanh trống cho khay.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400257
    m_Localized: Không được để bất cứ vật dụng nào trên bàn. Bạn không được dùng dao.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400258
    m_Localized: Không đủ tiền để sửa chữa băng chuyền!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400259
    m_Localized: Không đủ tiền để sửa bàn!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400260
    m_Localized: Tại đây chỉ được phép cắt các nguyên liệu thô.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400261
    m_Localized: Trước tiên hãy mở cửa tủ lạnh.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400262
    m_Localized: Trước tiên hãy đạt được cấp độ nhà hàng yêu cầu.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400263
    m_Localized: Công thức nấu ăn đã bắt đầu
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400264
    m_Localized: Công thức nấu ăn chưa được chọn
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400265
    m_Localized: Lưu không thành công.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400266
    m_Localized: Đã bỏ qua việc lưu.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400267
    m_Localized: Phiên làm việc đã kết thúc. Quay lại menu chính.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400268
    m_Localized: Kệ trống.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400269
    m_Localized: Kệ đầy.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400270
    m_Localized: Đã hết chỗ!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400271
    m_Localized: Trạm đã đầy, hãy dọn bớt chỗ.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400272
    m_Localized: Các thành phần khác nhau. Quá trình chuyển giao không thể hoàn tất.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400273
    m_Localized: Bàn đã được đặt lại.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400274
    m_Localized: Không thể vứt bỏ thứ này.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400275
    m_Localized: Kiểu cắt này không có sẵn cho mặt hàng này.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400276
    m_Localized: Vật phẩm này không thể cắt được.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400277
    m_Localized: Gia vị này đã hết.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400278
    m_Localized: Loại sushi này không được nêm gia vị.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400279
    m_Localized: Trước tiên hãy sử dụng máy lọc phi lê.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400280
    m_Localized: Đang chờ khách hàng khác đến.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400281
    m_Localized: Nhầm đồ uống rồi.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400282
    m_Localized: Sai mặt hàng.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400283
    m_Localized: Bạn có thể ngủ sau 21:00.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400284
    m_Localized: Bạn không thể chọn công thức nấu ăn ngay bây giờ.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400285
    m_Localized: Bạn không thể sử dụng vật phẩm đó ở đây.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400286
    m_Localized: Bạn cần một cây lao tốt hơn!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400287
    m_Localized: NHÀ HÀNG
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400288
