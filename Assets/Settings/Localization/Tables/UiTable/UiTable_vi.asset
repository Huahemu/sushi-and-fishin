    m_Metadata:
      m_Items: []
  - m_Id: 3355612031643656
    m_Localized: Trở lại nhà hàng
    m_Metadata:
      m_Items: []
  - m_Id: 3355612031643657
    m_Localized: Sản phẩm cần thiết chưa được mở khóa
    m_Metadata:
      m_Items: []
  - m_Id: 3355612031643658
    m_Localized: Rời đi sau khi hoàn thành nhiệm vụ hiện tại
    m_Metadata:
      m_Items: []
  - m_Id: 3355612031643659
