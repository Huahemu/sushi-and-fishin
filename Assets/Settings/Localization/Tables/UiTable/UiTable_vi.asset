  - m_Id: 4182497170976816
    m_Localized: Trang
    m_Metadata:
      m_Items: []
  - m_Id: 4182497170976817
    m_Localized: Trâm
    m_Metadata:
      m_Items: []
  - m_Id: 4182497170976818
    m_Localized: Yến
    m_Metadata:
      m_Items: []
  - m_Id: 4182497170976819
    m_Localized: Ứng viên này không còn khả dụng.
    m_Metadata:
      m_Items: []
  - m_Id: 4182497170976820
    m_Localized: Đã đạt giới hạn nhân viên cho vai trò {0}.
    m_Metadata:
      m_Items: []
  - m_Id: 4182497170976821
    m_Localized: Vai trò {0} chưa khả dụng.
    m_Metadata:
      m_Items: []
  - m_Id: 4182497170976822
    m_Localized: Không còn ngoại hình chưa dùng cho vai trò này.
    m_Metadata:
      m_Items: []
  - m_Id: 4182497170976823
    m_Localized: Nhân viên này không còn trong đội.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246613598208
    m_Localized: Sảnh Sushi
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958336
    m_Localized: Sảnh của {0}
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958337
    m_Localized: Đang chờ chủ phòng duyệt tham gia...
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958338
    m_Localized: Quay lại
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958339
    m_Localized: Cấm
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958340
    m_Localized: '{0} sẽ bị đuổi và không thể vào các sảnh của bạn cho đến khi bạn bỏ cấm tài khoản Steam của họ. Lệnh cấm vẫn có hiệu lực sau khi sảnh này đóng.'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958341
    m_Localized: Người chơi này sẽ bị đuổi và không thể vào các sảnh của bạn cho đến khi bạn bỏ cấm tài khoản Steam của họ. Lệnh cấm vẫn có hiệu lực sau khi sảnh này đóng.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958342
    m_Localized: CẤM NGƯỜI CHƠI?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958343
    m_Localized: Người chơi bị cấm
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958344
    m_Localized: NGƯỜI CHƠI BỊ CẤM
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958345
    m_Localized: Người chơi bị cấm ({0})
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152640
    m_Localized: Lệnh cấm áp dụng cho các sảnh của chủ phòng này đến khi được gỡ. Bỏ cấm sẽ cho phép tài khoản Steam đó tham gia lại.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152641
    m_Localized: Hủy
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152642
    m_Localized: Số người tối đa
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152643
    m_Localized: 'Sức chứa: {0} người'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152644
    m_Localized: 5 người
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152645
    m_Localized: BẮT ĐẦU TRÒ CHƠI
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152646
    m_Localized: X
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152647
    m_Localized: Mã tham gia
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152648
    m_Localized: Đã sao chép mã tham gia. Hãy chia sẻ với đồng đội.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152649
    m_Localized: Dán mã sảnh
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152650
    m_Localized: Nhập mã tham gia sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152651
    m_Localized: BẠN CHẮC CHỨ?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152652
    m_Localized: Xác nhận
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152653
    m_Localized: Thao tác này ảnh hưởng đến sảnh hiện tại.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152654
    m_Localized: Sảnh Steam
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152655
    m_Localized: Sao chép mã
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152656
    m_Localized: Tối đa 5 người. Mật khẩu và kiểm tra sẵn sàng nằm trong Cài đặt sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152657
    m_Localized: Tìm đội hoặc tạo sảnh để bắt đầu.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152658
    m_Localized: Đặt tên sảnh và chọn người được tham gia. Bạn có thể đổi cài đặt sau.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152659
    m_Localized: TẠO SẢNH
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152660
    m_Localized: ĐỘI
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152661
    m_Localized: ĐỘI  {0}/{1}  •  {2}
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152662
    m_Localized: Hãy sẵn sàng trước khi chủ phòng chọn bản lưu.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152663
    m_Localized: Chờ đến khi tất cả đồng đội đều sẵn sàng.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152664
    m_Localized: "Không tìm thấy sảnh.\nHãy làm mới, kiểm tra Bạn bè,\nhoặc tạo sảnh cho đội của bạn."
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152665
    m_Localized: Chỗ trống • Mời bạn bè vào đội
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152666
    m_Localized: TÌM ĐỘI
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152667
    m_Localized: BẠN BÈ
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152668
    m_Localized: Đội của bạn bè
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152669
    m_Localized: Bạn bè
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152670
    m_Localized: Chỉ bạn bè
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346944
    m_Localized: Đã đầy
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346945
    m_Localized: Khách
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346946
    m_Localized: Ẩn mật khẩu
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346947
    m_Localized: CHỦ PHÒNG
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346948
    m_Localized: CHỦ PHÒNG SẴN SÀNG
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346949
    m_Localized: Chọn sảnh, tham gia bằng mã hoặc tập hợp đội của riêng bạn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346950
    m_Localized: Mời bạn bè
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346951
    m_Localized: Dùng lớp phủ Steam để mời bạn bè. Bạn cũng có thể chia sẻ mã tham gia.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346952
    m_Localized: Tham gia
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346953
    m_Localized: THAM GIA BẰNG MÃ
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346954
    m_Localized: MÃ THAM GIA SẢNH
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346955
    m_Localized: Nhập mã sảnh mà chủ phòng đã chia sẻ với bạn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346956
    m_Localized: Tham gia {0}
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346957
    m_Localized: VÀO SẢNH
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346958
    m_Localized: THAM GIA ĐỘI
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346959
    m_Localized: Đã khóa người mới tham gia
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346960
    m_Localized: Đang nhận đồng đội mới
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346961
    m_Localized: 4–32 ký tự; để trống để giữ mật khẩu hiện tại
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346962
    m_Localized: Đuổi
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346963
    m_Localized: '{0} sẽ bị đuổi khỏi sảnh này. Họ có thể tham gia lại sau 30 giây nếu có quyền truy cập hoặc lời mời.'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346964
    m_Localized: ĐUỔI NGƯỜI CHƠI?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346965
    m_Localized: Mọi người phải sẵn sàng trước khi chủ phòng bắt đầu.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346966
    m_Localized: Rời sảnh
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346967
    m_Localized: Bạn sẽ trở về sảnh của mình. Có thể tham gia lại đội này bằng lời mời hoặc mã.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346968
    m_Localized: Bạn sẽ rời sảnh này. Đồng đội cũng sẽ trở về sảnh của họ. Các bản lưu được giữ nguyên.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346969
    m_Localized: RỜI ĐỘI NÀY?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346970
    m_Localized: SẢNH  /  ĐỘI  /  QUYỀN THAM GIA
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346971
    m_Localized: Chỉ hiển thị các sảnh tương thích. Số chỗ trống có thể thay đổi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346972
    m_Localized: '{0} sảnh • Số chỗ trống có thể thay đổi'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346973
    m_Localized: Tên sảnh
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346974
    m_Localized: 'Khóa người mới tham gia: Tắt'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346975
    m_Localized: 'Khóa người mới tham gia: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346976
    m_Localized: Đã khóa
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346977
    m_Localized: TẬP HỢP ĐỒNG ĐỘI
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346978
    m_Localized: Đội sushi của tôi
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346979
    m_Localized: Hãy đặt tên sảnh trước.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346980
    m_Localized: ESC / B  Quay lại     •     TAB / D-pad  Di chuyển •     ENTER / A  Chọn
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346981
    m_Localized: Không có người chơi bị cấm.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346982
    m_Localized: —
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346983
    m_Localized: KHÔNG CÓ SẢNH ĐANG HOẠT ĐỘNG
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346984
    m_Localized: "Không có sảnh bạn bè nào tham gia được.\nXin mã hoặc lời mời từ bạn bè,\nhoặc tạo sảnh của riêng bạn."
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346985
    m_Localized: Tạo sảnh hoặc tham gia đội khác.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346986
    m_Localized: "Không có sảnh phù hợp với tìm kiếm.\nHãy thử tên sảnh khác."
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346987
    m_Localized: Chưa sẵn sàng
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346988
    m_Localized: Tắt
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346989
    m_Localized: Bật
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346990
    m_Localized: Không có mật khẩu
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346991
    m_Localized: Steam không thể hoàn tất yêu cầu. Vui lòng thử lại.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346992
    m_Localized: Mật khẩu sảnh
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346993
    m_Localized: Mật khẩu (nếu cần)
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346994
    m_Localized: Nhập mật khẩu
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346995
    m_Localized: Mật khẩu của bạn không bao giờ xuất hiện trong danh sách sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346996
    m_Localized: Đang tham gia...
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346997
    m_Localized: '{0} người'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346998
    m_Localized: Riêng tư / chỉ qua lời mời
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346999
    m_Localized: Mật khẩu
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651347000
    m_Localized: Có mật khẩu bảo vệ
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541248
    m_Localized: Công khai
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541249
    m_Localized: SẴN SÀNG
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541250
    m_Localized: SẴN SÀNG
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541251
    m_Localized: Chủ phòng chọn bản lưu. Mọi người cùng khởi hành.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541252
    m_Localized: 'Yêu cầu tất cả sẵn sàng: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541253
    m_Localized: Đội đã sẵn sàng. Chọn bản lưu và cùng ra khơi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541254
    m_Localized: Làm mới
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541255
    m_Localized: 'Xóa mật khẩu: Không'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541256
    m_Localized: 'Xóa mật khẩu: Không'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541257
    m_Localized: 'Xóa mật khẩu: Có'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541258
    m_Localized: 'Yêu cầu tất cả sẵn sàng: Bật'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541259
    m_Localized: Chủ phòng đã thu hồi quyền tham gia của bạn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541260
    m_Localized: Quyền vào sảnh chưa được duyệt. Hãy tham gia lại bằng mã và mật khẩu sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541261
    m_Localized: Bạn đã ở trong sảnh này.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541262
    m_Localized: Đã bỏ cấm.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541263
    m_Localized: Một thao tác với sảnh đang được thực hiện.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541264
    m_Localized: Không thể đuổi chủ phòng.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541265
    m_Localized: Chọn sức chứa từ 1 đến 5 người.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541266
    m_Localized: Giới hạn người chơi không thể thấp hơn số thành viên hiện tại.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541267
    m_Localized: Kết nối Steam để xem các sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541268
    m_Localized: Kết nối Steam để tạo sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541269
    m_Localized: Kết nối Steam trước khi tham gia sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541270
    m_Localized: Đã sao chép mã sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541271
    m_Localized: Steam không thể tạo sảnh. Vui lòng thử lại.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541272
    m_Localized: Đã tạo sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541273
    m_Localized: Chủ phòng đang dùng phiên bản trò chơi khác.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541274
    m_Localized: Sảnh này chỉ dành cho bạn bè Steam của chủ phòng.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541275
    m_Localized: Steam không thể liên lạc với chủ phòng.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541276
    m_Localized: Chủ phòng đã rời sảnh. Đang trở về sảnh của bạn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541277
    m_Localized: Chủ phòng đang bắt đầu trò chơi. Hãy thử lại sau giây lát.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541278
    m_Localized: Chủ phòng không phản hồi. Vui lòng thử lại.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541279
    m_Localized: Không thể liên lạc với chủ phòng.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541280
    m_Localized: Không thể xác định danh tính Steam.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541281
    m_Localized: Sảnh này sử dụng phiên bản sảnh không tương thích.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541282
    m_Localized: Mã sảnh này không hợp lệ.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541283
    m_Localized: Đã hủy tham gia sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541284
    m_Localized: Steam không thể vào sảnh này. Kiểm tra mã và thử lại.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541285
    m_Localized: Đã tham gia sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541286
    m_Localized: Đã rời sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541287
    m_Localized: Steam không thể cập nhật khóa sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541288
    m_Localized: Tên sảnh có thể dài tối đa 32 ký tự.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541289
    m_Localized: Nhập tên sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541290
    m_Localized: Chủ phòng đã rời đi hoặc thay đổi trong lúc tham gia. Hãy dùng mã sảnh mới.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541291
    m_Localized: Chủ phòng đã thay đổi trong lúc tham gia. Vui lòng thử lại.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541292
    m_Localized: Mật khẩu không được chứa ký tự điều khiển.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541293
    m_Localized: Mật khẩu phải có 4–32 ký tự.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541294
    m_Localized: Mật khẩu quá dài.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541295
    m_Localized: Sảnh này yêu cầu mật khẩu.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541296
    m_Localized: Đã cấm người chơi. Lệnh cấm có hiệu lực đến khi bạn gỡ.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541297
    m_Localized: Đã đuổi người chơi. Họ có thể tham gia lại sau 30 giây.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541298
    m_Localized: Người chơi này đã rời đi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541299
    m_Localized: Steam không thể phê duyệt lời mời vào sảnh riêng tư.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541300
    m_Localized: Bạn đã thử quá nhiều lần. Vui lòng chờ một chút.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541301
    m_Localized: Hãy vào sảnh đang chờ trước khi thay đổi trạng thái sẵn sàng.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541302
    m_Localized: Steam không thể làm mới danh sách sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541303
    m_Localized: Danh sách sảnh đang được làm mới.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541304
    m_Localized: Chỉ chủ phòng có thể đuổi người chơi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541305
    m_Localized: Steam không thể hoàn tất yêu cầu với sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541306
    m_Localized: Trở về trình đơn chính trước khi tạo sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541307
    m_Localized: Sảnh này đã đầy.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541308
    m_Localized: Sảnh này đã khóa.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541309
    m_Localized: Chỉ chủ phòng có thể đổi cài đặt khi sảnh đang chờ.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541310
    m_Localized: Thiếu cài đặt sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541311
    m_Localized: Đã lưu cài đặt sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541312
    m_Localized: Sảnh này không khả dụng hoặc đang dùng phiên bản trò chơi cũ hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541313
    m_Localized: Chỉ chủ phòng có thể gỡ lệnh cấm.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541314
    m_Localized: Nhập mã sảnh SUSHI hợp lệ.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541315
    m_Localized: Steam không thể cập nhật chế độ hiển thị sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541316
    m_Localized: Chọn chế độ hiển thị sảnh hợp lệ.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541317
    m_Localized: Mật khẩu sảnh không đúng.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541318
    m_Localized: Bạn bị cấm vào các sảnh của chủ phòng này.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541319
    m_Localized: Bạn đã bị chủ phòng cấm.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541320
    m_Localized: Bạn đã bị đuổi. Chờ 30 giây trước khi tham gia lại.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541321
    m_Localized: Bạn đã bị đuổi khỏi sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541322
    m_Localized: Bạn đã bị chủ phòng đuổi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541323
    m_Localized: Tạo hoặc tham gia sảnh để xem cài đặt.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541324
    m_Localized: Lệnh cấm của chủ phòng có hiệu lực đến khi chủ phòng gỡ.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541325
    m_Localized: LƯU CÀI ĐẶT
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541326
    m_Localized: Tìm tên sảnh...
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541327
    m_Localized: Đang tìm đội...
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541328
    m_Localized: Chỗ trống • Sảnh đã khóa
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541329
    m_Localized: CÀI ĐẶT SẢNH
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541330
    m_Localized: Chỉ chủ phòng có thể đổi các cài đặt này. Thay đổi sẽ đặt lại trạng thái sẵn sàng của đội.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541331
    m_Localized: Hiện mật khẩu
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541332
    m_Localized: STEAM  •  Sảnh đội
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541333
    m_Localized: Ca làm vui vẻ bắt đầu từ một đội ăn ý.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541334
    m_Localized: Tạo sảnh sẽ khiến bạn rời đội hiện tại và trở về sảnh riêng.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541335
    m_Localized: RỜI ĐỘI HIỆN TẠI?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541336
    m_Localized: SẢNH ĐỘI
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541337
    m_Localized: Không có kết nối Steam
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541338
    m_Localized: Bỏ cấm
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541339
    m_Localized: '{0} sẽ được phép tham gia lại sảnh này.'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541340
    m_Localized: BỎ CẤM NGƯỜI CHƠI?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541341
    m_Localized: HỦY SẴN SÀNG
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541342
    m_Localized: Đã cập nhật thông tin sảnh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541343
    m_Localized: Ai có thể tham gia?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735552
    m_Localized: 'Công khai: có trong tìm kiếm. Bạn bè: bạn của chủ phòng. Riêng tư: cần lời mời hoặc mã.'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735553
    m_Localized: Mọi người phải sẵn sàng trước khi chọn bản lưu.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735554
    m_Localized: Đã sẵn sàng khởi hành. Đang chờ chủ phòng chọn bản lưu.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735555
    m_Localized: Đang chờ mọi người sẵn sàng. Đổi cài đặt sẽ đặt lại trạng thái sẵn sàng.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735556
    m_Localized: Đang kết nối Steam...
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735557
    m_Localized: Bạn là chủ phòng
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735558
    m_Localized: ' (bạn)'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735559
    m_Localized: ĐỘI CỦA BẠN
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735560
    m_Localized: SẢNH CỦA BẠN
    m_Metadata:
      m_Items: []
  - m_Id: 4437951319011328
    m_Localized: Chơi đơn
    m_Metadata:
      m_Items: []
  - m_Id: 4437951356760064
    m_Localized: Nhiều người chơi
    m_Metadata:
      m_Items: []
  - m_Id: 5082816511897600
    m_Localized: Bảo vệ vật phẩm trên kệ bếp
    m_Metadata:
      m_Items: []
  - m_Id: 5082816537063424
    m_Localized: Nhân viên kho sẽ không chuyển vật phẩm trên kệ này vào kho.
    m_Metadata:
      m_Items: []
  - m_Id: 5082816537063425
    m_Localized: Tất cả nhân viên kho
    m_Metadata:
      m_Items: []
  - m_Id: 5445132323549184
    m_Localized: Chợ đã đóng cửa
    m_Metadata:
      m_Items: []
  - m_Id: 5445132352909312
    m_Localized: Không có sản phẩm này tại chợ
    m_Metadata:
      m_Items: []
  - m_Id: 5445132352909313
    m_Localized: Không nhận được sản phẩm · Sẽ thử lại
    m_Metadata:
      m_Items: []
  - m_Id: 5453570634051584
    m_Localized: Kho không còn ô trống
    m_Metadata:
      m_Items: []
  - m_Id: 5453570663411712
    m_Localized: '{0} hộp · {1} vật phẩm bên trong · {2} hộp rỗng'
    m_Metadata:
      m_Items: []
  - m_Id: 5453570663411713
    m_Localized: 'Nhấp chuột trái: Lấy sản phẩm'
    m_Metadata:
      m_Items: []
  - m_Id: 5453570663411714
    m_Localized: 'Nhấp chuột phải: Lấy hộp rỗng'
    m_Metadata:
      m_Items: []
  - m_Id: 5453570663411715
    m_Localized: 'E: Sản phẩm tiếp theo'
    m_Metadata:
      m_Items: []
  - m_Id: 5455057326075904
    m_Localized: '{0} vật phẩm'
    m_Metadata:
      m_Items: []
  - m_Id: 5474489305821184
    m_Localized: Thu gom phi lê
    m_Metadata:
      m_Items: []
  - m_Id: 5489445828980736
    m_Localized: 'Nhấp chuột phải: Lấy 1 vật phẩm'
    m_Metadata:
      m_Items: []
  - m_Id: 5489445854146560
    m_Localized: 'Shift + nhấp chuột phải: Lấy hộp rỗng'
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681984
    m_Localized: 'Nhấp chuột trái: Thêm vật phẩm/hộp phù hợp đang cầm'
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681985
    m_Localized: Đủ nguyên liệu đã chuẩn bị
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681986
    m_Localized: 'Đang chờ nguyên liệu: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 5802907553656832
    m_Localized: Thu gom vật phẩm dưới bàn làm việc
    m_Metadata:
      m_Items: []
  - m_Id: 5802907578822656
    m_Localized: Nhân viên kho chuyển vật phẩm từ các kệ dưới của Bàn đầu bếp và Trạm chuẩn bị vào kho.
    m_Metadata:
      m_Items: []
  - m_Id: 5861529683914752
    m_Localized: BẢN CẬP NHẬT MỚI
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469184
    m_Localized: ĐÃ CÓ PHÒNG CHỜ
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469185
    m_Localized: "Tạo phòng chờ và mời bạn bè.\nCùng nhau bắt đầu cuộc phiêu lưu."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469186
    m_Localized: NHÂN VIÊN ĐÃ CÓ MẶT
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469187
    m_Localized: "Mở rộng đội ngũ và chia sẻ công việc.\nCùng nhau quản lý nhà hàng."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469188
    m_Localized: ĐÃ MỞ TRẬN ĐẤU TRÙM
    m_Metadata:
      m_Items: []
  - m_Id: 5861529721663488
    m_Localized: "Thách thức gã khổng lồ dưới đáy biển.\nGiờ bạn có thể chiến đấu với trùm!"
    m_Metadata:
      m_Items: []
  - m_Id: 5861529721663489
    m_Localized: BẮT ĐẦU NÀO!
    m_Metadata:
      m_Items: []
  - m_Id: 8317811728740352
    m_Localized: Sushi tùy chỉnh
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877696
    m_Localized: MAKI
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877697
    m_Localized: URAMAKI
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877698
    m_Localized: TEMAKI
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877699
    m_Localized: HOÀN TẤT
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877700
    m_Localized: LƯU
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877701
    m_Localized: TÊN CÔNG THỨC (KHÔNG BẮT BUỘC)
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877702
    m_Localized: Đặt tên
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877703
    m_Localized: Hủy
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877704
    m_Localized: Sushi tùy chỉnh {0} • Nhân {1}/{2}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877705
    m_Localized: Lưu công thức tùy chỉnh
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877706
    m_Localized: Chọn loại
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877707
    m_Localized: Thêm {0}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877708
    m_Localized: Hoàn tất sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877709
    m_Localized: Thêm nhân ({0}/{1}) hoặc hoàn tất sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877710
    m_Localized: Đặt lại sushi hiện tại trước khi đổi chế độ bàn.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877711
    m_Localized: Nguyên liệu này không thể dùng cho sushi tùy chỉnh
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072000
    m_Localized: Đặt nguyên liệu nền cần thiết trước
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072001
    m_Localized: Cơm và rong biển nori chỉ được dùng cho phần nền sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072002
    m_Localized: Sushi này đã có số lượng nhân tối đa
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072003
    m_Localized: Hoàn tất chế biến trước khi thay đổi sushi này
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072004
    m_Localized: Hãy chọn Maki, Uramaki hoặc Temaki trước
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072005
    m_Localized: Hoàn thiện phần nền sushi trước khi kết thúc
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072006
    m_Localized: Đã lưu công thức sushi tùy chỉnh
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072007
    m_Localized: Sushi này đã có công thức
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072008
    m_Localized: Không thể lưu công thức sushi tùy chỉnh
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072009
    m_Localized: Sushi đã sẵn sàng. Bạn có thể lưu công thức này.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072010
    m_Localized: Sushi đã sẵn sàng. Công thức này đã tồn tại và không thể lưu lại.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072011
    m_Localized: Bàn đã sẵn sàng để làm sushi tùy chỉnh tiếp theo
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072012
    m_Localized: Đã trả một nguyên liệu vào khay đựng trống.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072013
    m_Localized: Không đủ chỗ trong các khay đựng để dọn bàn. Hãy tạo chỗ trống rồi thử lại.
    m_Metadata:
      m_Items: []
  - m_Id: 9082457028980736
    m_Localized: Đã xóa công thức sushi tùy chỉnh
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535168
    m_Localized: Công thức này đang được dùng cho đơn gọi món của khách
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535169
    m_Localized: Công thức này hiện đang được chế biến
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535170
    m_Localized: Không thể xóa công thức này khi sushi đã làm vẫn còn trong kho
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535171
    m_Localized: Phải còn ít nhất một món sushi trong thực đơn
    m_Metadata:
      m_Items: []
