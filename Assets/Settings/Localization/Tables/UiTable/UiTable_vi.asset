    m_Metadata:
      m_Items: []
  - m_Id: 3355612031643662
    m_Localized: Sa thải nhân viên {0}? Mọi khoản tiền lương ngày chưa thanh toán sẽ được trừ vào số dư của nhà hàng. Nhân viên sẽ rời đi sau khi hoàn thành công việc hiện tại một cách an toàn.
    m_Metadata:
      m_Items: []
