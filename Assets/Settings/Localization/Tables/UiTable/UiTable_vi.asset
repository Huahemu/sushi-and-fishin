    m_Localized: Quét thẻ thanh toán tại băng chuyền
    m_Metadata:
      m_Items: []
  - m_Id: 3463817982275588
    m_Localized: Thu gom khay đựng thức ăn bẩn
    m_Metadata:
      m_Items: []
  - m_Id: 3463817982275589
