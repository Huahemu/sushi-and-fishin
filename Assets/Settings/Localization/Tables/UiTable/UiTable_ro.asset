    m_Localized: DA - REDUCEȚI MIȘCAREA
    m_Metadata:
      m_Items: []
  - m_Id: 5065000000000002
    m_Localized: NU - PĂSTRAȚI SETĂRILE IMPLICITE
    m_Metadata:
      m_Items: []
  - m_Id: 5065000000000003
    m_Localized: Puteți modifica aceste setări oricând în Setări > Confort cameră.
    m_Metadata:
      m_Items: []
  - m_Id: 4796205920256
    m_Localized: NU - PĂSTRAȚI SETĂRILE IMPLICITE
    m_Metadata:
      m_Items: []
  - m_Id: 4796205920257
    m_Localized: Puteți modifica aceste setări oricând în Setări > Confort cameră.
