      m_Items: []
  - m_Id: 979319247687686
    m_Localized: Probouzíme NPC...
    m_Metadata:
      m_Items: []
  - m_Id: 979319251881984
    m_Localized: Obnovujeme písek na pláži...
    m_Metadata:
      m_Items: []
  - m_Id: 979319251881985
    m_Localized: Učíme krevety osobnímu prostoru...
    m_Metadata:
      m_Items: []
  - m_Id: 979319251881986
    m_Localized: Leštíme drobné oblázky...
    m_Metadata:
      m_Items: []
  - m_Id: 979319251881987
    m_Localized: Přesvědčujeme palmy, aby stály v klidu...
    m_Metadata:
      m_Items: []
  - m_Id: 979319251881988
    m_Localized: Doplňujeme oceán, chvíli strpení...
    m_Metadata:
      m_Items: []
  - m_Id: 979319251881989
    m_Localized: Oprašujeme kouty města...
    m_Metadata:
      m_Items: []
  - m_Id: 979319251881990
    m_Localized: Vracíme stíny na jejich místa...
    m_Metadata:
      m_Items: []
  - m_Id: 979319256076288
    m_Localized: Kontrolujeme, zda se rackové přihlásili do práce...
    m_Metadata:
      m_Items: []
  - m_Id: 979319256076289
    m_Localized: Rozmotáváme neviditelné kabely dekorací...
    m_Metadata:
      m_Items: []
  - m_Id: 979319256076290
    m_Localized: Povzbuzujeme kameny na dnešní den...
    m_Metadata:
      m_Items: []
  - m_Id: 979319256076291
    m_Localized: Ručně přemalováváme sluneční světlo...
    m_Metadata:
      m_Items: []
