    m_Metadata:
      m_Items: []
  - m_Id: 157136514535433
    m_Localized: Päivitä tämä työkalu ensin.
    m_Metadata:
      m_Items: []
  - m_Id: 157136514535434
    m_Localized: Pelaajaa ei löytynyt.
    m_Metadata:
      m_Items: []
  - m_Id: 157136514535435
    m_Localized: Päivitä ensin edellinen taso.
    m_Metadata:
      m_Items: []
  - m_Id: 157136514535436
    m_Localized: Ei riitä raha ja romu.
    m_Metadata:
      m_Items: []
  - m_Id: 157136514535437
    m_Localized: Ei tarpeeksi rahaa.
    m_Metadata:
      m_Items: []
  - m_Id: 157136514535438
    m_Localized: Ei tarpeeksi romua.
    m_Metadata:
      m_Items: []
