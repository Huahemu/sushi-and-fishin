  - m_Id: 190972187201536
    m_Localized: ROSKAPOSTIA
    m_Metadata:
      m_Items: []
  - m_Id: 190972216561664
    m_Localized: PIDÄ ALHAALLA LUOVUTTAAKSESI
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755968
    m_Localized: JATKA KELAAMISTA
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755969
    m_Localized: PIDÄ HIIRI1-PAINIKETTA PAINETTA KELAADAKSESI SISÄÄN
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755970
    m_Localized: "<size=70%>KALA VETÄÄ <color=#{0}>VASENELLE</color></size>\n<b>SIIRRA HIIRTÄ <color=#{0}>OIKEALLE</color></b>"
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755971
    m_Localized: "<size=70%>KALAN VETTÄMINEN <color=#{0}>OIKEALLE</color></size>\n<b>SIIRRÄ HIIRIÄ <color=#{0}>VASEMMALE</color></b>"
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755972
    m_Localized: "<size=70%>KALA VETÄÄ <color=#{0}>POIS</color></size>\n<b>VEDÄ HIIRI <color=#{0}>TAAKSEPÄIN</color></b>"
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755973
    m_Localized: "<size=70%><color=#{0}>KALA ON VÄSYNYT</color></size>\n<b>{1}</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755974
    m_Localized: "<size=70%>SIIMA ON VAKAA</size>\n<b>{0}</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755975
    m_Localized: JOHDON RIKKI
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755976
    m_Localized: AURINGONVALOVYÖHYKE
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755977
    m_Localized: KESKIÄÄNEN
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755978
    m_Localized: SYVÄ VYÖHYKE
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755979
    m_Localized: ABYSSAALINEN HALKAUMA
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755980
    m_Localized: UNOHDETTU SYVYYS
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755981
    m_Localized: TUNTEMATON ALUE
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755982
    m_Localized: SIIMAA VEDESSÄ
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755983
    m_Localized: Odotan suupalaa.
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755984
    m_Localized: EI KALAA TÄÄLLÄ
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755985
    m_Localized: Täällä ei ole kaloja.
    m_Metadata:
      m_Items: []
  - m_Id: 201706673623040
    m_Localized: Jo siisti!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205952
    m_Localized: Ei voi sijoittaa!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205953
    m_Localized: Eri juoma on jo asetettu.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205954
    m_Localized: Uusi ruokapöydän paikka avattu
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205955
    m_Localized: Suorita ensin tutoriaali loppuun!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205956
    m_Localized: Jääkaappi on täynnä.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205957
    m_Localized: Peli tallennettu onnistuneesti.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205958
    m_Localized: Olen kiireinen juuri nyt!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205959
    m_Localized: Sitä ei voida siirtää kädessäsi olevaan gastropaniin.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205960
    m_Localized: Poistui aulasta.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205961
    m_Localized: Ei tyhjää paikkaa.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205962
    m_Localized: Ei vapaata pikapaikkaa likaiselle lokerolle.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400256
    m_Localized: Ei vapaata pikapaikkaa tarjottimelle.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400257
    m_Localized: Pöydällä ei ole mitään esineitä. Veistä ei saa käyttää.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400258
    m_Localized: Ei riitä rahat hihnakuljettimen korjaamiseen!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400259
    m_Localized: Ei rahat riitä pöydän korjaamiseen!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400260
    m_Localized: Vain raaka-aineita saa leikata täällä.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400261
    m_Localized: Avaa ensin jääkaapin ovi.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400262
    m_Localized: Saavuta ensin vaadittu ravintolataso.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400263
    m_Localized: Resepti on jo alkanut
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400264
    m_Localized: Reseptiä ei ole valittu
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400265
    m_Localized: Tallennus epäonnistui.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400266
    m_Localized: Tallennus ohitettu.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400267
    m_Localized: Istunto päättyi. Palasi päävalikkoon.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400268
    m_Localized: Hylly tyhjä.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400269
    m_Localized: Hylly täynnä.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400270
    m_Localized: Paikat ovat täynnä!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400271
    m_Localized: Asema on täynnä, raivaa tilaa
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400272
    m_Localized: Ainesosat ovat erilaiset. Siirtoa ei voida suorittaa loppuun.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400273
    m_Localized: Taulukko on nollattu
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400274
    m_Localized: Tätä ei voi heittää roskiin.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400275
    m_Localized: Tämä leikkaustyyppi ei ole saatavilla tälle tuotteelle.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400276
    m_Localized: Tätä kohdetta ei voi leikata.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400277
    m_Localized: Tämä mauste on tyhjä
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400278
    m_Localized: Tätä sushityyppiä ei voi maustaa.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400279
    m_Localized: Käytä ensin fileointikonetta
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400280
    m_Localized: Odotellaan muiden asiakkaiden saapumista.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400281
    m_Localized: Väärä juoma.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400282
    m_Localized: Väärä kohde.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400283
    m_Localized: Voit nukkua klo 21 jälkeen
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400284
    m_Localized: Et voi valita reseptiä juuri nyt
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400285
    m_Localized: Et voi käyttää kyseistä tuotetta täällä
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400286
    m_Localized: Tarvitset paremman harppuunan!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400287
    m_Localized: RAVINTOLA
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400288
    m_Localized: Tänään ei tule enää enempää asiakkaita.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400289
    m_Localized: Asiakkaita ei tule ravintolan ollessa suljettuna.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400290
    m_Localized: VALIKKO ON TYHJÄ
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400291
    m_Localized: Lisää ainakin yksi sushi ruokalistalle. Ruokailevat asiakkaat eivät saavu paikalle.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400292
    m_Localized: Paine
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400293
    m_Localized: Liian syvää varusteillesi!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400294
    m_Localized: AVOIMET VEDET EDESSÄ
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400295
    m_Localized: Paluu turvallisille vesille.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400296
    m_Localized: Ravintolan taso {0}
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400297
    m_Localized: 'Lukitsematon: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400298
    m_Localized: 'Markkinatuote avattu: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400299
    m_Localized: '{0} avattu'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400300
    m_Localized: 'Taulukko {0}: Tilaus vastaanotettu.'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400301
    m_Localized: '{0} nappasi'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400302
    m_Localized: PIDÄ PÄÄSTÄKSESI
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400303
    m_Localized: PIDÄ PÄÄSTÄ PELASTAAKSESI
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400304
    m_Localized: Järjestelmä
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400305
    m_Localized: Tiedot
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400306
    m_Localized: Ravintola
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400307
    m_Localized: Yhdistetty aulakeskusteluun.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400308
    m_Localized: '{0} liittyi aulaan.'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400309
    m_Localized: '{0} poistui aulasta.'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400310
    m_Localized: 'Paras isäntäsuositus: {0} (huonoin ping {1} ms, keskimääräinen ping {2} ms, vakaa FPS {3}).'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400311
    m_Localized: Peli tallennettu.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400312
    m_Localized: '{0} jäi jumiin.'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400313
    m_Localized: '{0} jäi loukkuun kohteen {1} kohdalle.'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400314
    m_Localized: hai
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400315
    m_Localized: mustekala-ansa
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400316
    m_Localized: meduusaloukku
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400317
    m_Localized: '{0} sai pyydykseen {1}, {2} kg.'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400318
    m_Localized: '{0} hukkui {1}:ään.'
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400319
    m_Localized: Kuljettimen istuin {0} on valmis ruokaa varten.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400320
    m_Localized: Kuljettimen istuin {0} on valmis maksua varten.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400321
    m_Localized: Ravintola on nyt auki.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400322
    m_Localized: Ravintola on nyt suljettu.
