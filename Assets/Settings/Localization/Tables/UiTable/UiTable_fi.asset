    m_Metadata:
      m_Items: []
  - m_Id: 5474489305821184
    m_Localized: Kerää fileet
    m_Metadata:
      m_Items: []
  - m_Id: 5489445828980736
    m_Localized: 'Oikea painike: Ota 1 tuote'
    m_Metadata:
      m_Items: []
  - m_Id: 5489445854146560
    m_Localized: 'Vaihto + oikea painike: Ota tyhjä pakkaus'
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681984
    m_Localized: 'Vasen painike: Lisää sopiva kädessä oleva tuote/laatikko'
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681985
    m_Localized: Riittävästi valmisteltuja ainesosia
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681986
    m_Localized: 'Odotetaan ainesosia: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 5802907553656832
    m_Localized: Kerää työpisteiden alla olevat tavarat
    m_Metadata:
      m_Items: []
  - m_Id: 5802907578822656
    m_Localized: Varastotyöntekijät vievät ChefDesk- ja Prep Station -työpisteiden alahyllyjen tavarat varastoon.
    m_Metadata:
      m_Items: []
  - m_Id: 5861529683914752
    m_Localized: UUSI PÄIVITYS
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469184
    m_Localized: AULAT OVAT TÄÄLLÄ
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469185
    m_Localized: "Luo aula ja kutsu ystäväsi.\nAloittakaa seikkailu yhdessä."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469186
    m_Localized: TYÖNTEKIJÄT SAAPUVAT
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469187
    m_Localized: "Kasvata tiimiä ja jaa tehtävät.\nPyörittäkää ravintolaa yhdessä."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469188
    m_Localized: POMOTAISTELU AVAUTUI
    m_Metadata:
      m_Items: []
  - m_Id: 5861529721663488
    m_Localized: "Haasta syvyyksien jättiläinen.\nVoit nyt taistella pomoa vastaan!"
    m_Metadata:
      m_Items: []
  - m_Id: 5861529721663489
    m_Localized: ALOITETAAN!
    m_Metadata:
      m_Items: []
  - m_Id: 8317811728740352
    m_Localized: Oma sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877696
