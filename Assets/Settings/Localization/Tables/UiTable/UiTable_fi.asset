  - m_Id: 48873911775238
    m_Localized: Resepti
    m_Metadata:
      m_Items: []
  - m_Id: 48873911775239
    m_Localized: Onko pöytä jumissa?
    m_Metadata:
      m_Items: []
  - m_Id: 48873911775240
    m_Localized: Nollaa työalue palauttaaksesi jumiutuneen kokin pöydän.
