      m_Items: []
  - m_Id: 5010362034741248
    m_Localized: Steam on offline-tilassa. Yhdistä Steamiin uudelleen ja yritä uudelleen.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362055712768
    m_Localized: Steam-aulaa ei voitu luoda. Yritä uudelleen.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362055712769
    m_Localized: Steam-aulaan liittyminen ei onnistunut. Yritä liittymistä uudelleen kutsun kautta.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362055712770
    m_Localized: Aula on täynnä.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362055712771
    m_Localized: Isäntä ei ole enää käytettävissä.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362055712772
    m_Localized: Peli-istuntoa ei voitu aloittaa isäntänä.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907072
    m_Localized: Yhteyttä isäntään ei voitu aloittaa.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907073
    m_Localized: Yhteys aikakatkaistiin. Yritä uudelleen.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907074
    m_Localized: Peliversiosi ei vastaa isäntää. Päivitä peli ja yritä uudelleen.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907075
    m_Localized: Tämä istunto käyttää yhteensopimatonta moninpeliprotokollaa.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907076
    m_Localized: Steam ei voinut vahvistaa tätä yhteyttä.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907077
    m_Localized: Sinulla ei ole oikeutta liittyä tähän istuntoon.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907078
    m_Localized: Sinua on estetty liittymästä tähän istuntoon.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907079
    m_Localized: Tämä moninpeli on vanhentunut.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907080
    m_Localized: Isäntä aloitti eri istunnon. Liity uudelleen.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907081
    m_Localized: Pelin käynnistyksen valmistelua ei voitu suorittaa loppuun. Yritä uudelleen.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907082
    m_Localized: Pelidataa ei voitu synkronoida.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907083
    m_Localized: Verkkoyhteys katkesi.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907084
    m_Localized: Yhteyttä ei voitu palauttaa.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907085
    m_Localized: Moninpeli-istuntoa ei voitu suorittaa loppuun.
    m_Metadata:
      m_Items: []
  - m_Id: 5054474567782400
    m_Localized: Roskakoriin?
    m_Metadata:
      m_Items: []
  - m_Id: 5054474609725440
    m_Localized: Tässä esineessä on vielä ruokaa. Haluatko varmasti heittää sen pois?
    m_Metadata:
      m_Items: []
  - m_Id: 5054474609725441
    m_Localized: Haluatko varmasti heittää tämän esineen pois?
    m_Metadata:
      m_Items: []
  - m_Id: 5065000000000000
    m_Localized: Onko sinulla matkapahoinvointia?
    m_Metadata:
      m_Items: []
  - m_Id: 5065000000000001
    m_Localized: KYLLÄ - VÄHENNÄ LIIKETTÄ
    m_Metadata:
      m_Items: []
  - m_Id: 5065000000000002
    m_Localized: EI - SÄILYTÄ OLETUSASETUKSET
    m_Metadata:
      m_Items: []
  - m_Id: 5065000000000003
    m_Localized: Voit muuttaa näitä asetuksia milloin tahansa kohdassa Asetukset > Kameran mukavuus.
    m_Metadata:
      m_Items: []
