  - m_Id: 8317811774877699
    m_Localized: VIIMEISTELE
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877700
    m_Localized: TALLENNA
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877701
    m_Localized: RESEPTIN NIMI (VALINNAINEN)
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877702
    m_Localized: Anna nimi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877703
    m_Localized: Peruuta
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877704
    m_Localized: Oma {0}-sushi • Täytteet {1}/{2}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877705
    m_Localized: Tallenna oma resepti
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877706
    m_Localized: Valitse tyyppi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877707
    m_Localized: Lisää {0}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877708
    m_Localized: Viimeistele sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877709
    m_Localized: Lisää täyte ({0}/{1}) tai viimeistele sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877710
    m_Localized: Nollaa nykyinen sushi ennen pöydän tilan vaihtamista.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877711
    m_Localized: Tätä ainesosaa ei voi käyttää omaan sushiin
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072000
    m_Localized: Aseta ensin vaadittu pohja-ainesosa
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072001
    m_Localized: Riisiä ja noria voi käyttää vain sushin pohjassa
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072002
    m_Localized: Tässä sushissa on jo enimmäismäärä täytteitä
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072003
    m_Localized: Viimeistele valmistelu ennen tämän sushin muuttamista
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072004
    m_Localized: Valitse ensin Maki, Uramaki tai Temaki
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072005
    m_Localized: Tee sushin pohja valmiiksi ennen viimeistelyä
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072006
    m_Localized: Oman sushin resepti tallennettu
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072007
    m_Localized: Tälle sushille on jo resepti
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072008
    m_Localized: Oman sushin reseptiä ei voitu tallentaa
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072009
    m_Localized: Sushi on valmis. Voit tallentaa tämän reseptin.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072010
    m_Localized: Sushi on valmis. Tämä resepti on jo olemassa, eikä sitä voi tallentaa uudelleen.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072011
    m_Localized: Pöytä on valmis seuraavaa omaa sushia varten
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072012
    m_Localized: Yksi ainesosa palautettiin tyhjään GN-astiaan.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072013
    m_Localized: GN-astioissa ei ole tarpeeksi tilaa pöydän tyhjentämiseen. Tee tilaa ja yritä uudelleen.
    m_Metadata:
      m_Items: []
  - m_Id: 9082457028980736
    m_Localized: Oman sushin resepti poistettu
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535168
    m_Localized: Tätä reseptiä käytetään asiakastilauksessa
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535169
    m_Localized: Tätä reseptiä valmistetaan parhaillaan
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535170
    m_Localized: Tätä reseptiä ei voi poistaa, kun valmista sushia on vielä varastossa
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535171
    m_Localized: Ruokalistalle on jäätävä vähintään yksi sushi
    m_Metadata:
      m_Items: []
