    m_Localized: Rikkoutunut jääkaappi
    m_Metadata:
      m_Items: []
  - m_Id: 3603310730891264
    m_Localized: Jo kokkaamassa
    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417216
    m_Localized: Kone on tyhjä
    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417217
    m_Localized: Avaa kansi
    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417218
    m_Localized: Riisi ei ole vielä kypsennetty
    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417219
    m_Localized: Keitettyä riisiä ei ole määritetty
    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417220
    m_Localized: Paikat ovat täynnä
    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417221
    m_Localized: Riisi on jo kypsennetty
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611520
    m_Localized: Keitetty riisi on sisällä
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611521
    m_Localized: Riisi on jo sisällä
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611522
    m_Localized: Vain raakaa riisiä
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611523
    m_Localized: Pakkaus on tyhjä
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611524
    m_Localized: Laita ensin kala koneeseen.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611525
    m_Localized: Fileointikone on jo käynnissä.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611526
    m_Localized: Kerää fileet ennen kuin viet kalat takaisin.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611527
    m_Localized: Kalaa lastataan jo.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611528
    m_Localized: Sinun täytyy ensin pitää kalaa kädessäsi.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611529
    m_Localized: Fileointikoneeseen saa laittaa vain kalaa.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611530
    m_Localized: Tätä kalaa ei voida lastata juuri nyt.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611531
    m_Localized: Fileen tuloste puuttuu.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611532
    m_Localized: Ei tilaa varastossa.
    m_Metadata:
      m_Items: []
  - m_Id: 3845566217932800
    m_Localized: Harppuunatasosi ei ole tarpeeksi korkea. Kokeile sitä ystäviesi kanssa!
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000018
    m_Localized: Olen tämän kaupan omistaja ja minulla on paljon hyödyllisiä työkaluja sinulle. Haluatko nähdä?
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000019
    m_Localized: Totta kai! Voit ottaa täältä harppuunan ja sukelluspuvun. Se auttaa matkaasi!
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000011
    m_Localized: Säiliö on tyhjä.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000012
    m_Localized: Säiliö on täynnä.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000017
    m_Localized: Tämä jääkaappi pitäisi ensin korjata.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000014
    m_Localized: Tätä esinettä ei voi asettaa tarjottimelle.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000015
    m_Localized: Tämä kohde ei kuulu tähän säiliöön.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000016
    m_Localized: Tätä toimintoa ei voida suorittaa loppuun.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000013
    m_Localized: Lokeropaikka on jo varattu.
    m_Metadata:
      m_Items: []
  - m_Id: 1445722421547009
    m_Localized: Hyväksyä
    m_Metadata:
      m_Items: []
  - m_Id: 1445722421547008
    m_Localized: Peruuttaa
    m_Metadata:
      m_Items: []
