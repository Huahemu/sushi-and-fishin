    m_Metadata:
      m_Items: []
  - m_Id: 190972220755983
    m_Localized: Balığın ısırması bekleniyor.
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755984
    m_Localized: BURADA BALIK YOK
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755985
    m_Localized: Burada balık bulunmuyor.
    m_Metadata:
      m_Items: []
  - m_Id: 201706673623040
    m_Localized: Zaten temiz!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205952
    m_Localized: Yerleştirilemez!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205953
    m_Localized: Buraya farklı bir içecek konmuş.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205954
    m_Localized: Yeni yemek masası yuvası açıldı
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205955
    m_Localized: Önce öğreticiyi tamamla!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205956
    m_Localized: Buzdolabı dolu.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205957
    m_Localized: Oyun başarıyla kaydedildi.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205958
    m_Localized: Şu anda meşgulüm!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205959
    m_Localized: Tuttuğun gastronorm kaba aktarılamaz.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205960
    m_Localized: Lobiden ayrıldın.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205961
    m_Localized: Boş yuva yok.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205962
    m_Localized: Kirli tepsi için boş hızlı yuva yok.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400256
    m_Localized: Tepsi için boş hızlı yuva yok.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400257
    m_Localized: Masada eşya yok. Bıçak kullanamazsın.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400258
    m_Localized: Konveyör Bandını onarmak için yeterli paran yok!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400259
    m_Localized: Masayı onarmak için yeterli paran yok!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400260
    m_Localized: Burada yalnızca çiğ malzemeler kesilebilir.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400261
    m_Localized: Önce buzdolabının kapağını aç.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400262
    m_Localized: Önce gerekli restoran seviyesine ulaş.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400263
    m_Localized: Tarif zaten başladı
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400264
    m_Localized: Tarif seçilmedi
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400265
    m_Localized: Kaydetme başarısız.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400266
    m_Localized: Kaydetme atlandı.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400267
    m_Localized: Oturum sona erdi. Ana menüye dönüldü.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400268
    m_Localized: Raf boş.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400269
    m_Localized: Raf dolu.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400270
    m_Localized: Yuvalar dolu!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400271
    m_Localized: İstasyon dolu, biraz yer aç
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400272
    m_Localized: Malzemeler farklı. Aktarım tamamlanamaz.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400273
    m_Localized: Masa sıfırlandı
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400274
    m_Localized: Bu çöpe atılamaz.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400275
    m_Localized: Bu kesim türü bu eşya için kullanılamaz.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400276
    m_Localized: Bu eşya kesilemez.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400277
    m_Localized: Bu baharat boş
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400278
    m_Localized: Bu suşi türüne baharat eklenemez.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400279
    m_Localized: Önce fileto makinesini kullan
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400280
    m_Localized: Diğer müşterilerin gelmesi bekleniyor.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400281
    m_Localized: Yanlış içecek.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400282
    m_Localized: Yanlış eşya.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400283
    m_Localized: 21:00'den sonra uyuyabilirsin
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400284
    m_Localized: Şu anda tarif seçemezsin
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400285
    m_Localized: Bu eşyayı burada kullanamazsın
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400286
    m_Localized: Daha iyi bir zıpkına ihtiyacın var!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400287
    m_Localized: RESTORAN
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400288
    m_Localized: Bugün artık başka müşteri gelmeyecek.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400289
    m_Localized: Restoran kapalıyken müşteriler gelmez.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400290
    m_Localized: MENÜ BOŞ
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400291
    m_Localized: Menüye en az bir suşi ekle. Aksi halde yemek müşterileri gelmez.
    m_Metadata:
      m_Items: []
