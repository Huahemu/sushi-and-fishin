    m_Localized: Aynı tarife devam ediliyor
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111121
    m_Localized: Şef tezgâhını kullanan kimse olmadığı için suşi tamamlanamadı
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111122
    m_Localized: Bir hata nedeniyle suşi tamamlanamadı
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111123
    m_Localized: Suşi artık tezgâhta değil.
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111124
    m_Localized: Tezgâh başarıyla sıfırlandı
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111125
    m_Localized: En üstteki malzeme gastropandakiyle eşleşmiyor
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111126
    m_Localized: Bu tarif için yeterli gastropan yok
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305408
    m_Localized: Tezgâhta alınacak bir şey yok
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305409
    m_Localized: Bu malzeme gastropana yerleştirilemez
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305410
    m_Localized: Gerekli malzeme bu değil
    m_Metadata:
      m_Items: []
