  - m_Id: 38711528419328
    m_Localized: Tarifteki bir malzeme gastropana yerleştirilemiyor
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111104
    m_Localized: Tarifi değiştirmeden önce ortadaki suşiyi kaldır
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111105
    m_Localized: Yeni bir suşi yapmadan önce ortadaki suşiyi kaldır
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111106
    m_Localized: Suşiyi koyacak yer yok. Ortada kalacak
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111107
    m_Localized: İşlem tamamlanamadı
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111108
    m_Localized: Tarifin gastropanları dolduruldu
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111109
    m_Localized: Önce bir tarif seç
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111110
    m_Localized: Mevcut tarif doğrulanamadı
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111111
    m_Localized: Gastropan boş
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111112
    m_Localized: Gastropan boş. Onu alamazsın
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111113
    m_Localized: Gastropan dolu, daha fazla malzeme alamaz.
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111114
    m_Localized: Elindeki gastropan boş. Malzeme aktaramazsın
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111115
    m_Localized: Paket boş. Malzeme aktaramazsın
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111116
    m_Localized: Yerleştirilen malzemeler bu tarifin başlangıcıyla eşleşmiyor
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111117
    m_Localized: Bir hata nedeniyle tarif seçilemedi
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111118
    m_Localized: Tarif zaten tamamlandı
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111119
    m_Localized: Tarif henüz tamamlanmadı
    m_Metadata:
      m_Items: []
