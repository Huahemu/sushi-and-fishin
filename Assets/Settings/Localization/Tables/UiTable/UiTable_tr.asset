    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535170
    m_Localized: Hazırlanmış sushi stokta olduğu sürece bu tarif silinemez
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535171
    m_Localized: Menüde en az bir sushi kalmalı
