    m_Localized: Özel tarifi kaydet
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877706
    m_Localized: Tür Seç
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877707
    m_Localized: '{0} ekle'
    m_Metadata:
      m_Items: []
