    m_Metadata:
      m_Items: []
  - m_Id: 979319247687686
    m_Localized: NPC'ler uyandırılıyor...
    m_Metadata:
      m_Items: []
  - m_Id: 979319251881984
    m_Localized: Sahil kumu yenileniyor...
    m_Metadata:
      m_Items: []
  - m_Id: 979319251881985
    m_Localized: Karideslere kişisel alan öğretiliyor...
    m_Metadata:
      m_Items: []
  - m_Id: 979319251881986
    m_Localized: Minik çakıl taşları parlatılıyor...
    m_Metadata:
      m_Items: []
