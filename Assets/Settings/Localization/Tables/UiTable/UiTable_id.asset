    m_Localized: LOBI SUDAH HADIR
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469185
    m_Localized: "Buat lobi dan undang temanmu.\nMulai petualangan bersama."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469186
    m_Localized: STAF SUDAH HADIR
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469187
    m_Localized: "Perbesar tim dan bagi tugas.\nKelola restoranmu bersama."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469188
