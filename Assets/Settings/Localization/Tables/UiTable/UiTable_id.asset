    m_Localized: YA - KURANGI GERAKAN
    m_Metadata:
      m_Items: []
  - m_Id: 5065000000000002
    m_Localized: TIDAK - PERTAHANKAN PENGATURAN BAWAH
    m_Metadata:
      m_Items: []
  - m_Id: 5065000000000003
    m_Localized: Anda dapat mengubah pengaturan ini kapan saja di Pengaturan > Kenyamanan Kamera.
    m_Metadata:
      m_Items: []
  - m_Id: 4796205920256
    m_Localized: TIDAK - PERTAHANKAN PENGATURAN BAWAAN
