    m_Localized: X
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152647
    m_Localized: Kode bergabung
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152648
    m_Localized: Kode bergabung disalin. Bagikan ke timmu.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152649
    m_Localized: Tempel kode lobi
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152650
    m_Localized: Masukkan kode bergabung lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152651
    m_Localized: YAKIN?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152652
    m_Localized: Konfirmasi
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152653
    m_Localized: Tindakan ini memengaruhi lobi saat ini.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152654
    m_Localized: Lobi Steam
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152655
    m_Localized: Salin kode
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152656
    m_Localized: Maksimal 5 pemain. Kata sandi dan pemeriksaan kesiapan ada di Pengaturan lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152657
    m_Localized: Cari tim atau buat lobi untuk memulai.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152658
    m_Localized: Beri nama lobimu dan atur siapa yang boleh bergabung. Pengaturan bisa diubah nanti.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152659
    m_Localized: BUAT LOBI
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152660
    m_Localized: TIM
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152661
    m_Localized: TIM  {0}/{1}  •  {2}
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152662
    m_Localized: Bersiaplah sebelum host memilih simpanan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152663
    m_Localized: Tunggu sampai semua anggota timmu siap.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152664
    m_Localized: "Tidak ada lobi ditemukan.\nCoba muat ulang, periksa Teman,\natau buat lobi untuk timmu."
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152665
    m_Localized: Tempat kosong • Undang teman untuk bergabung dengan tim
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152666
    m_Localized: CARI TIM
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152667
    m_Localized: TEMAN
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152668
    m_Localized: Tim teman
    m_Metadata:
      m_Items: []
