    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152670
    m_Localized: Hanya teman
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346944
    m_Localized: Penuh
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346945
    m_Localized: Tamu
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346946
    m_Localized: Sembunyikan kata sandi
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346947
    m_Localized: HOST
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346948
    m_Localized: HOST SIAP
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346949
    m_Localized: Pilih lobi, bergabung dengan kode, atau kumpulkan timmu sendiri.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346950
    m_Localized: Undang teman
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346951
    m_Localized: Gunakan overlay Steam untuk mengundang teman. Kamu juga bisa membagikan kode bergabung.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346952
    m_Localized: Gabung
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346953
