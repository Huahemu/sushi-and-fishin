      m_Items: []
  - m_Id: 4233246642958340
    m_Localized: '{0} akan dikeluarkan dan diblokir dari semua lobimu sampai kamu membuka blokir akun Steam-nya. Blokir tetap berlaku setelah lobi ini ditutup.'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958341
    m_Localized: Pemain ini akan dikeluarkan dan diblokir dari semua lobimu sampai kamu membuka blokir akun Steam-nya. Blokir tetap berlaku setelah lobi ini ditutup.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958342
