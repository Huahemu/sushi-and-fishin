  - m_Id: 8317811774877704
    m_Localized: Sushi Tersuai {0} • Inti {1}/{2}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877705
    m_Localized: Simpan resipi tersuai
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877706
    m_Localized: Pilih Jenis
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877707
    m_Localized: Tambah {0}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877708
    m_Localized: Siapkan sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877709
    m_Localized: Tambah inti ({0}/{1}) atau siapkan sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877710
    m_Localized: Tetapkan semula sushi semasa sebelum menukar mod meja.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877711
    m_Localized: Bahan ini tidak boleh digunakan untuk sushi tersuai
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072000
    m_Localized: Letakkan bahan asas yang diperlukan dahulu
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072001
    m_Localized: Nasi dan nori hanya boleh digunakan pada asas sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072002
    m_Localized: Sushi ini sudah mempunyai bilangan inti maksimum
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072003
    m_Localized: Selesaikan penyediaan sebelum mengubah sushi ini
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072004
    m_Localized: Pilih Maki, Uramaki atau Temaki dahulu
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072005
    m_Localized: Lengkapkan asas sushi sebelum menyiapkannya
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072006
    m_Localized: Resipi sushi tersuai disimpan
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072007
    m_Localized: Sushi ini sudah mempunyai resipi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072008
    m_Localized: Resipi sushi tersuai tidak dapat disimpan
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072009
    m_Localized: Sushi sudah siap. Anda boleh menyimpan resipi ini.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072010
    m_Localized: Sushi sudah siap. Resipi ini sudah wujud dan tidak boleh disimpan lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072011
    m_Localized: Meja sedia untuk menyediakan sushi tersuai yang lain
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072012
    m_Localized: Satu bahan telah dikembalikan ke dalam bekas gastropan kosong.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072013
    m_Localized: Ruang dalam bekas gastropan tidak mencukupi untuk mengosongkan meja. Kosongkan ruang dan cuba lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 9082457028980736
    m_Localized: Resipi sushi tersuai dipadam
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535168
    m_Localized: Resipi ini sedang digunakan dalam pesanan pelanggan
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535169
    m_Localized: Resipi ini sedang disediakan
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535170
    m_Localized: Resipi ini tidak boleh dipadam selagi sushi yang telah disediakan masih ada dalam stok
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535171
    m_Localized: Sekurang-kurangnya satu sushi mesti kekal dalam menu
    m_Metadata:
      m_Items: []
