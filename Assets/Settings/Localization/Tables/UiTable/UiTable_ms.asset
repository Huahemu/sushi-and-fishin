      m_Items: []
  - m_Id: 3603310789611522
    m_Localized: Hanya beras mentah
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611523
    m_Localized: Pek itu kosong
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611524
    m_Localized: Letakkan seekor ikan ke dalam mesin terlebih dahulu.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611525
    m_Localized: Mesin fillet sudah berjalan.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611526
    m_Localized: Kumpulkan isi ikan sebelum mengambil ikan kembali.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611527
    m_Localized: Ikan sudah dimuatkan.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611528
    m_Localized: Anda perlu memegang ikan terlebih dahulu.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611529
    m_Localized: Hanya ikan sahaja yang boleh dimasukkan ke dalam mesin fillet.
    m_Metadata:
      m_Items: []
