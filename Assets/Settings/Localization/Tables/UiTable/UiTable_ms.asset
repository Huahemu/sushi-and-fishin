    m_Localized: Minuman berbeza sudah diletakkan.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205954
    m_Localized: Slot meja makan baharu dibuka
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205955
    m_Localized: Selesaikan tutorial terlebih dahulu!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205956
    m_Localized: Peti sejuk penuh.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205957
    m_Localized: Permainan berjaya disimpan.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205958
    m_Localized: Saya sibuk sekarang!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205959
    m_Localized: Ia tidak boleh dipindahkan ke gastropan yang anda pegang.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205960
    m_Localized: Meninggalkan lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205961
    m_Localized: Tiada slot kosong.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205962
    m_Localized: Tiada slot cepat kosong untuk dulang kotor.
    m_Metadata:
      m_Items: []
