    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346974
    m_Localized: 'Kunci penyertaan baharu: Mati'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346975
    m_Localized: 'Kunci penyertaan baharu: {0}'
    m_Metadata:
      m_Items: []
