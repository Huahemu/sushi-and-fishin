    m_Metadata:
      m_Items: []
  - m_Id: 201706690400288
    m_Localized: Tiada lagi pelanggan yang akan tiba hari ini.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400289
    m_Localized: Pelanggan tidak akan tiba semasa restoran tutup.
