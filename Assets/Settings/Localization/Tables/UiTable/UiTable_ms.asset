    m_Localized: Dikunci
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346977
    m_Localized: KUMPULKAN PASUKAN ANDA
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346978
    m_Localized: Pasukan sushi saya
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346979
    m_Localized: Namakan lobi anda dahulu.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346980
    m_Localized: ESC / B  Kembali     •     TAB / D-pad  Navigasi     • ENTER / A  Pilih
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346981
    m_Localized: Tiada pemain disekat.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346982
    m_Localized: —
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346983
    m_Localized: TIADA LOBI AKTIF
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346984
    m_Localized: "Tiada lobi rakan yang boleh disertai.\nMinta kod atau jemputan daripada rakan,\natau cipta lobi sendiri."
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346985
    m_Localized: Cipta lobi atau sertai pasukan lain.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346986
    m_Localized: "Tiada lobi sepadan dengan carian anda.\nCuba nama lobi lain."
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346987
    m_Localized: Belum bersedia
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346988
    m_Localized: Mati
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346989
    m_Localized: Aktif
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346990
    m_Localized: Tiada kata laluan
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346991
    m_Localized: Steam tidak dapat melengkapkan permintaan. Sila cuba lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346992
    m_Localized: Kata laluan lobi
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346993
    m_Localized: Kata laluan (jika diperlukan)
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346994
    m_Localized: Masukkan kata laluan
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346995
    m_Localized: Kata laluan anda tidak akan dipaparkan dalam senarai lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346996
    m_Localized: Sedang menyertai...
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346997
    m_Localized: '{0} pemain'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346998
    m_Localized: Peribadi / jemputan sahaja
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346999
    m_Localized: Kata laluan
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651347000
    m_Localized: Dilindungi kata laluan
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541248
    m_Localized: Awam
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541249
    m_Localized: BERSEDIA
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541250
    m_Localized: BERSEDIA
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541251
    m_Localized: Hos memilih simpanan. Semua berangkat bersama.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541252
    m_Localized: 'Semua mesti bersedia: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541253
    m_Localized: Pasukan sudah bersedia. Pilih simpanan dan belayar bersama.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541254
    m_Localized: Muat semula
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541255
    m_Localized: 'Buang kata laluan: Tidak'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541256
    m_Localized: 'Buang kata laluan: Tidak'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541257
    m_Localized: 'Buang kata laluan: Ya'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541258
    m_Localized: 'Semua mesti bersedia: Aktif'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541259
    m_Localized: Hos lobi menarik balik akses anda.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541260
    m_Localized: Akses lobi tidak diluluskan. Sertai semula dengan kod dan kata laluan lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541261
    m_Localized: Anda sudah berada dalam lobi ini.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541262
    m_Localized: Sekatan dibuang.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541263
    m_Localized: Operasi lobi sedang berlangsung.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541264
    m_Localized: Hos lobi tidak boleh disingkirkan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541265
    m_Localized: Pilih kapasiti antara 1 hingga 5 pemain.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541266
    m_Localized: Had pemain tidak boleh lebih kecil daripada bilangan ahli pasukan semasa.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541267
    m_Localized: Sambung ke Steam untuk melayari lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541268
    m_Localized: Sambung ke Steam untuk mencipta lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541269
    m_Localized: Sambung ke Steam sebelum menyertai lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541270
    m_Localized: Kod lobi disalin.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541271
    m_Localized: Steam tidak dapat mencipta lobi. Sila cuba lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541272
    m_Localized: Lobi dicipta.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541273
    m_Localized: Hos menggunakan versi permainan yang berbeza.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541274
    m_Localized: Lobi ini hanya untuk rakan Steam hos.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541275
    m_Localized: Steam tidak dapat menghubungi hos lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541276
    m_Localized: Hos meninggalkan lobi. Kembali ke lobi anda sendiri.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541277
    m_Localized: Hos sedang memulakan permainan. Cuba lagi sebentar lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541278
    m_Localized: Hos lobi tidak memberikan respons. Sila cuba lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541279
    m_Localized: Hos lobi tidak tersedia.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541280
    m_Localized: Identiti Steam tidak tersedia.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541281
    m_Localized: Lobi ini menggunakan versi lobi yang tidak serasi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541282
    m_Localized: Kod lobi ini tidak sah.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541283
    m_Localized: Penyertaan lobi dibatalkan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541284
    m_Localized: Steam tidak dapat menyertai lobi ini. Semak kod dan cuba lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541285
    m_Localized: Berjaya menyertai lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541286
    m_Localized: Telah meninggalkan lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541287
    m_Localized: Steam tidak dapat mengemas kini kunci lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541288
    m_Localized: Nama lobi boleh mengandungi sehingga 32 aksara.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541289
    m_Localized: Masukkan nama lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541290
    m_Localized: Hos keluar atau bertukar semasa penyertaan. Gunakan kod lobi baharu.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541291
    m_Localized: Hos lobi bertukar semasa penyertaan. Sila cuba lagi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541292
    m_Localized: Kata laluan tidak boleh mengandungi aksara kawalan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541293
    m_Localized: Kata laluan mesti mengandungi 4–32 aksara.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541294
    m_Localized: Kata laluan terlalu panjang.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541295
    m_Localized: Lobi ini memerlukan kata laluan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541296
    m_Localized: Pemain disekat. Sekatan kekal sehingga anda membuangnya.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541297
    m_Localized: Pemain disingkirkan. Mereka boleh menyertai semula selepas 30 saat.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541298
    m_Localized: Pemain ini telah keluar.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541299
    m_Localized: Steam tidak dapat meluluskan jemputan lobi peribadi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541300
    m_Localized: Terlalu banyak percubaan. Sila tunggu sebentar.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541301
    m_Localized: Sertai lobi yang sedang menunggu sebelum mengubah status kesediaan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541302
    m_Localized: Steam tidak dapat memuat semula senarai lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541303
    m_Localized: Senarai lobi sedang dimuat semula.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541304
    m_Localized: Hanya hos lobi boleh menyingkirkan pemain.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541305
    m_Localized: Steam tidak dapat melengkapkan permintaan lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541306
    m_Localized: Kembali ke menu utama sebelum mencipta lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541307
    m_Localized: Lobi ini penuh.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541308
    m_Localized: Lobi ini dikunci.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541309
    m_Localized: Hanya hos boleh mengubah tetapan semasa lobi menunggu.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541310
    m_Localized: Tetapan lobi tiada.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541311
    m_Localized: Tetapan lobi disimpan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541312
    m_Localized: Lobi ini tidak tersedia atau menggunakan versi permainan yang lebih lama.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541313
    m_Localized: Hanya hos boleh membuang sekatan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541314
    m_Localized: Masukkan kod lobi SUSHI yang sah.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541315
    m_Localized: Steam tidak dapat mengemas kini keterlihatan lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541316
    m_Localized: Pilih keterlihatan lobi yang sah.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541317
    m_Localized: Kata laluan lobi tidak betul.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541318
    m_Localized: Anda disekat daripada semua lobi hos ini.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541319
    m_Localized: Anda disekat oleh hos lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541320
    m_Localized: Anda disingkirkan. Tunggu 30 saat sebelum menyertai semula.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541321
    m_Localized: Anda disingkirkan daripada lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541322
    m_Localized: Anda disingkirkan oleh hos lobi.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541323
    m_Localized: Cipta atau sertai lobi untuk melihat tetapannya.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541324
    m_Localized: Sekatan hos kekal sehingga hos membuangnya.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541325
    m_Localized: SIMPAN TETAPAN
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541326
    m_Localized: Cari nama lobi...
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541327
    m_Localized: Mencari pasukan...
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541328
    m_Localized: Tempat kosong • Lobi dikunci
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541329
    m_Localized: TETAPAN LOBI
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541330
    m_Localized: Hanya hos boleh mengubah tetapan ini. Perubahan menetapkan semula kesediaan pasukan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541331
    m_Localized: Tunjukkan kata laluan
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541332
    m_Localized: STEAM  •  Lobi pasukan
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541333
    m_Localized: Syif yang baik bermula dengan pasukan yang hebat.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541334
    m_Localized: Mencipta lobi akan meninggalkan pasukan semasa dan membawa anda kembali ke lobi sendiri.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541335
    m_Localized: TINGGALKAN PASUKAN SEMASA?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541336
    m_Localized: LOBI PASUKAN
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541337
    m_Localized: Sambungan Steam tidak tersedia
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541338
    m_Localized: Nyahsekat
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541339
    m_Localized: '{0} akan dibenarkan menyertai lobi ini semula.'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541340
    m_Localized: NYAHSEKAT PEMAIN?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541341
    m_Localized: BATAL BERSEDIA
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541342
    m_Localized: Maklumat lobi dikemas kini.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246655541343
    m_Localized: Siapa boleh menyertai?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735552
    m_Localized: 'Awam: boleh dicari. Rakan: rakan hos. Peribadi: jemputan atau kod.'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735553
    m_Localized: Semua mesti bersedia sebelum memilih simpanan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735554
    m_Localized: Sedia untuk berangkat. Menunggu hos memilih simpanan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735555
    m_Localized: Menunggu semua bersedia. Perubahan tetapan menetapkan semula kesediaan.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735556
    m_Localized: Menyambung ke Steam...
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735557
    m_Localized: Anda ialah hos
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735558
    m_Localized: ' (anda)'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735559
    m_Localized: PASUKAN ANDA
    m_Metadata:
      m_Items: []
  - m_Id: 4233246659735560
    m_Localized: LOBI ANDA
    m_Metadata:
      m_Items: []
  - m_Id: 4437951319011328
    m_Localized: Pemain tunggal
    m_Metadata:
      m_Items: []
  - m_Id: 4437951356760064
    m_Localized: Berbilang pemain
    m_Metadata:
      m_Items: []
  - m_Id: 5082816511897600
    m_Localized: Lindungi barang di rak dapur
    m_Metadata:
      m_Items: []
  - m_Id: 5082816537063424
    m_Localized: Pekerja stok tidak akan memindahkan barang di rak ini ke stor.
    m_Metadata:
      m_Items: []
  - m_Id: 5082816537063425
    m_Localized: Semua pekerja stok
    m_Metadata:
      m_Items: []
  - m_Id: 5445132323549184
    m_Localized: Pasar Tutup
    m_Metadata:
      m_Items: []
  - m_Id: 5445132352909312
    m_Localized: Produk Tidak Tersedia di Pasar
    m_Metadata:
      m_Items: []
  - m_Id: 5445132352909313
    m_Localized: Gagal Menerima Produk · Akan Cuba Lagi
    m_Metadata:
      m_Items: []
  - m_Id: 5453570634051584
    m_Localized: Tiada Slot Simpanan Kosong
    m_Metadata:
      m_Items: []
  - m_Id: 5453570663411712
    m_Localized: '{0} bekas · {1} isi · {2} kosong'
    m_Metadata:
      m_Items: []
  - m_Id: 5453570663411713
    m_Localized: 'Klik kiri: Ambil produk'
    m_Metadata:
      m_Items: []
  - m_Id: 5453570663411714
    m_Localized: 'Klik kanan: Ambil bekas kosong'
    m_Metadata:
      m_Items: []
  - m_Id: 5453570663411715
    m_Localized: 'E: Produk seterusnya'
    m_Metadata:
      m_Items: []
  - m_Id: 5455057326075904
    m_Localized: '{0} barang'
    m_Metadata:
      m_Items: []
  - m_Id: 5474489305821184
    m_Localized: Kumpulkan filet
    m_Metadata:
      m_Items: []
  - m_Id: 5489445828980736
    m_Localized: 'Klik kanan: Ambil 1 barang'
    m_Metadata:
      m_Items: []
  - m_Id: 5489445854146560
    m_Localized: 'Shift + klik kanan: Ambil bekas kosong'
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681984
    m_Localized: 'Klik kiri: Tambah barang/kotak sepadan yang dipegang'
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681985
    m_Localized: Stok Bahan Siap Guna Mencukupi
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681986
    m_Localized: 'Menunggu Bahan-bahan: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 5802907553656832
    m_Localized: Kumpulkan barang di bawah meja kerja
    m_Metadata:
      m_Items: []
  - m_Id: 5802907578822656
    m_Localized: Pekerja stok memindahkan barang dari rak bawah Meja Cef dan Stesen Persediaan ke stor.
    m_Metadata:
      m_Items: []
  - m_Id: 5861529683914752
    m_Localized: KEMAS KINI BAHARU
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469184
    m_Localized: LOBI KINI TERSEDIA
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469185
    m_Localized: "Cipta lobi dan jemput rakan anda.\nMulakan pengembaraan bersama."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469186
    m_Localized: PEKERJA KINI TERSEDIA
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469187
    m_Localized: "Besarkan pasukan dan bahagikan tugas.\nUrus restoran anda bersama."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469188
    m_Localized: PERTARUNGAN BOS DIBUKA
    m_Metadata:
      m_Items: []
  - m_Id: 5861529721663488
    m_Localized: "Cabar gergasi laut dalam.\nKini anda boleh melawan bos!"
    m_Metadata:
      m_Items: []
  - m_Id: 5861529721663489
    m_Localized: MARI BERMULA!
    m_Metadata:
      m_Items: []
  - m_Id: 8317811728740352
    m_Localized: Sushi Tersuai
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877696
    m_Localized: MAKI
