    m_Metadata:
      m_Items: []
  - m_Id: 3355612031643655
    m_Localized: Αγορά προμηθειών
    m_Metadata:
      m_Items: []
  - m_Id: 3355612031643656
    m_Localized: Επιστροφή στο εστιατόριο
    m_Metadata:
      m_Items: []
  - m_Id: 3355612031643657
    m_Localized: Απαιτούμενα προϊόντα που δεν είναι ξεκλείδωτα
    m_Metadata:
      m_Items: []
  - m_Id: 3355612031643658
    m_Localized: Φεύγοντας μετά την τρέχουσα εργασία
    m_Metadata:
      m_Items: []
  - m_Id: 3355612031643659
