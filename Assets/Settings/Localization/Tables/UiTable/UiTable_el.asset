  - m_Id: 3463817982275596
    m_Localized: "{0} · {1}\nΕργασίες: {2} · Χρόνος εργασίας: {3:0} λεπτά · Μισθός: ${4:0.00}\nΣερβιρίσματα: {5} · Εισπράξεις: {9} · Καθαρισμένοι δίσκοι: {10} · ΕΜΠ: {7:0}\n{8}"
    m_Metadata:
      m_Items: []
  - m_Id: 4086668858912768
