    m_Metadata:
      m_Items: []
  - m_Id: 4125486123216896
    m_Localized: ΑΝΑΦΟΡΑ ΠΡΟΣΩΠΙΚΟΥ · ΗΜΕΡΑ {0}
    m_Metadata:
      m_Items: []
  - m_Id: 4125486156771328
    m_Localized: Καλά
    m_Metadata:
      m_Items: []
  - m_Id: 4125486156771329
    m_Localized: "Τρέχουσα ομάδα: {0}     Μισθοί που πληρώθηκαν: ${1:0.00}     Απλήρωτοι μισθοί: ${2:0.00}\nΑποχώρησαν: {3} Αναμένουν αποχώρηση: {4}     Αποχωρήσεις λόγω απλήρωτου μισθού: {5}     Απολύσεις: {6}\nΑγορές προσωπικού: ${7:0.00}"
    m_Metadata:
      m_Items: []
  - m_Id: 4125486156771330
    m_Localized: Δεν υπήρξε καμία δραστηριότητα των εργαζομένων σήμερα.
    m_Metadata:
