    m_Localized: Lim inn lobbykode
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152650
    m_Localized: Skriv inn koden for å bli med i lobbyen.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152651
    m_Localized: ER DU SIKKER?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152652
    m_Localized: Bekreft
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152653
    m_Localized: Denne handlingen påvirker gjeldende lobby.
    m_Metadata:
      m_Items: []
