    m_Localized: Spilleautomatene er fulle
    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417221
    m_Localized: Risen er allerede kokt
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611520
    m_Localized: Kokt ris er inni
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611521
    m_Localized: Risen er allerede inne
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611522
    m_Localized: Bare rå ris
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611523
    m_Localized: Pakken er tom
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611524
    m_Localized: Legg først en fisk i maskinen.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611525
    m_Localized: Fileteringsmaskinen er allerede i gang.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611526
    m_Localized: Samle filetene før du tar fisken tilbake.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611527
    m_Localized: Fisken er allerede under lasting.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611528
    m_Localized: Du må holde en fisk først.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611529
    m_Localized: Bare fisk kan legges i fileteringsmaskinen.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611530
    m_Localized: Denne fisken kan ikke lastes akkurat nå.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611531
    m_Localized: Filletutdata mangler.
    m_Metadata:
      m_Items: []
  - m_Id: 3603310789611532
    m_Localized: Ingen plass på lageret.
    m_Metadata:
      m_Items: []
  - m_Id: 3845566217932800
    m_Localized: Harpunnivået ditt er ikke høyt nok. Prøv det sammen med vennene dine!
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000018
    m_Localized: Jeg eier denne butikken, og jeg har masse nyttige verktøy til deg. Vil du se?
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000019
    m_Localized: Jada! Du kan ta med deg harpun og dykkerdrakt herfra. Det vil hjelpe deg på reisen!
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000011
    m_Localized: Beholderen er tom.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000012
    m_Localized: Beholderen er full.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000017
    m_Localized: Dette kjøleskapet må repareres først.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000014
    m_Localized: Denne varen kan ikke plasseres på brettet.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000015
    m_Localized: Denne varen hører ikke hjemme i denne beholderen.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000016
    m_Localized: Denne handlingen kan ikke fullføres.
    m_Metadata:
      m_Items: []
  - m_Id: 191005000000013
    m_Localized: Skuffplassen er allerede opptatt.
    m_Metadata:
      m_Items: []
  - m_Id: 1445722421547009
    m_Localized: Akseptere
    m_Metadata:
      m_Items: []
  - m_Id: 1445722421547008
    m_Localized: Kansellere
    m_Metadata:
      m_Items: []
  - m_Id: 1445722362826752
    m_Localized: Bekrefte
    m_Metadata:
      m_Items: []
  - m_Id: 1445722421547010
    m_Localized: Slett
    m_Metadata:
      m_Items: []
  - m_Id: 5010362034741248
    m_Localized: Steam er frakoblet. Koble til Steam på nytt og prøv på nytt.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362055712768
    m_Localized: Steam-lobbyen kunne ikke opprettes. Prøv på nytt.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362055712769
    m_Localized: Kunne ikke bli med i Steam-lobbyen. Prøv å bli med via invitasjonen på nytt.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362055712770
    m_Localized: Lobbyen er full.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362055712771
    m_Localized: Verten er ikke lenger tilgjengelig.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362055712772
    m_Localized: Spilløkten kunne ikke startes som vert.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907072
    m_Localized: Tilkoblingen til verten kunne ikke startes.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907073
    m_Localized: Tilkoblingen ble tidsavbrutt. Prøv på nytt.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907074
    m_Localized: Spillversjonen din samsvarer ikke med verten. Oppdater spillet og prøv på nytt.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907075
    m_Localized: Denne økten bruker en inkompatibel flerspillerprotokoll.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907076
    m_Localized: Steam kunne ikke bekrefte denne forbindelsen.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907077
    m_Localized: Du er ikke autorisert til å delta i denne økten.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907078
    m_Localized: Du har blitt blokkert fra å delta i denne økten.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907079
    m_Localized: Denne flerspillerøkten er utløpt.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907080
    m_Localized: Verten startet en annen økt. Bli med på nytt.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907081
    m_Localized: Kunne ikke fullføre forberedelsene til spilloppstarten. Prøv på nytt.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907082
    m_Localized: Spilldataene kunne ikke synkroniseres.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907083
    m_Localized: Nettverksforbindelsen ble avbrutt.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907084
    m_Localized: Forbindelsen kunne ikke gjenopprettes.
    m_Metadata:
      m_Items: []
  - m_Id: 5010362059907085
    m_Localized: Flerspillerøkten kunne ikke fullføres.
    m_Metadata:
      m_Items: []
  - m_Id: 5054474567782400
    m_Localized: Søppelpost?
    m_Metadata:
      m_Items: []
  - m_Id: 5054474609725440
    m_Localized: Denne varen inneholder fortsatt mat. Er du sikker på at du vil kaste den?
    m_Metadata:
      m_Items: []
  - m_Id: 5054474609725441
    m_Localized: Er du sikker på at du vil kaste denne varen?
    m_Metadata:
