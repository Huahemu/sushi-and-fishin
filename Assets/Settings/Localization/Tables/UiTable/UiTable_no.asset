  - m_Id: 8317811774877699
    m_Localized: FULLFØR
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877700
    m_Localized: LAGRE
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877701
    m_Localized: OPPSKRIFTSNAVN (VALGFRITT)
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877702
    m_Localized: Gi et navn
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877703
    m_Localized: Avbryt
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877704
    m_Localized: Egen {0}-sushi • Fyll {1}/{2}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877705
    m_Localized: Lagre egen oppskrift
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877706
    m_Localized: Velg type
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877707
    m_Localized: Legg til {0}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877708
    m_Localized: Gjør ferdig sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877709
    m_Localized: Legg til fyll ({0}/{1}) eller gjør ferdig sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877710
    m_Localized: Tilbakestill den nåværende sushien før du bytter bordmodus.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877711
    m_Localized: Denne ingrediensen kan ikke brukes til egen sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072000
    m_Localized: Legg på den nødvendige basisingrediensen først
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072001
    m_Localized: Ris og nori kan bare brukes i sushibasen
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072002
    m_Localized: Denne sushien har allerede maksimalt antall fyll
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072003
    m_Localized: Fullfør tilberedningen før du endrer denne sushien
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072004
    m_Localized: Velg Maki, Uramaki eller Temaki først
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072005
    m_Localized: Fullfør sushibasen før du gjør den ferdig
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072006
    m_Localized: Oppskriften på egen sushi er lagret
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072007
    m_Localized: Det finnes allerede en oppskrift på denne sushien
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072008
    m_Localized: Oppskriften på egen sushi kunne ikke lagres
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072009
    m_Localized: Sushien er klar. Du kan lagre denne oppskriften.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072010
    m_Localized: Sushien er klar. Denne oppskriften finnes allerede og kan ikke lagres på nytt.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072011
    m_Localized: Bordet er klart for en ny egen sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072012
    m_Localized: En ingrediens ble lagt tilbake i en tom gastrobakke.
    m_Metadata:
