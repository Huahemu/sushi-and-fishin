    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346948
    m_Localized: VERTEN ER KLAR
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346949
    m_Localized: Velg en lobby, bli med via kode eller samle ditt eget lag.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346950
    m_Localized: Inviter venner
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346951
    m_Localized: Inviter venner via Steam-overlegget. Du kan også dele tilgangskoden.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346952
    m_Localized: Bli med
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346953
    m_Localized: BLI MED VIA KODE
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346954
    m_Localized: LOBBYENS TILGANGSKODE
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346955
    m_Localized: Skriv inn lobbykoden verten har delt med deg.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346956
    m_Localized: Bli med i {0}
    m_Metadata:
      m_Items: []
