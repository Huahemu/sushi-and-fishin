  - m_Id: 5861529717469184
    m_Localized: LOBBYER ER HER
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469185
    m_Localized: "Lag en lobby og inviter vennene dine.\nStart eventyret sammen."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469186
    m_Localized: ANSATTE ER HER
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469187
    m_Localized: "Utvid teamet og fordel arbeidet.\nDriv restauranten sammen."
    m_Metadata:
