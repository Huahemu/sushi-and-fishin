    m_Localized: Utesteng
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958340
    m_Localized: '{0} fjernes og utestenges fra lobbyene dine til du opphever utestengelsen av Steam-kontoen. Utestengelsen gjelder også etter at denne lobbyen stenges.'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958341
    m_Localized: Spilleren fjernes og utestenges fra lobbyene dine til du opphever utestengelsen av Steam-kontoen. Utestengelsen gjelder også etter at denne lobbyen stenges.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958342
    m_Localized: UTESTENG SPILLER?
    m_Metadata:
      m_Items: []
  - m_Id: 4233246642958343
    m_Localized: Utestengte spillere
    m_Metadata:
      m_Items: []
