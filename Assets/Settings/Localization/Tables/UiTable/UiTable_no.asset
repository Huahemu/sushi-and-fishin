    m_Localized: Steam-lobby
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152655
    m_Localized: Kopier kode
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152656
    m_Localized: Opptil 5 spillere. Passord og krav om at alle er klare finnes i lobbyinnstillingene.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152657
    m_Localized: Finn et lag eller opprett en lobby for å begynne.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152658
    m_Localized: Gi lobbyen et navn og velg hvem som kan bli med. Du kan endre innstillingene senere.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152659
    m_Localized: OPPRETT LOBBY
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152660
    m_Localized: LAG
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152661
    m_Localized: LAG  {0}/{1}  •  {2}
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152662
    m_Localized: Gjør deg klar før verten velger et lagret spill.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152663
    m_Localized: Vent til alle på laget er klare.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246647152664
    m_Localized: "Fant ingen lobbyer.\nOppdater, se under Venner,\neller opprett en lobby for laget ditt."
    m_Metadata:
      m_Items: []
