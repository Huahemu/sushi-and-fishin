  - m_Id: 201706673623040
    m_Localized: Allerede rent!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205952
    m_Localized: Kan ikke plassere!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205953
    m_Localized: En annen drikke er allerede plassert.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205954
    m_Localized: Nytt spisebordspor ulåst
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205955
    m_Localized: Fullfør veiledningen først!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205956
    m_Localized: Kjøleskapet er fullt.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205957
    m_Localized: Spillet er lagret.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205958
    m_Localized: Jeg er opptatt akkurat nå!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205959
    m_Localized: Den kan ikke overføres til gastropanen du holder.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205960
    m_Localized: Forlot lobbyen.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205961
    m_Localized: Ingen tom plass.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205962
    m_Localized: Ingen ledig hurtigspor for skittenskuffen.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400256
    m_Localized: Ingen ledig hurtigspor for brettet.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400257
    m_Localized: Ingen ting på bordet. Du kan ikke bruke kniv.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400258
    m_Localized: Ikke nok penger til å reparere transportbåndet!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400259
    m_Localized: Ikke nok penger til å reparere bordet!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400260
    m_Localized: Bare rå ingredienser kan kuttes her.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400261
    m_Localized: Åpne kjøleskapsdøren først.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400262
    m_Localized: Nå det nødvendige restaurantnivået først.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400263
    m_Localized: Oppskriften har allerede startet
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400264
    m_Localized: Oppskriften er ikke valgt
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400265
    m_Localized: Lagring mislyktes.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400266
    m_Localized: Lagring hoppet over.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400267
    m_Localized: Økten avsluttet. Tilbake til hovedmenyen.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400268
    m_Localized: Hyllen er tom.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400269
    m_Localized: Hyllen er full.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400270
    m_Localized: Spilleautomatene er fulle!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400271
    m_Localized: Stasjonen er full, frigjør litt plass
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400272
    m_Localized: Ingrediensene er forskjellige. Overføringen kan ikke fullføres.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400273
    m_Localized: Tabellen er tilbakestilt
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400274
    m_Localized: Dette kan ikke kastes i søpla.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400275
    m_Localized: Denne kuttetypen er ikke tilgjengelig for denne varen.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400276
    m_Localized: Denne varen kan ikke kuttes.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400277
    m_Localized: Dette krydderet er tomt
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400278
    m_Localized: Denne sushitypen kan ikke krydres.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400279
    m_Localized: Bruk fileteringsmaskinen først
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400280
    m_Localized: Venter på at andre kunder skal komme.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400281
    m_Localized: Feil drikke.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400282
    m_Localized: Feil vare.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400283
    m_Localized: Du kan sove etter 21:00
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400284
    m_Localized: Du kan ikke velge en oppskrift akkurat nå
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400285
    m_Localized: Du kan ikke bruke den varen her
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400286
    m_Localized: Du trenger en bedre harpun!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400287
    m_Localized: RESTAURANT
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400288
    m_Localized: Det kommer ikke flere kunder i dag.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400289
    m_Localized: Kunder kommer ikke mens restauranten er stengt.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400290
    m_Localized: MENYEN ER TOM
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400291
    m_Localized: Legg til minst én sushi på menyen. Gjester som skal spise vil ikke komme.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400292
    m_Localized: Trykk
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400293
    m_Localized: For dyp dybde for utstyret ditt!
