  - m_Id: 5066000000000100
    m_Localized: Spillerne i denne lobbyen har ulike spillversjoner. Alle må bruke samme versjon for å spille sammen.
    m_Metadata:
      m_Items: []
  - m_Id: 38711528419328
    m_Localized: En ingrediens i en oppskrift kan ikke plasseres i en gastropan
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111104
    m_Localized: Flytt sushien fra midten før du endrer oppskriften
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111105
    m_Localized: Flytt sushien fra midten før du lager en ny
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111106
    m_Localized: Ikke plass til å plassere sushien. Den blir liggende i midten.
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111107
    m_Localized: Ups! Handlingen kunne ikke fullføres.
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111108
    m_Localized: Oppskrift på fylte gastropaner
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111109
    m_Localized: Velg en oppskrift først
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111110
    m_Localized: Den nåværende oppskriften kunne ikke bekreftes
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111111
    m_Localized: Gastropanen er tom
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111112
    m_Localized: Gastropanen er tom. Du kan ikke hente den.
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111113
    m_Localized: Gastropannen er full og har ikke plass til flere ingredienser.
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111114
    m_Localized: Gastropanen du holder er tom. Du kan ikke overføre noe.
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111115
    m_Localized: Pakken er tom. Du kan ikke overføre noe.
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111116
    m_Localized: De plasserte ingrediensene samsvarer ikke med starten av denne oppskriften
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111117
    m_Localized: Oppskriften kunne ikke velges på grunn av en feil
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111118
    m_Localized: Oppskriften er allerede ferdig
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111119
    m_Localized: Oppskriften er ikke ferdig ennå
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111120
    m_Localized: Den samme oppskriften fortsetter
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111121
    m_Localized: Sushien kunne ikke lages ferdig fordi ingen bruker kokkebordet
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111122
    m_Localized: Sushien kunne ikke fullføres på grunn av en feil
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111123
    m_Localized: Sushien var ikke lenger på bordet.
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111124
    m_Localized: Tabellen ble tilbakestilt
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111125
    m_Localized: Den øverste ingrediensen matcher ikke den i gastropanen
    m_Metadata:
      m_Items: []
  - m_Id: 38711608111126
    m_Localized: Det er ikke nok gastropaner til denne oppskriften
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305408
    m_Localized: Det er ingenting på bordet å hente
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305409
    m_Localized: Denne ingrediensen kan ikke plasseres i gastropannen
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305410
    m_Localized: Dette er ikke den nødvendige ingrediensen
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305411
    m_Localized: Du kan bare bytte til samme sushitype etter at du har startet en oppskrift
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305412
    m_Localized: Du må være aktiv bruker av kokkedisken
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305413
    m_Localized: Du må velge en oppskrift først
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305414
    m_Localized: Ingen plass til å flytte gastropanen til side.
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305415
    m_Localized: Ingen plass til å gyte en gastropan.
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305416
    m_Localized: Tilberedt ingrediens gikk tapt. Stasjonen ble funnet.
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305417
    m_Localized: Gastropannen er full. Den har ikke plass til flere ingredienser.
    m_Metadata:
      m_Items: []
  - m_Id: 38711612305418
    m_Localized: Ingrediensene er forskjellige. Du kan ikke blande dem sammen.
    m_Metadata:
      m_Items: []
