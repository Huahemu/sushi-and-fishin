  - m_Id: 190972220755970
    m_Localized: "<size=70%>السمكة تسحب إلى <color=#{0}>اليسار</color></size>\n<b>حرّك الماوس إلى <color=#{0}>اليمين</color></b>"
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755971
    m_Localized: "<size=70%>السمكة تسحب إلى <color=#{0}>اليمين</color></size>\n<b>حرّك الماوس إلى <color=#{0}>اليسار</color></b>"
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755972
    m_Localized: "<size=70%>السمكة <color=#{0}>تبتعد</color></size>\n<b>اسحب الماوس إلى <color=#{0}>الخلف</color></b>"
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755973
