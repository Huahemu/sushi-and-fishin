    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417216
    m_Localized: الآلة فارغة
    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417217
    m_Localized: افتح الغطاء
    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417218
    m_Localized: لم ينضج الأرز بعد
    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417219
    m_Localized: لم يتم إعداد الأرز المطبوخ
    m_Metadata:
      m_Items: []
  - m_Id: 3603310785417220
    m_Localized: الخانات ممتلئة
