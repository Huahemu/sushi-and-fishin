    m_Localized: 'Blocca nuovi accessi: No'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346975
    m_Localized: 'Blocca nuovi accessi: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346976
    m_Localized: Bloccata
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346977
    m_Localized: RADUNA LA TUA SQUADRA
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346978
    m_Localized: La mia squadra di sushi
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346979
    m_Localized: Dai prima un nome alla lobby.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346980
    m_Localized: ESC / B  Indietro     •     TAB / Croce direzionale  Naviga •     ENTER / A  Seleziona
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346981
    m_Localized: Nessun giocatore bannato.
    m_Metadata:
      m_Items: []
