    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346983
    m_Localized: NESSUNA LOBBY ATTIVA
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346984
    m_Localized: "Nessuna lobby di amici disponibile.\nChiedi a un amico un codice o un invito,\noppure crea la tua lobby."
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346985
    m_Localized: Crea una lobby o unisciti a un'altra squadra.
    m_Metadata:
      m_Items: []
  - m_Id: 4233246651346986
    m_Localized: "Nessuna lobby corrisponde alla ricerca.\nProva un altro nome."
    m_Metadata:
      m_Items: []
