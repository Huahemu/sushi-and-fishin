  - m_Id: 8317811728740352
    m_Localized: Własne sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877696
    m_Localized: MAKI
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877697
    m_Localized: URAMAKI
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877698
    m_Localized: TEMAKI
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877699
    m_Localized: ZAKOŃCZ
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877700
    m_Localized: ZAPISZ
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877701
    m_Localized: NAZWA PRZEPISU (OPCJONALNIE)
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877702
    m_Localized: Nadaj nazwę
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877703
    m_Localized: Anuluj
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877704
    m_Localized: Własne sushi {0} • Dodatki {1}/{2}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877705
    m_Localized: Zapisz własny przepis
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877706
    m_Localized: Wybierz rodzaj
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877707
    m_Localized: Dodaj {0}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877708
    m_Localized: Dokończ sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877709
    m_Localized: Dodaj dodatek ({0}/{1}) lub dokończ sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877710
    m_Localized: Zresetuj przygotowywane sushi, zanim zmienisz tryb stołu.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877711
    m_Localized: Tego składnika nie można użyć do własnego sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072000
    m_Localized: Najpierw połóż wymagany składnik podstawowy
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072001
    m_Localized: Ryżu i nori można używać tylko do podstawy sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072002
    m_Localized: To sushi ma już maksymalną liczbę dodatków
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072003
    m_Localized: Dokończ przygotowanie, zanim zmienisz to sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072004
    m_Localized: Najpierw wybierz Maki, Uramaki lub Temaki
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072005
    m_Localized: Przed zakończeniem przygotuj podstawę sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072006
    m_Localized: Zapisano przepis na własne sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072007
    m_Localized: Przepis na to sushi już istnieje
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072008
    m_Localized: Nie udało się zapisać przepisu na własne sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072009
    m_Localized: Sushi jest gotowe. Możesz zapisać ten przepis.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072010
    m_Localized: Sushi jest gotowe. Ten przepis już istnieje i nie można zapisać go ponownie.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072011
    m_Localized: Stół jest gotowy do przygotowania kolejnego własnego sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072012
    m_Localized: Jeden składnik wrócił do pustego pojemnika gastronomicznego.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072013
    m_Localized: W pojemnikach gastronomicznych nie ma dość miejsca, aby opróżnić stół. Zrób miejsce i spróbuj ponownie.
    m_Metadata:
      m_Items: []
  - m_Id: 9082457028980736
    m_Localized: Usunięto przepis na własne sushi
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535168
    m_Localized: Ten przepis jest używany w zamówieniu klienta
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535169
    m_Localized: Ten przepis jest obecnie przygotowywany
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535170
    m_Localized: Nie można usunąć tego przepisu, dopóki przygotowane sushi jest w magazynie
    m_Metadata:
      m_Items: []
  - m_Id: 9082457062535171
    m_Localized: W menu musi pozostać co najmniej jedno sushi
    m_Metadata:
      m_Items: []
