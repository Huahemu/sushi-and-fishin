  - m_Id: 5861529717469184
    m_Localized: LOBBY JUŻ SĄ
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469185
    m_Localized: "Stwórz lobby i zaproś znajomych.\nRozpocznijcie wspólną przygodę."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469186
    m_Localized: PRACOWNICY JUŻ SĄ
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469187
    m_Localized: "Powiększ zespół i podziel obowiązki.\nProwadźcie restaurację razem."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469188
    m_Localized: WALKA Z BOSSEM DOSTĘPNA
    m_Metadata:
      m_Items: []
  - m_Id: 5861529721663488
    m_Localized: "Rzuć wyzwanie olbrzymowi z głębin.\nTeraz możesz walczyć z bossem!"
    m_Metadata:
      m_Items: []
  - m_Id: 5861529721663489
    m_Localized: ZACZYNAJMY!
    m_Metadata:
