  - m_Id: 190972220755983
    m_Localized: Venter på en bid.
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755984
    m_Localized: INGEN FISK HER
    m_Metadata:
      m_Items: []
  - m_Id: 190972220755985
    m_Localized: Der er ingen fisk her.
