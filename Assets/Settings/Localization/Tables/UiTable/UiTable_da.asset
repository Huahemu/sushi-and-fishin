      m_Items: []
  - m_Id: 201706673623040
    m_Localized: Allerede rent!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205952
    m_Localized: Kan ikke placere!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205953
    m_Localized: En anden drik er allerede placeret.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205954
    m_Localized: Ny spisebordsplads låst op
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205955
    m_Localized: Færdiggør først vejledningen!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205956
    m_Localized: Køleskabet er fyldt.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205957
    m_Localized: Spillet er gemt.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205958
    m_Localized: Jeg har travlt lige nu!
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205959
    m_Localized: Det kan ikke overføres til den gastropan, du holder.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205960
    m_Localized: Forlod lobbyen.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205961
    m_Localized: Ingen tom plads.
    m_Metadata:
      m_Items: []
  - m_Id: 201706686205962
    m_Localized: Ingen ledig hurtigplads til den snavsede bakke.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400256
    m_Localized: Ingen ledig hurtigplads til bakken.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400257
    m_Localized: Ingen genstand på bordet. Du må ikke bruge en kniv.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400258
    m_Localized: Ikke nok penge til at reparere transportbåndet!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400259
    m_Localized: Ikke nok penge til at reparere bordet!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400260
    m_Localized: Kun rå ingredienser må skæres her.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400261
    m_Localized: Åbn køleskabsdøren først.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400262
    m_Localized: Nå først det nødvendige restaurantniveau.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400263
    m_Localized: Opskriften er allerede startet
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400264
    m_Localized: Opskriften er ikke valgt
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400265
    m_Localized: Gemning mislykkedes.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400266
    m_Localized: Gemning sprunget over.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400267
    m_Localized: Sessionen er afsluttet. Tilbage til hovedmenuen.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400268
    m_Localized: Hylden er tom.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400269
    m_Localized: Hylden er fuld.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400270
    m_Localized: Pladserne er fulde!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400271
    m_Localized: Stationen er fuld, frigør plads
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400272
    m_Localized: Ingredienserne er forskellige. Overførslen kan ikke gennemføres.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400273
    m_Localized: Tabellen er blevet nulstillet
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400274
    m_Localized: Dette kan ikke smides ud.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400275
    m_Localized: Denne snittype er ikke tilgængelig for denne vare.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400276
    m_Localized: Denne vare kan ikke skæres.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400277
    m_Localized: Denne krydderiblanding er tom
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400278
    m_Localized: Denne type sushi kan ikke krydres.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400279
    m_Localized: Brug fileteringsmaskinen først
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400280
    m_Localized: Venter på at andre kunder ankommer.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400281
    m_Localized: Forkert drik.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400282
    m_Localized: Forkert vare.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400283
    m_Localized: Du kan sove efter kl. 21.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400284
    m_Localized: Du kan ikke vælge en opskrift lige nu
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400285
    m_Localized: Du kan ikke bruge den vare her
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400286
    m_Localized: Du har brug for en bedre harpun!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400287
    m_Localized: RESTAURANT
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400288
    m_Localized: Der kommer ikke flere kunder i dag.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400289
    m_Localized: Kunder kommer ikke, mens restauranten er lukket.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400290
    m_Localized: MENUEN ER TOM
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400291
    m_Localized: Tilføj mindst én sushi til menuen. Der vil ikke komme gæster i restauranten.
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400292
    m_Localized: Tryk
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400293
    m_Localized: Dybden er for dyb til dit udstyr!
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400294
    m_Localized: ÅBENT FARVAND FORUDE
    m_Metadata:
      m_Items: []
  - m_Id: 201706690400295
    m_Localized: Tilbage til sikkert farvand.
    m_Metadata:
      m_Items: []
