    m_Localized: 'Højreklik: Tag 1 vare'
    m_Metadata:
      m_Items: []
  - m_Id: 5489445854146560
    m_Localized: 'Shift + højreklik: Tag tom beholder'
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681984
    m_Localized: 'Venstreklik: Tilføj matchende vare/kasse fra hånden'
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681985
    m_Localized: Nok klargjorte ingredienser
    m_Metadata:
      m_Items: []
  - m_Id: 5499393824681986
    m_Localized: 'Venter på ingredienser: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 5802907553656832
    m_Localized: Saml varer under arbejdsstationerne
    m_Metadata:
      m_Items: []
  - m_Id: 5802907578822656
    m_Localized: Lagermedarbejdere flytter varer fra de nederste hylder på ChefDesk og Prep Station til lageret.
    m_Metadata:
      m_Items: []
  - m_Id: 5861529683914752
    m_Localized: NY OPDATERING
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469184
    m_Localized: LOBBYER ER HER
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469185
    m_Localized: "Opret en lobby, og inviter dine venner.\nBegynd eventyret sammen."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469186
    m_Localized: MEDARBEJDERE ER HER
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469187
    m_Localized: "Udvid holdet, og fordel arbejdet.\nDriv restauranten sammen."
    m_Metadata:
      m_Items: []
  - m_Id: 5861529717469188
    m_Localized: BOSSKAMPEN ER KLAR
    m_Metadata:
      m_Items: []
  - m_Id: 5861529721663488
    m_Localized: "Udfordr kæmpen fra dybet.\nNu kan du kæmpe mod bossen!"
    m_Metadata:
      m_Items: []
  - m_Id: 5861529721663489
    m_Localized: LAD OS KOMME I GANG!
    m_Metadata:
      m_Items: []
  - m_Id: 8317811728740352
    m_Localized: Egen sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877696
    m_Localized: MAKI
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877697
    m_Localized: URAMAKI
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877698
    m_Localized: TEMAKI
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877699
    m_Localized: AFSLUT
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877700
    m_Localized: GEM
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877701
    m_Localized: OPSKRIFTSNAVN (VALGFRIT)
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877702
    m_Localized: Giv et navn
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877703
    m_Localized: Annuller
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877704
    m_Localized: Egen {0}-sushi • Fyld {1}/{2}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877705
    m_Localized: Gem egen opskrift
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877706
    m_Localized: Vælg type
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877707
    m_Localized: Tilføj {0}
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877708
    m_Localized: Gør sushien færdig
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877709
    m_Localized: Tilføj fyld ({0}/{1}), eller gør sushien færdig
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877710
    m_Localized: Nulstil den nuværende sushi, før du skifter bordtilstand.
    m_Metadata:
      m_Items: []
  - m_Id: 8317811774877711
    m_Localized: Denne ingrediens kan ikke bruges til egen sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072000
    m_Localized: Læg først den nødvendige basisingrediens på
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072001
    m_Localized: Ris og nori kan kun bruges i sushibunden
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072002
    m_Localized: Denne sushi har allerede det maksimale antal fyld
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072003
    m_Localized: Gør tilberedningen færdig, før du ændrer denne sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072004
    m_Localized: Vælg først Maki, Uramaki eller Temaki
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072005
    m_Localized: Gør sushibunden færdig, før du afslutter
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072006
    m_Localized: Opskriften på egen sushi er gemt
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072007
    m_Localized: Der findes allerede en opskrift på denne sushi
    m_Metadata:
      m_Items: []
  - m_Id: 8317811779072008
    m_Localized: Opskriften på egen sushi kunne ikke gemmes
    m_Metadata:
